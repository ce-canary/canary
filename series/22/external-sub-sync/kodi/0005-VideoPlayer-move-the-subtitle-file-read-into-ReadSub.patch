-                  __FUNCTION__);
-        return false;
-      }
-      if (stream->source == STREAM_SOURCE_NONE)
-      {
-        m_SelectionStreams.Clear(StreamType::NONE, STREAM_SOURCE_DEMUX_SUB);
-        m_SelectionStreams.Update(NULL, m_pSubtitleDemuxer.get());
-        UpdateContent();
-      }
-      return true;
