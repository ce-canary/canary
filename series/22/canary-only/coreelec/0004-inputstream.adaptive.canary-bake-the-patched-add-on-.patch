+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: matthane <matthan.evans@icloud.com>
+Date: Mon, 9 Nov 2026 21:56:25 -0600
+Subject: [PATCH 03/10] [SrvBroker] Share settings and thread pool between
+ instances
+
+The settings and the global thread pool were recreated by each new
+instance and destroyed by each Close, so one instance could pull them
+from under another that was still playing.
+---
+ src/SrvBroker.cpp           | 16 ++++++++++++----
+ src/SrvBroker.h             | 12 ++++++++----
+ src/main.cpp                | 11 +++++++----
+ src/main.h                  |  1 +
+ src/test/CMakeLists.txt     |  1 +
+ src/test/TestDASHTree.cpp   |  3 ++-
+ src/test/TestHLSTree.cpp    |  3 ++-
+ src/test/TestSmoothTree.cpp |  3 ++-
+ src/utils/ThreadPool.cpp    |  3 +++
+ 9 files changed, 38 insertions(+), 15 deletions(-)
+
+diff --git a/src/SrvBroker.cpp b/src/SrvBroker.cpp
+index 03ea8063e8..f7ac278246 100644
+--- a/src/SrvBroker.cpp
++++ b/src/SrvBroker.cpp
+@@ -9,18 +9,26 @@
+ #include "SrvBroker.h"
+ 
+ #include "CompSettings.h"
++#include "utils/ThreadPool.h"
+ 
+ using namespace ADP;
+ 
+ CSrvBroker::CSrvBroker() = default;
+ CSrvBroker::~CSrvBroker() = default;
+ 
+-void CSrvBroker::Initialize()
++void CSrvBroker::Acquire()
+ {
+-  m_compSettings = std::make_unique<SETTINGS::CCompSettings>();
++  std::lock_guard<std::mutex> lock(m_mutex);
++  if (m_refCount++ == 0)
++    m_compSettings = std::make_unique<SETTINGS::CCompSettings>();
+ }
+ 
+-void CSrvBroker::Deinitialize()
++void CSrvBroker::Release()
+ {
+-  m_compSettings.reset();
++  std::lock_guard<std::mutex> lock(m_mutex);
++  if (--m_refCount == 0)
++  {
++    UTILS::THREAD::GlobalThreadPool.Reset();
++    m_compSettings.reset();
++  }
+ }
+diff --git a/src/SrvBroker.h b/src/SrvBroker.h
+index bed186e7c1..c6187d6319 100644
+--- a/src/SrvBroker.h
