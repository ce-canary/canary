diff --git a/projects/Amlogic-ce/packages/addons/canary/inputstream.adaptive.canary/patches/inputstream.adaptive-07-main-keep-the-streams-kodi-opens-again-before-the-fi.patch b/projects/Amlogic-ce/packages/addons/canary/inputstream.adaptive.canary/patches/inputstream.adaptive-07-main-keep-the-streams-kodi-opens-again-before-the-fi.patch
