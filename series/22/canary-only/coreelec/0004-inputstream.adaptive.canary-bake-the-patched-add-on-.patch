++   * \brief Initialize service broker components, when the first add-on instance is created.
+    */
+-  void Initialize();
++  void Acquire();
+ 
+   static CSrvBroker* GetInstance()
+   {
+@@ -43,9 +44,10 @@ public:
+   }
+ 
+   /*
+-   * \brief Deinitialize service broker components, when the add-on is terminated.
++   * \brief Deinitialize service broker components and stop the global thread pool,
++   *        when the last add-on instance is destroyed.
+    */
+-  void Deinitialize();
++  void Release();
+ 
+   /*
+    * \brief Get settings component, to manage add-on XML settings.
+@@ -60,4 +62,6 @@ private:
+   ~CSrvBroker();
+ 
+   std::unique_ptr<ADP::SETTINGS::CCompSettings> m_compSettings;
++  std::mutex m_mutex;
++  int m_refCount{0};
+ };
