 .../DVDInputStreams/DVDInputStreamNavigator.h | 19 ++++++++
 .../VideoPlayer/DVDInputStreams/DllDvdNav.h   |  6 +++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 35 +++++++++++++--
 xbmc/cores/VideoPlayer/VideoPlayer.h          |  4 +-
 5 files changed, 101 insertions(+), 8 deletions(-)

