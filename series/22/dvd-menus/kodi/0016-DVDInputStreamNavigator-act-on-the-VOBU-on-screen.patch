From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 21 Nov 2026 14:07:05 -0600
Subject: [PATCH] DVDInputStreamNavigator: act on the VOBU on screen

The saved DVD state, the played title record and the chapter getters
and calls took the title and program read last, ahead of the picture
by the queues. Near a chapter end a resume returned to the next chapter
and chapter keys counted from it. After a jump the title and total time
waited for a cell change, the menu state for a NAV packet.
---
 .../DVDInputStreamNavigator.cpp               | 58 +++++++++++++++++--
 .../DVDInputStreams/DVDInputStreamNavigator.h | 12 +++-
 2 files changed, 62 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamNavigator.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamNavigator.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamNavigator.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamNavigator.cpp
@@ -0,6 +0,9 @@
         m_iTime = (int) ( m_dll.dvdnav_get_current_time(m_dvdnav)  / 90 );
 
         NavPacket nav{.position = position,
+                      .part = m_iPart,
+                      .partCount = m_iPartCount,
+                      .menu = menu,
                       .start = static_cast<double>(m_iVobUnitStart * 1000) / 90};
         if (positioned)
           m_navPackets.push_back(nav);
@@ -0,10 +0,31 @@
   if (!called)
     called = m_dll.dvdnav_menu_call(m_dvdnav, menu) == DVDNAV_STATUS_OK;
   if (called)
+  {
     m_navPackets.clear();
+    UpdateTitleInfo();
+  }
   return called;
 }
 
+// after a jump the title, its parts and the PGC length follow the VM, as at a cell change, and the
+// menu state its domain; a NAV packet adds its buttons to the menu state
+void CDVDInputStreamNavigator::UpdateTitleInfo()
+{
+  m_dll.dvdnav_current_title_info(m_dvdnav, &m_iTitle, &m_iPart);
+  if (m_iTitle > 0)
+    m_dll.dvdnav_get_number_of_parts(m_dvdnav, m_iTitle, &m_iPartCount);
+  else
+    m_iPartCount = 0;
+
+  dvdnav_nav_position_t position{};
+  if (m_dll.dvdnav_get_current_nav_position(m_dvdnav, &position) == DVDNAV_STATUS_OK)
+  {
+    m_iTotalTime = static_cast<int>(position.pgc_length / 90);
+    m_bInMenu = position.domain != DVD_DOMAIN_VTSTitle;
+  }
+}
+
 void CDVDInputStreamNavigator::SetNavPacketOffset(double offset)
 {
   for (auto it = m_navPackets.rbegin(); it != m_navPackets.rend() && it->pts == DVD_NOPTS_VALUE;
@@ -0,7 +0,10 @@
