From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 17 Nov 2026 14:52:42 -0600
Subject: [PATCH] DVDInputStreamNavigator: play the asked chapter by its number

A chapter next to the part read went through libdvdnav's next or
previous program search, and any other chapter played in the title
read. The read runs ahead of the picture by the queues, so once it had
passed into the next title of the same PGC a chapter key acted on that
title.
---
 .../DVDInputStreamNavigator.cpp               | 23 ++++---------------
 1 file changed, 4 insertions(+), 19 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamNavigator.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamNavigator.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamNavigator.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamNavigator.cpp
@@ -0,25 +0,10 @@
   int audio    = GetActiveAudioStream();
   int subtitle = GetActiveSubtitleStream();
 
-  if (iChapter == (m_iPart + 1))
-  {
-    if (m_dll.dvdnav_next_pg_search(m_dvdnav) == DVDNAV_STATUS_ERR)
-    {
-      CLog::Log(LOGERROR, "dvdnav: dvdnav_next_pg_search( {} )",
-                m_dll.dvdnav_err_to_string(m_dvdnav));
-      return false;
-    }
-  }
-  else if (iChapter == (m_iPart - 1))
-  {
-    if (m_dll.dvdnav_prev_pg_search(m_dvdnav) == DVDNAV_STATUS_ERR)
-    {
-      CLog::Log(LOGERROR, "dvdnav: dvdnav_prev_pg_search( {} )",
-                m_dll.dvdnav_err_to_string(m_dvdnav));
-      return false;
-    }
-  }
-  else if (m_dll.dvdnav_part_play(m_dvdnav, m_iTitle, iChapter) == DVDNAV_STATUS_ERR)
+  // jump by number in the title on screen, the read runs ahead of the picture
+  if (m_dll.dvdnav_part_play(m_dvdnav,
+                             m_navPackets.empty() ? m_iTitle : m_navPackets.front().position.title,
+                             iChapter) == DVDNAV_STATUS_ERR)
   {
     CLog::Log(LOGERROR, "dvdnav: dvdnav_part_play failed( {} )",
               m_dll.dvdnav_err_to_string(m_dvdnav));
