From: matthane <matthan.evans@icloud.com>
Date: Tue, 10 Nov 2026 23:25:43 -0600
Subject: [PATCH] DVDInputStreamBluray: report where the held play item ends

A play item runs on the title timeline from its in time to its out time,
and its last picture can come well before the out time. The read is held
at a join, a timed still or a title end once the item's data is read, and
nothing told the player when that item's presentation ends.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 36 +++++++++++++++++++
 .../DVDInputStreams/DVDInputStreamBluray.h    |  5 +++
 2 files changed, 41 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,6 +0,13 @@
          !m_clipStart.empty() && m_heldClip;
 }
 
+// a read held at the start of a timed still, which libbluray raises before it leaves the clip
+bool CDVDInputStreamBluray::IsStillHeld() const
+{
+  return m_navmode && m_hold == HOLD_HELD && m_event.event == BD_EVENT_STILL_TIME &&
+         m_event.param > 0;
+}
+
 bool CDVDInputStreamBluray::IsTailInTitle() const
 {
   if (IsTitleEndHeld())
@@ -0,6 +0,35 @@
   return IsJoinHeld();
 }
 
+// the title time includes the gap between the last picture of a play item and its out time; the
+// end is that of the content whose data ended, which for a title end is the title
+std::optional<double> CDVDInputStreamBluray::GetHeldItemEnd() const
+{
+  if (m_presentedLeft || !m_titleInfo)
+    return {};
+
+  const auto itemEnd = [](const BLURAY_CLIP_INFO& clip)
+  { return clip.start_time + clip.out_time - clip.in_time; };
+  std::optional<uint64_t> end;
+  if (IsJoinHeld())
+  {
+    if (m_heldClip > m_titleInfo->clips)
+      end = itemEnd(*(m_heldClip - 1));
+  }
+  else if (IsStillHeld())
+  {
+    if (m_clip)
+      end = itemEnd(*m_clip);
+  }
+  else if (IsTitleEndHeld())
+    end = m_titleInfo->duration;
+  if (!end)
+    return {};
+
+  return av_rescale_q(static_cast<int64_t>(*end), CDVDDemuxUtils::BLURAY_CLIP_TIME_BASE,
+                      AVRational{1, DVD_TIME_BASE});
+}
+
 // a seek back before the held clip plays on in the same demuxer; a seek into the held clip or past
 // it keeps the discontinuity, whose reset the demuxer probed on the old clip needs
 void CDVDInputStreamBluray::DropClipStartOnSeek(bool joinHeld)
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -0,6 +0,10 @@
   //! whether a seek while the read is held stays in the title being played out
   bool IsTailInTitle() const;
 
+  //! the title time (DVD time) at which the play item whose data the read is held after ends,
+  //! nothing once the disc program or a seek has left it
+  std::optional<double> GetHeldItemEnd() const;
+
   //! whether a menu action made the disc program leave the item being played out, reset by the call
   bool TakeItemAbandoned();
 
@@ -0,6 +0,7 @@
     bool AbandonsItem(bool menuJump, bool fromStill) const;
     void MarkMenuInput();
     bool IsJoinHeld() const;
+    bool IsStillHeld() const;
     void DropClipStartOnSeek(bool joinHeld);
     const BLURAY_CLIP_INFO* GetClipAt(uint64_t titlePos) const;
 
