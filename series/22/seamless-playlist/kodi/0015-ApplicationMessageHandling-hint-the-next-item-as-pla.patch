From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 9 Nov 2026 22:23:24 -0600
Subject: [PATCH] ApplicationMessageHandling: hint the next item as play
 resolves it

The prefetch hint passes the next playlist entry as it is listed. A
.strm or other playlist file entry plays as the item it expands to, and
a directory can resolve an entry to another path. The player then opens
ahead an input that the play never opens.
---
 xbmc/PlayListPlayer.cpp                       |  8 +-------
 .../ApplicationMessageHandling.cpp            | 19 ++++++++++++++++++-
 xbmc/application/ApplicationPlay.cpp          | 18 +++++++++---------
 xbmc/application/ApplicationPlay.h            |  7 ++++---
 xbmc/playlists/PlayList.cpp                   | 11 +++++++++++
 xbmc/playlists/PlayList.h                     |  1 +
 6 files changed, 44 insertions(+), 20 deletions(-)

diff --git a/xbmc/PlayListPlayer.cpp b/xbmc/PlayListPlayer.cpp
--- a/xbmc/PlayListPlayer.cpp
+++ b/xbmc/PlayListPlayer.cpp
@@ -0,13 +0,7 @@
     iSong = playlist.size() - 1;
 
   // check if the item itself is a playlist, and can be expanded
-  // only allow a few levels, this could end up in a loop
-  // if they refer to each other in a loop
-  for (int i=0; i<5; i++)
-  {
-    if(!playlist.Expand(iSong))
-      break;
-  }
+  playlist.ExpandNested(iSong);
 
   m_iCurrentSong = iSong;
   CFileItemPtr item = playlist[m_iCurrentSong];
diff --git a/xbmc/application/ApplicationMessageHandling.cpp b/xbmc/application/ApplicationMessageHandling.cpp
--- a/xbmc/application/ApplicationMessageHandling.cpp
+++ b/xbmc/application/ApplicationMessageHandling.cpp
@@ -0,6 +0,7 @@
 #include "application/AppInboundProtocol.h"
 #include "application/Application.h"
 #include "application/ApplicationEnums.h"
+#include "application/ApplicationPlay.h"
 #include "application/ApplicationPlayer.h"
 #include "application/ApplicationPowerHandling.h"
 #include "application/ApplicationSkinHandling.h"
@@ -0,6 +0,7 @@
 #include "interfaces/generic/ScriptInvocationManager.h"
 #include "interfaces/json-rpc/JSONUtils.h"
 #include "interfaces/python/XBPython.h"
+#include "jobs/JobManager.h"
 #include "messaging/ApplicationMessenger.h"
 #include "messaging/ThreadMessage.h"
 #include "messaging/helpers/DialogOKHelper.h"
@@ -0,7 +0,22 @@
         if (URIUtils::IsPlugin(file.GetDynPath()) || !VIDEO::IsVideo(file))
           return true;
 
-        m_app.GetComponent<CApplicationPlayer>()->PrefetchNextFile(file);
+        // the item the play resolves to, on a job as a playlist file or a resolver can read the
+        // network; a plugin runs Python and a PVR item prepares its playback when resolved
+        CServiceBroker::GetJobManager()->Submit(
+            [entry = std::make_shared<CFileItem>(file),
+             appPlayer = m_app.GetComponent<CApplicationPlayer>()]()
+            {
+              PLAYLIST::CPlayList items;
+              items.Add(entry);
+              items.ExpandNested(0);
+              CFileItem item{*items[0]};
+              if (URIUtils::IsPlugin(item.GetDynPath()) || URIUtils::IsPVR(item.GetDynPath()) ||
+                  !CApplicationPlay::ResolvePath(item))
+                return;
+              appPlayer->PrefetchNextFile(item);
+            },
+            CJob::PRIORITY_NORMAL);
         return true;
       }
 
diff --git a/xbmc/application/ApplicationPlay.cpp b/xbmc/application/ApplicationPlay.cpp
--- a/xbmc/application/ApplicationPlay.cpp
+++ b/xbmc/application/ApplicationPlay.cpp
@@ -0,27 +0,27 @@
 using namespace KODI;
 using namespace XFILE;
 
-bool CApplicationPlay::ResolvePath()
+bool CApplicationPlay::ResolvePath(CFileItem& item)
 {
   // Get bluray:// path for resolution if present
-  if (m_item.HasVideoInfoTag() && m_item.GetVideoInfoTag()->GetPath().starts_with("bluray://"))
-    m_item.SetDynPath(m_item.GetVideoInfoTag()->m_strFileNameAndPath);
+  if (item.HasVideoInfoTag() && item.GetVideoInfoTag()->GetPath().starts_with("bluray://"))
+    item.SetDynPath(item.GetVideoInfoTag()->m_strFileNameAndPath);
 
   // Translate/Resolve the url if needed - recursively, but only limited times.
-  std::string lastDynPath{m_item.GetDynPath()};
+  std::string lastDynPath{item.GetDynPath()};
   size_t itemResolveAttempt{0};
   while (itemResolveAttempt < MAX_ITEM_RESOLVE_ATTEMPTS)
   {
     itemResolveAttempt++;
 
-    if (const std::unique_ptr<IDirectory> dir{CDirectoryFactory::Create(m_item)};
-        dir && !dir->Resolve(m_item))
+    if (const std::unique_ptr<IDirectory> dir{CDirectoryFactory::Create(item)};
+        dir && !dir->Resolve(item))
     {
-      CLog::LogF(LOGERROR, "Error resolving item. Item '{}' is not playable.", m_item.GetDynPath());
+      CLog::LogF(LOGERROR, "Error resolving item. Item '{}' is not playable.", item.GetDynPath());
       return false;
     }
 
-    std::string newDynPath{m_item.GetDynPath()};
+    std::string newDynPath{item.GetDynPath()};
     if (newDynPath == lastDynPath)
       break; // done
 
@@ -0,7 +0,7 @@
   if (PLAYLIST::IsPlayList(m_item) && !m_item.IsGame())
     return GatherPlaybackDetailsResult::RESULT_ERROR; // non-game playlists not supported
 
-  if (!ResolvePath())
+  if (!ResolvePath(m_item))
     return GatherPlaybackDetailsResult::RESULT_ERROR;
 
   if (!isStack)
diff --git a/xbmc/application/ApplicationPlay.h b/xbmc/application/ApplicationPlay.h
--- a/xbmc/application/ApplicationPlay.h
+++ b/xbmc/application/ApplicationPlay.h
@@ -0,13 +0,14 @@
    */
   const CPlayerOptions& GetPlayerOptions() const { return m_options; }
 
-private:
   /*!
-   * \brief Resolves m_item's vfs dynpath to an actual file path.
+   * \brief Resolves an item's vfs dynpath to an actual file path.
+   * \param item The item to resolve
    * \return true if resolved successfully, false otherwise
    */
-  bool ResolvePath();
+  static bool ResolvePath(CFileItem& item);
 
+private:
   /*!
    * \brief Determines if there is a resume point for m_item, updates the player options accordingly.
    * Also resolves a removable media path if needed
diff --git a/xbmc/playlists/PlayList.cpp b/xbmc/playlists/PlayList.cpp
--- a/xbmc/playlists/PlayList.cpp
+++ b/xbmc/playlists/PlayList.cpp
@@ -0,6 +0,17 @@
   return true;
 }
 
+void CPlayList::ExpandNested(int position)
+{
+  // only allow a few levels, this could end up in a loop
+  // if they refer to each other in a loop
+  for (int i = 0; i < 5; i++)
+  {
+    if (!Expand(position))
+      break;
+  }
+}
+
 void CPlayList::UpdateItem(const CFileItem *item)
 {
   if (!item) return;
diff --git a/xbmc/playlists/PlayList.h b/xbmc/playlists/PlayList.h
--- a/xbmc/playlists/PlayList.h
+++ b/xbmc/playlists/PlayList.h
@@ -0,6 +0,7 @@
   void Remove(int position);
   bool Swap(int position1, int position2);
   bool Expand(int position); // expands any playlist at position into this playlist
+  void ExpandNested(int position); // expands it again while the first item is a playlist too
   void Clear();
   int size() const;
   int RemoveDVDItems();
