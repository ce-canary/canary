From: matthane <matthan.evans@icloud.com>
Date: Tue, 10 Nov 2026 23:43:31 -0600
Subject: [PATCH] VideoPlayer: run the presented Blu-ray time to the held item
 end

The presented title time follows the picture on the plane, which stays
at the last picture while a held play item runs on to its out time, even
after its stream closed. The time on screen stood still for the whole
gap, and disc notifications due inside it waited for the next item.
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp                  | 9 +++++++++
 xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp | 5 +++++
 2 files changed, 14 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -0,6 +0,15 @@
       return DVD_NOPTS_VALUE;
     presented = m_clock.GetClock();
   }
+  // once video has played out, the last picture of a held play item is shown at the clock until
+  // the item ends, one title tick before the next item starts
+  if (const auto itemEnd = GetBlurayItemEnd())
+  {
+    if (m_videoDrained && !m_VideoPlayerVideo->HasData() && m_VideoPlayerVideo->IsEOS())
+      presented = std::max(presented, m_clock.GetClock());
+    const double tick = DVD_TIME_BASE * av_q2d(CDVDDemuxUtils::BLURAY_CLIP_TIME_BASE);
+    return std::min(presented + m_offset_pts, *itemEnd - tick);
+  }
   return presented + m_offset_pts;
 }
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -0,6 +0,11 @@
   std::unique_lock lock(m_statelock);
 
   m_awaitConfigure = false;
+
+  // a picture kept on the plane is off the timeline of the next stream
+  std::unique_lock lock2(m_presentlock);
+  m_displayedPts = DVD_NOPTS_VALUE;
+  m_offTimelineSource = m_presentsource;
 }
 
 void CRenderManager::ToggleDebug()
