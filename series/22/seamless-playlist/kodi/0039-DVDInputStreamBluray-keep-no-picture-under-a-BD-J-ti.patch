From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 10 Nov 2026 19:30:09 -0600
Subject: [PATCH] DVDInputStreamBluray: keep no picture under a BD-J title's
 first page

A BD-J title that shows graphics before it names a playlist showed
them over the picture kept across the program jump. The disc presents
such a page with no video under it.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 23 ++++++++++++++++++-
 .../DVDInputStreams/DVDInputStreamBluray.h    | 11 ++++++---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        |  3 +++
 3 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,6 +0,8 @@
   m_hasMVCExtension = false;
   m_clipStart.clear();
   m_heldEvents = {};
+  m_titlePlaylist = true;
+  m_pageBeforePlaylist = false;
 
 #if defined(HAS_UDFREAD)
   // Released last, as the files opened from the volume are closed above
@@ -0,6 +0,8 @@
     m_isInMainMenu = false;
     m_playlistLeft = true;
     m_pendingMenuRange.reset();
+    m_titlePlaylist = false;
+    m_pageBeforePlaylist = false;
 
     if (m_event.param == BLURAY_TITLE_TOP_MENU)
     {
@@ -0,11 +0,13 @@
     m_titleEndWait = false;
     m_playlistLeft = true;
     m_pendingMenuRange.reset();
+    m_titlePlaylist = true;
     break;
 
   case BD_EVENT_PLAYITEM:
     CLog::Log(LOGDEBUG, "CDVDInputStreamBluray - BD_EVENT_PLAYITEM {}", m_event.param);
     ResetTitleEnd();
+    m_titlePlaylist = true;
     if (m_titleInfo && m_event.param < m_titleInfo->clip_count)
     {
       m_clip = &m_titleInfo->clips[m_event.param];
@@ -0,6 +0,16 @@
     m_player->OnDiscNavResult(&m_event.param, BD_EVENT_MENU);
     break;
 
+  case BD_EVENT_BDJ_GRAPHICS:
+    CLog::Log(LOGDEBUG, "CDVDInputStreamBluray - BD_EVENT_BDJ_GRAPHICS {}", m_event.param);
+    // a page shown before the title names a playlist shows over black, as the disc presents it
+    if (!m_titlePlaylist)
+    {
+      m_pageBeforePlaylist = true;
+      m_player->OnDiscNavResult(nullptr, BD_EVENT_BDJ_GRAPHICS);
+    }
+    break;
+
   case BD_EVENT_IDLE:
     // the disc program plays no playlist until its next act, as after a released title end
     if (m_navmode && m_event.param == 0)
@@ -0,10 +0,15 @@
 // counted after the events of the read have opened their clip spans
 int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
 {
+  // the bytes of a read come before the events it returns with them
+  const bool pageBefore = m_pageBeforePlaylist;
   const int result = ReadData(buf, buf_size);
   if (result > 0)
   {
     m_readPos += result;
+    // the video of the title now follows its page
+    if (pageBefore)
+      m_pageBeforePlaylist = false;
     // a read returns the bytes of one clip, which ends where libbluray stands
     if (m_demuxerClipPending)
     {
@@ -0,7 +0,7 @@
 
 const BLURAY_CLIP_INFO* CDVDInputStreamBluray::GetNextItemClip() const
 {
-  if (m_bMVCPlayback || m_hasMVCExtension)
+  if (m_bMVCPlayback || m_hasMVCExtension || m_pageBeforePlaylist)
     return nullptr;
   return m_nextClip;
 }
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -0,12 +0,13 @@
                          m_aborted || m_titleEndWait);
   }
 
-  //! the clip the item opened by the last NextStream starts with, when its events named it
+  //! the clip the item opened by the last NextStream starts with, when its events named it and
+  //! the title showed no page before its playlist
   const BLURAY_CLIP_INFO* GetNextItemClip() const;
 
   //! whether the item opened by the last NextStream follows a jump of the disc program that has
-  //! not named its clip yet
-  bool NextItemFollowsJump() const { return m_nextJump; }
+  //! not named its clip yet, to a title that showed no page before its playlist
+  bool NextItemFollowsJump() const { return m_nextJump && !m_pageBeforePlaylist; }
 
   //! whether the item opened by the last NextStream continues the playlist of the item before it
   bool NextItemContinuesPlaylist() const { return m_nextItemInPlaylist; }
@@ -0,6 +0,10 @@
     int64_t m_playedItemEnd{-1};
     const BLURAY_CLIP_INFO* m_nextClip{nullptr};
     bool m_nextJump{false};
+    //! the title has named a playlist since its title event
+    bool m_titlePlaylist{true};
+    //! the title showed BD-J graphics before it named a playlist, and no data of it was read since
+    bool m_pageBeforePlaylist{false};
     bool m_playlistLeft{false};
     bool m_nextItemInPlaylist{false};
     bool m_itemSeeked{false};
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -0,6 +0,9 @@
       // the disc program may start another playlist, so only the kept picture goes
       aml_drop_kept_picture(true);
       break;
+    case BD_EVENT_BDJ_GRAPHICS:
+      aml_drop_kept_picture(false);
+      break;
     case BD_EVENT_AUDIO_STREAM:
     {
       m_dvd.iSelectedAudioStream = *static_cast<int*>(pData);
