From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 9 Nov 2026 16:56:19 -0600
Subject: [PATCH] IPlayer: add a hint to prepare the next playlist item

A player can only learn the next playlist item through QueueNextFile.
Accepting it hands over playback of that item and moves the playlist
state, and asking for it calls the Python onQueueNextItem. A video
player that wants to open the next item early, while the application
still plays it as usual, has no way to ask.
---
 xbmc/GUIUserMessages.h                        |  2 ++
 .../ApplicationMessageHandling.cpp            | 20 +++++++++++++++++++
 xbmc/application/ApplicationPlayer.cpp        |  7 +++++++
 xbmc/application/ApplicationPlayer.h          |  1 +
 .../application/ApplicationPlayerCallback.cpp |  6 ++++++
 xbmc/application/ApplicationPlayerCallback.h  |  1 +
 xbmc/cores/IPlayer.h                          |  2 ++
 xbmc/cores/IPlayerCallback.h                  |  1 +
 8 files changed, 40 insertions(+)

diff --git a/xbmc/GUIUserMessages.h b/xbmc/GUIUserMessages.h
--- a/xbmc/GUIUserMessages.h
+++ b/xbmc/GUIUserMessages.h
@@ -0,6 +0,8 @@
 
 //  Player has requested the next item for caching purposes (PAPlayer)
 constexpr const int GUI_MSG_QUEUE_NEXT_ITEM         = GUI_MSG_USER + 16;
+//  Parameter for GUI_MSG_QUEUE_NEXT_ITEM: the player only prepares the item, which plays as usual
+constexpr int GUI_MSG_FLAG_PREFETCH = 0x00000001;
 
 //  Playback request for the trailer of a given item
 constexpr const int GUI_MSG_PLAY_TRAILER = GUI_MSG_USER + 17;
diff --git a/xbmc/application/ApplicationMessageHandling.cpp b/xbmc/application/ApplicationMessageHandling.cpp
--- a/xbmc/application/ApplicationMessageHandling.cpp
+++ b/xbmc/application/ApplicationMessageHandling.cpp
@@ -0,6 +0,26 @@
 
     case GUI_MSG_QUEUE_NEXT_ITEM:
     {
+      // the item PlayNext picks; the playlist stays as it is
+      if (message.GetParam1() == GUI_MSG_FLAG_PREFETCH)
+      {
+        const auto& playlistPlayer = CServiceBroker::GetPlaylistPlayer();
+        const int next = playlistPlayer.GetNextItemIdx(1);
+        const PLAYLIST::CPlayList& playlist =
+            playlistPlayer.GetPlaylist(playlistPlayer.GetCurrentPlaylist());
+        if (next < 0 || next >= playlist.size() ||
+            m_app.GetComponent<CApplicationStackHelper>()->IsPlayingStack())
+          return true;
+
+        // a plugin item is resolved when it plays
+        const CFileItem& file = *playlist[next];
+        if (URIUtils::IsPlugin(file.GetDynPath()) || !VIDEO::IsVideo(file))
+          return true;
+
+        m_app.GetComponent<CApplicationPlayer>()->PrefetchNextFile(file);
+        return true;
+      }
+
       // Check to see if our playlist player has a new item for us,
       // and if so, we check whether our current player wants the file
       int iNext = CServiceBroker::GetPlaylistPlayer().GetNextItemIdx();
diff --git a/xbmc/application/ApplicationPlayer.cpp b/xbmc/application/ApplicationPlayer.cpp
--- a/xbmc/application/ApplicationPlayer.cpp
+++ b/xbmc/application/ApplicationPlayer.cpp
@@ -0,6 +0,13 @@
   return (player && player->QueueNextFile(file));
 }
 
+void CApplicationPlayer::PrefetchNextFile(const CFileItem& file)
+{
+  std::shared_ptr<IPlayer> player = GetInternal();
+  if (player)
+    player->PrefetchNextFile(file);
+}
+
 bool CApplicationPlayer::SetPlayerState(const std::string& state)
 {
   std::shared_ptr<IPlayer> player = GetInternal();
diff --git a/xbmc/application/ApplicationPlayer.h b/xbmc/application/ApplicationPlayer.h
--- a/xbmc/application/ApplicationPlayer.h
+++ b/xbmc/application/ApplicationPlayer.h
@@ -0,6 +0,7 @@
   void OnNothingToQueueNotify();
   void Pause();
   bool QueueNextFile(const CFileItem &file);
+  void PrefetchNextFile(const CFileItem& file);
   void Seek(bool bPlus = true, bool bLargeStep = false, bool bChapterOverride = false);
   int SeekChapter(int iChapter);
   void SeekPercentage(float fPercent = 0);
diff --git a/xbmc/application/ApplicationPlayerCallback.cpp b/xbmc/application/ApplicationPlayerCallback.cpp
--- a/xbmc/application/ApplicationPlayerCallback.cpp
+++ b/xbmc/application/ApplicationPlayerCallback.cpp
@@ -0,6 +0,12 @@
   CServiceBroker::GetGUI()->GetWindowManager().SendThreadMessage(msg);
 }
 
+void CApplicationPlayerCallback::OnPrefetchNextItem()
+{
+  CGUIMessage msg(GUI_MSG_QUEUE_NEXT_ITEM, 0, 0, GUI_MSG_FLAG_PREFETCH);
+  CServiceBroker::GetGUI()->GetWindowManager().SendThreadMessage(msg);
+}
+
 void CApplicationPlayerCallback::OnPlayBackSeek(int64_t iTime, int64_t seekOffset)
 {
 #ifdef HAS_PYTHON
diff --git a/xbmc/application/ApplicationPlayerCallback.h b/xbmc/application/ApplicationPlayerCallback.h
--- a/xbmc/application/ApplicationPlayerCallback.h
+++ b/xbmc/application/ApplicationPlayerCallback.h
@@ -0,6 +0,7 @@
   void OnPlayBackStopped() override;
   void OnPlayBackError() override;
   void OnQueueNextItem() override;
+  void OnPrefetchNextItem() override;
   void OnPlayBackSeek(int64_t iTime, int64_t seekOffset) override;
   void OnPlayBackSeekChapter(int iChapter) override;
   void OnPlayBackSpeedChanged(int iSpeed) override;
diff --git a/xbmc/cores/IPlayer.h b/xbmc/cores/IPlayer.h
--- a/xbmc/cores/IPlayer.h
+++ b/xbmc/cores/IPlayer.h
@@ -0,6 +0,8 @@
   virtual bool OpenFile(const CFileItem& file, const CPlayerOptions& options){ return false;}
   virtual bool QueueNextFile(const CFileItem &file) { return false; }
   virtual void OnNothingToQueueNotify() {}
+  // the next item, for the player to prepare; it is still played through OpenFile
+  virtual void PrefetchNextFile(const CFileItem& file) {}
   virtual bool CloseFile(bool reopen = false) = 0;
   virtual bool IsPlaying() const { return false;}
   virtual bool CanPause() const { return true; }
diff --git a/xbmc/cores/IPlayerCallback.h b/xbmc/cores/IPlayerCallback.h
--- a/xbmc/cores/IPlayerCallback.h
+++ b/xbmc/cores/IPlayerCallback.h
@@ -0,6 +0,7 @@
   virtual void OnPlayBackStopped() = 0;
   virtual void OnPlayBackError() = 0;
   virtual void OnQueueNextItem() = 0;
+  virtual void OnPrefetchNextItem() {}
   virtual void OnPlayBackSeek(int64_t iTime, int64_t seekOffset) {}
   virtual void OnPlayBackSeekChapter(int iChapter) {}
   virtual void OnPlayBackSpeedChanged(int iSpeed) {}
