From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 9 Nov 2026 21:53:02 -0600
Subject: [PATCH] VideoPlayer: open the next item early in an inputstream
 add-on

The next playlist item opens ahead only as a plain file, so an add-on
item loads the add-on and sets up its manifest and session at the join.
Not every add-on can open safely beside another instance of itself.
---
 .../DVDInputStreams/DVDFactoryInputStream.cpp | 12 ++-
 .../DVDInputStreams/DVDFactoryInputStream.h   | 10 ++-
 .../DVDInputStreams/InputStreamAddon.cpp      |  5 ++
 .../DVDInputStreams/InputStreamAddon.h        |  2 +
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 83 ++++++++++++++-----
 5 files changed, 85 insertions(+), 27 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.cpp
@@ -0,12 +0,16 @@
                                                XFILE::READ_TRUNCATED | XFILE::READ_BITRATE);
 }
 
-bool CDVDFactoryInputStream::IsPlainFile(const CFileItem& fileitem)
+DVDStreamType CDVDFactoryInputStream::GetPrefetchType(const CFileItem& fileitem)
 {
   ADDON::AddonInfoPtr addonInfo;
-  return GetInputType(fileitem, addonInfo) == InputType::FILE &&
-         !URIUtils::IsStack(fileitem.GetDynPath()) &&
-         !(NETWORK::IsInternetStream(fileitem) && IsFFmpegStream(fileitem));
+  const InputType type = GetInputType(fileitem, addonInfo);
+  if (type == InputType::ADDON && CInputStreamAddon::SupportsPrefetch(addonInfo))
+    return DVDSTREAM_TYPE_ADDON;
+  if (type == InputType::FILE && !URIUtils::IsStack(fileitem.GetDynPath()) &&
+      !(NETWORK::IsInternetStream(fileitem) && IsFFmpegStream(fileitem)))
+    return DVDSTREAM_TYPE_FILE;
+  return DVDSTREAM_TYPE_NONE;
 }
 
 std::shared_ptr<CDVDInputStream> CDVDFactoryInputStream::CreateInputStream(IVideoPlayer* pPlayer, const CFileItem &fileitem, const std::vector<std::string>& filenames)
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.h
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.h
@@ -0,6 +0,8 @@
 
 #pragma once
 
+#include "DVDInputStream.h"
+
 #include <memory>
 #include <string>
 #include <vector>
@@ -0,8 +0,8 @@
   static std::shared_ptr<CDVDInputStream> CreateInputStream(IVideoPlayer* pPlayer, const CFileItem &fileitem, bool scanforextaudio = false);
   static std::shared_ptr<CDVDInputStream> CreateInputStream(IVideoPlayer* pPlayer, const CFileItem &fileitem, const std::vector<std::string>& filenames);
 
-  // Whether the item opens as one plain file input, decided without constructing anything.
-  // External audio files and a redirect to a stream still change the input, so a caller checks
-  // the one it creates.
-  static bool IsPlainFile(const CFileItem& fileitem);
+  // The input an item opens as ahead of its playback, decided without constructing anything:
+  // one plain file, an add-on that declares it, or none. External audio files and a redirect to a
+  // stream still change the input, so a caller checks the one it creates.
+  static DVDStreamType GetPrefetchType(const CFileItem& fileitem);
 };
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.cpp
@@ -0,6 +0,11 @@
   return false;
 }
 
+bool CInputStreamAddon::SupportsPrefetch(const AddonInfoPtr& addonInfo)
+{
+  return addonInfo->Type(AddonType::INPUTSTREAM)->GetValue("@prefetch").asBoolean();
+}
+
 bool CInputStreamAddon::Open()
 {
   // Create "C" interface structures, used as own parts to prevent API problems on update
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.h b/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.h
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.h
@@ -0,6 +0,8 @@
   ~CInputStreamAddon() override;
 
   static bool Supports(const ADDON::AddonInfoPtr& addonInfo, const CFileItem& fileitem);
+  // whether an instance may open ahead of playback, beside another open instance of the add-on
+  static bool SupportsPrefetch(const ADDON::AddonInfoPtr& addonInfo);
 
   void SetPrefetch(bool prefetch) { m_prefetch = prefetch; }
 
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -0,6 +0,7 @@
 #include "DVDInputStreams/DVDInputStreamBluray.h"
 #endif
 #include "DVDInputStreams/DVDInputStreamNavigator.h"
+#include "DVDInputStreams/InputStreamAddon.h"
 #include "DVDInputStreams/InputStreamPVRBase.h"
 #include "DVDMessage.h"
 #include "DVDSubtitles/DVDMenuPlane.h"
@@ -0,6 +0,15 @@
     cancelled = true;
     if (opening)
       opening->Abort();
+    // closing an open input can wait on the network, so it does not run on the player thread
+    if (input || demuxer)
+      CServiceBroker::GetJobManager()->Submit(
+          [in = std::move(input), dmx = std::move(demuxer)]() mutable
+          {
+            dmx.reset();
+            in.reset();
+          },
+          CJob::PRIORITY_NORMAL);
   }
 
   CCriticalSection section;
@@ -0,6 +0,25 @@
 
 namespace
 {
+// the screen an add-on input reads, for an input that can outlive the player
+class CPrefetchScreen : public IVideoPlayer
+{
+public:
+  int OnDiscNavResult(void*, int) override { return 0; }
+  void GetVideoResolution(unsigned int& width, unsigned int& height) override
+  {
+    // without a window system the caller keeps its default
+    if (auto system = CServiceBroker::GetWinSystem(); system != nullptr)
+    {
+      const RESOLUTION_INFO res = system->GetGfxContext().GetResInfo();
+      width = res.iWidth;
+      height = res.iHeight;
+    }
+  }
+};
+
+CPrefetchScreen prefetchScreen;
+
 // the item fields the input and demuxer open from; the mime type is compared apart
 bool OpensSameInput(const CFileItem& item, const CFileItem& other)
 {
@@ -0,8 +0,8 @@
                                           CJob::PRIORITY_NORMAL);
 }
 
-// Opens the input and demuxer of the slot's item as the open of a plain file does, on a job
-// thread. A slot dropped before the job ends gets nothing, and the job releases what it opened.
+// Opens the input and demuxer of the slot's item as the player's open does, on a job thread. A
+// slot dropped before the job ends gets nothing, and the job releases what it opened before done.
 void CVideoPlayer::Prefetch(const std::shared_ptr<PrefetchSlot>& slot)
 {
   const auto cancelled = [&slot]()
@@ -0,7 +0,7 @@
 
   CFFmpegLog::SetLogLevel(1);
   std::shared_ptr<CDVDInputStream> input;
-  std::unique_ptr<CDVDDemuxFFmpeg> demuxer;
+  std::unique_ptr<CDVDDemux> demuxer;
   const std::string_view failure = [&]() -> std::string_view
   {
     // typed as the application and the player type it
@@ -0,38 +0,50 @@
     if (item.GetMimeType().empty())
       item.FillInMimeType();
 
-    if (CDVDFactoryInputStream::IsPlainFile(item))
-      input = CDVDFactoryInputStream::CreateInputStream(nullptr, item);
-    if (!input || !input->IsStreamType(DVDSTREAM_TYPE_FILE))
-      return "it is not a plain file";
+    const DVDStreamType type{CDVDFactoryInputStream::GetPrefetchType(item)};
+    if (type == DVDSTREAM_TYPE_NONE)
+      return "it does not open early";
+    input = CDVDFactoryInputStream::CreateInputStream(&prefetchScreen, item);
+    if (!input || !input->IsStreamType(type))
+      return "it opens as another input";
+    if (const auto addon = std::dynamic_pointer_cast<CInputStreamAddon>(input))
+      addon->SetPrefetch(true);
     if (cancelled())
       return "it was dropped";
     // the open at the join tries again, as a source that is waking up may answer by then
     if (!input->Open())
       return "its input did not open";
-    // a live stream would play from where it was opened
-    if (input->GetLength() <= 0)
-      return "its length is unknown";
+    // a live stream would play from where it was opened; an add-on knows it once open
+    if (type == DVDSTREAM_TYPE_ADDON ? input->IsRealtime() : input->GetLength() <= 0)
+      return "it can be live";
+    if (input->GetIDemux())
+    {
+      demuxer.reset(CDVDFactoryDemuxer::CreateDemuxer(input));
+      if (!demuxer)
+        return "its demuxer did not open";
+      return {};
+    }
     if (!CDVDFactoryDemuxer::IsFFmpegFile(input))
       return "it has its own demuxer";
 
-    demuxer = std::make_unique<CDVDDemuxFFmpeg>();
+    auto ffmpeg = std::make_unique<CDVDDemuxFFmpeg>();
     {
       std::unique_lock lock(slot->section);
       if (slot->cancelled)
         return "it was dropped";
-      slot->opening = demuxer.get();
+      slot->opening = ffmpeg.get();
     }
-    const bool opened{demuxer->Open(input, true, false)};
+    const bool opened{ffmpeg->Open(input, true, false)};
     {
       std::unique_lock lock(slot->section);
       slot->opening = nullptr;
     }
     if (!opened)
       return "its demuxer did not open";
-    const int64_t time = demuxer->GetStreamLength();
+    const int64_t time = ffmpeg->GetStreamLength();
     if (time > 0)
       input->SetReadRate(static_cast<uint32_t>(input->GetLength() * 1000 / time));
+    demuxer = std::move(ffmpeg);
     return {};
   }();
   CFFmpegLog::ClearLogLevel();
@@ -0,13 +0,17 @@
   if (!failure.empty())
     CLog::Log(LOGDEBUG, "VideoPlayer: the next item was not prepared, {}", failure);
 
-  std::unique_lock lock(slot->section);
-  if (!slot->cancelled && failure.empty())
   {
-    slot->mimeType = item.GetMimeType();
-    slot->input = std::move(input);
-    slot->demuxer = std::move(demuxer);
+    std::unique_lock lock(slot->section);
+    if (!slot->cancelled && failure.empty())
+    {
+      slot->mimeType = item.GetMimeType();
+      slot->input = std::move(input);
+      slot->demuxer = std::move(demuxer);
+    }
   }
+  demuxer.reset();
+  input.reset();
   slot->done.Set();
 }
 
