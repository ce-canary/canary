From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 10 Nov 2026 11:11:56 -0600
Subject: [PATCH] AMLCodec: log a missing end of stream as a decoder error

After an end of input, a drain ends on the decoder's end of stream
once Kodi has shown every picture. A decoder that never reports its
end leaves the drain to its timeout. That logs only the warning of an
ordinary drain, which hides a decoder fault.
---
 xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -0,8 +0,11 @@
            std::chrono::system_clock::now() - std::max(m_tp_drain, m_tp_last_frame) >
                std::chrono::seconds(m_decoder_timeout))
   {
-    CLog::Log(LOGWARNING, "CAMLCodec::GetPicture: drain ends without frame, {} queued",
-              queued_frames);
+    if (m_inputEndSent && !inputDrained)
+      CLog::Log(LOGERROR, "CAMLCodec::GetPicture: decoder reports no end of stream");
+    else
+      CLog::Log(LOGWARNING, "CAMLCodec::GetPicture: drain ends without frame, {} queued",
+                queued_frames);
     m_tp_drain = std::chrono::system_clock::now();
     return CDVDVideoCodec::VC_EOF;
   }
