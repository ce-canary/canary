From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 10 Nov 2026 08:48:37 -0600
Subject: [PATCH] VideoPlayer: choose the display mode for a stream's largest
 size

The display mode is chosen for the size of the stream's first picture.
An adaptive stream that starts below its top representation gets a
mode too small for its later pictures, and a later size change can
switch the mode mid-play.
---
 xbmc/cores/DataCacheCore.cpp                    | 14 ++++++++++++++
 xbmc/cores/DataCacheCore.h                      |  6 ++++++
 xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp  |  6 ++++++
 xbmc/cores/VideoPlayer/Process/ProcessInfo.h    |  1 +
 xbmc/cores/VideoPlayer/VideoPlayer.cpp          |  9 ++++++++-
 .../VideoRenderers/RenderManager.cpp            | 17 ++++++++++++-----
 6 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/DataCacheCore.cpp b/xbmc/cores/DataCacheCore.cpp
--- a/xbmc/cores/DataCacheCore.cpp
+++ b/xbmc/cores/DataCacheCore.cpp
@@ -0,6 +0,20 @@
   return m_playerVideoInfo.m_isInterlaced;
 }
 
+void CDataCacheCore::SetVideoMaxSize(int width, int height)
+{
+  std::unique_lock lock(m_videoPlayerSection);
+
+  m_playerVideoInfo.maxSize = CSizeInt(width, height);
+}
+
+CSizeInt CDataCacheCore::GetVideoMaxSize()
+{
+  std::unique_lock lock(m_videoPlayerSection);
+
+  return m_playerVideoInfo.maxSize;
+}
+
 void CDataCacheCore::SetDiscFormat(const DiscFormat& format)
 {
   std::unique_lock lock(m_videoPlayerSection);
diff --git a/xbmc/cores/DataCacheCore.h b/xbmc/cores/DataCacheCore.h
--- a/xbmc/cores/DataCacheCore.h
+++ b/xbmc/cores/DataCacheCore.h
@@ -0,6 +0,7 @@
 
 #include "EdlEdit.h"
 #include "threads/CriticalSection.h"
+#include "utils/Geometry.h"
 
 #include <atomic>
 #include <chrono>
@@ -0,6 +0,10 @@
    */
   bool IsVideoInterlaced();
 
+  // the largest size the video stream may switch to, empty if it declares none
+  void SetVideoMaxSize(int width, int height);
+  CSizeInt GetVideoMaxSize();
+
   void SetDiscFormat(const DiscFormat& format);
   DiscFormat GetDiscFormat();
 
@@ -0,6 +0,7 @@
     int liveBitRate;
     int queueLevel;
     int queueDataLevel;
+    CSizeInt maxSize;
     DiscFormat discFormat;
   } m_playerVideoInfo;
 
diff --git a/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp b/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
--- a/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
+++ b/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
@@ -0,6 +0,12 @@
   return m_IsHdr10Plus;
 }
 
+void CProcessInfo::SetVideoMaxSize(int width, int height)
+{
+  if (m_dataCache)
+    m_dataCache->SetVideoMaxSize(width, height);
+}
+
 void CProcessInfo::SetDiscFormat(const DiscFormat& format)
 {
   if (m_dataCache)
