From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 15 Nov 2026 17:40:41 -0600
Subject: [PATCH] ActiveAE: drop a sync error measured before a pause

A paused stream is synced anew when the engine takes the resume. Until
its first pass after that, the stats still show the stream in sync with
the error from before the pause, and the sink keeps an error it read
that the player has not applied yet. A player that resumed applied that
error on top of the new start sync.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 48 ++++++++++++++++++-
 .../AudioEngine/Engines/ActiveAE/ActiveAE.h   |  4 ++
 xbmc/cores/VideoPlayer/AudioSinkAE.cpp        |  3 ++
 3 files changed, 53 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -0,7 +0,9 @@
     if (str.m_streamId == stream->m_id)
     {
       float delay = 0;
-      str.m_syncState = stream->m_syncState;
+      // a stream paused by its player is not in sync before the engine restarted its sync
+      if (!str.m_syncPaused)
+        str.m_syncState = stream->m_syncState;
       str.m_lateStartHandedOver = stream->m_lateStartHandedOver;
       str.m_exactStart = stream->m_exactStart;
       str.m_syncError = stream->m_syncError.GetLastError(str.m_errorTime);
@@ -0,6 +0,35 @@
   }
 }
 
+void CEngineStats::PauseStream(CActiveAEStream* stream)
+{
+  std::unique_lock lock(m_lock);
+  for (auto& str : m_streamStats)
+  {
+    if (str.m_streamId == stream->m_id)
+    {
+      str.m_syncState = CAESyncInfo::AESyncState::SYNC_START;
+      str.m_syncPaused = true;
+      return;
+    }
+  }
+}
+
+bool CEngineStats::TakeSyncPaused(CActiveAEStream* stream)
+{
+  std::unique_lock lock(m_lock);
+  for (auto& str : m_streamStats)
+  {
+    if (str.m_streamId == stream->m_id)
+    {
+      const bool paused = str.m_syncPaused;
+      str.m_syncPaused = false;
+      return paused;
+    }
+  }
+  return false;
+}
+
 // this is used to sync a/v so we need to add sink latency here
 void CEngineStats::GetDelay(AEDelayStatus& status, CActiveAEStream *stream)
 {
@@ -0,6 +0,14 @@
           }
           ConfigureLowLatency();
           return;
+        case CActiveAEControlProtocol::RESUMESTREAM:
+        {
+          // a resume dropped while not configured still ends the player's pause
+          CActiveAEStream* stream = *reinterpret_cast<CActiveAEStream**>(msg->data);
+          if (m_stats.TakeSyncPaused(stream))
+            stream->m_syncState = CAESyncInfo::AESyncState::SYNC_START;
+          break;
+        }
         default:
           break;
         }
@@ -0,7 +0,7 @@
           return;
         case CActiveAEControlProtocol::RESUMESTREAM:
           stream = *(CActiveAEStream**)msg->data;
-          if (stream->m_paused)
+          if (m_stats.TakeSyncPaused(stream) || stream->m_paused)
             stream->m_syncState = CAESyncInfo::AESyncState::SYNC_START;
           stream->m_paused = false;
           streaming = true;
@@ -0,6 +0,7 @@
         case CActiveAEControlProtocol::RESUMESTREAM:
           CActiveAEStream *stream;
           stream = *(CActiveAEStream**)msg->data;
+          m_stats.TakeSyncPaused(stream);
           stream->m_paused = false;
           stream->m_syncState = CAESyncInfo::AESyncState::SYNC_START;
           m_state = AE_TOP_CONFIGURED_PLAY;
@@ -0,6 +0,7 @@
   stream->m_processingBuffers->Flush();
   stream->m_streamPort->Purge();
   stream->m_bufferedTime = 0.0;
+  m_stats.TakeSyncPaused(stream);
   stream->m_paused = false;
   stream->m_syncState = CAESyncInfo::AESyncState::SYNC_START;
   stream->m_syncError.Flush();
@@ -0,8 +0,11 @@
 {
   //! @todo pause sink, needs api change
   if (pause)
+  {
+    m_stats.PauseStream(stream);
     m_controlPort.SendOutMessage(CActiveAEControlProtocol::PAUSESTREAM,
                                    &stream, sizeof(CActiveAEStream*));
+  }
   else
     m_controlPort.SendOutMessage(CActiveAEControlProtocol::RESUMESTREAM,
                                    &stream, sizeof(CActiveAEStream*));
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -0,6 +0,8 @@
   void AddStream(unsigned int streamid);
   void RemoveStream(unsigned int streamid);
   void UpdateStream(CActiveAEStream *stream);
+  void PauseStream(CActiveAEStream* stream);
+  bool TakeSyncPaused(CActiveAEStream* stream);
   void GetDelay(AEDelayStatus& status, CActiveAEStream *stream);
   void GetSyncInfo(CAESyncInfo& info, CActiveAEStream *stream);
   float GetCacheTime(CActiveAEStream *stream);
@@ -0,6 +0,8 @@
     CAESyncInfo::AESyncState m_syncState;
     bool m_lateStartHandedOver{false};
     bool m_exactStart{false};
+    // paused by the player since the engine last restarted the stream's sync
+    bool m_syncPaused{false};
   };
   std::vector<StreamStats> m_streamStats;
 };
diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
@@ -0,6 +0,9 @@
     m_pAudioStream->Pause();
   CLog::Log(LOGDEBUG,"CDVDAudio::Pause - pausing audio stream");
   m_playingPts = DVD_NOPTS_VALUE;
+  // the engine syncs the stream anew on resume
+  m_syncError = 0.0;
+  m_syncErrorTime = 0;
   m_startSyncError = false;
   m_startSyncErrorExact = false;
 }
