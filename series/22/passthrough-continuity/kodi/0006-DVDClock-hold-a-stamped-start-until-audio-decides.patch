From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 16 Nov 2026 10:29:57 -0600
Subject: [PATCH] DVDClock: hold a stamped start until audio decides

A clock start from pause runs the picture at once. Audio that keeps its
stream's silent frame on the wire through a pause keeps its rhythm, so
it can start only in whole frames and leaves the rest of its error to
the clock. Moved after the picture ran on it, the clock freezes the
picture.
---
 xbmc/cores/VideoPlayer/DVDClock.cpp   | 150 +++++++++++++++++++++++++-
 xbmc/cores/VideoPlayer/DVDClock.h     |  44 +++++++-
 xbmc/cores/VideoPlayer/VsyncPhase.cpp |   3 +
 3 files changed, 193 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDClock.cpp b/xbmc/cores/VideoPlayer/DVDClock.cpp
--- a/xbmc/cores/VideoPlayer/DVDClock.cpp
+++ b/xbmc/cores/VideoPlayer/DVDClock.cpp
@@ -0,6 +0,13 @@
 #include <memory>
 #include <mutex>
 
+namespace
+{
+// how far the running clock starts behind a start target: past the decision (60 to 130 ms after
+// the start) and under the second after which subtitles reset on a clock that went back
+constexpr double START_LEAD_MS = 500.0;
+} // namespace
+
 CDVDClock::CDVDClock()
 {
   std::unique_lock lock(m_systemsection);
@@ -0,10 +0,19 @@
   m_systemAdjust += m_speedAdjust * (current - m_lastSystemTime);
   m_lastSystemTime = current;
 
-  return SystemToPlaying(current);
+  const double clock = SystemToPlaying(current);
+  return clock + GetStartTargetLead(current);
 }
 
 double CDVDClock::GetClock(double& absolute, bool interpolated /*= true*/)
+{
+  std::unique_lock lock(m_critSection);
+
+  const double clock = GetRunningClock(absolute, interpolated);
+  return clock + GetStartTargetLead(m_lastSystemTime);
+}
+
+double CDVDClock::GetRunningClock(double& absolute, bool interpolated /*= true*/)
 {
   std::unique_lock critLock(m_critSection);
   int64_t current = m_videoRefClock->GetTime(interpolated);
@@ -0,7 +0,8 @@
 {
   std::unique_lock lock(m_critSection);
 
-  const double clock = GetClock();
+  double absolute{0.0};
+  const double clock = GetRunningClock(absolute);
   return clock + m_vSyncAdjust;
 }
 
@@ -0,6 +0,14 @@
     return;
   }
 
+  // a start target ends at any other speed, with the clock at it
+  if (iSpeed != DVD_PLAYSPEED_NORMAL)
+  {
+    m_iDisc += GetStartTargetLead(m_videoRefClock->GetTime());
+    m_startTarget = DVD_NOPTS_VALUE;
+    m_startPending = false;
+  }
+
   if (iSpeed == DVD_PLAYSPEED_PAUSE)
   {
     if (!m_pauseClock)
@@ -0,6 +0,10 @@
 
   int64_t current;
   int64_t newfreq = m_systemFrequency * DVD_PLAYSPEED_NORMAL / iSpeed;
+  // stamped audio keeps its rhythm through a pause and starts only in whole frames, so the
+  // picture waits behind the start value until the audio decided how it meets it
+  const bool startTarget{m_pauseClock && iSpeed == DVD_PLAYSPEED_NORMAL && m_audioStamped &&
+                         !m_bReset};
 
   if (m_pauseClock || newfreq != m_systemUsed)
     m_clockEpoch++;
@@ -0,6 +0,8 @@
 
   m_startClock = current - (int64_t)((double)(current - m_startClock) * newfreq / m_systemUsed);
   m_systemUsed = newfreq;
+  if (startTarget)
+    ArmStartTarget(current);
 }
 
 void CDVDClock::SetSpeedAdjust(double adjust)
@@ -0,10 +0,14 @@
 void CDVDClock::Discontinuity(double clock, double absolute)
 {
   std::unique_lock lock(m_critSection);
+  // a start target moves to `clock`, and the clock stays behind it by the lead left
+  const double lead = GetStartTargetLead(AbsoluteToSystem(absolute));
+  if (m_startTarget != DVD_NOPTS_VALUE)
+    m_startTarget = clock;
   m_startClock = AbsoluteToSystem(absolute);
   if(m_pauseClock)
     m_pauseClock = m_startClock;
-  m_iDisc = clock;
+  m_iDisc = clock - lead;
   m_bReset = false;
   m_systemAdjust = 0;
   m_speedAdjust = 0;
@@ -0,6 +0,8 @@
     m_vSyncAdjust = 0;
     m_bReset = false;
     m_clockEpoch++;
+    m_startTarget = DVD_NOPTS_VALUE;
+    m_startPending = false;
   }
 
   if (m_pauseClock)
@@ -0,3 +0,110 @@
   double speed = (double)m_systemFrequency / m_systemUsed;
   return m_videoRefClock->GetSpeed() * speed + m_speedAdjust;
 }
+
+double CDVDClock::GetStartTargetLead(int64_t system)
+{
+  if (m_startTarget != DVD_NOPTS_VALUE && !m_bReset)
+  {
+    const double lead = m_startTarget - SystemToPlaying(system);
+    if (lead > 0 || m_startPending)
+      return lead;
+  }
+  m_startTarget = DVD_NOPTS_VALUE;
+  m_startPending = false;
+  return 0.0;
+}
+
+void CDVDClock::SetAudioStamped(bool stamped)
+{
+  std::unique_lock lock(m_critSection);
+  m_audioStamped = stamped;
+}
+
+void CDVDClock::SetQueued(double first, double last)
+{
+  std::unique_lock lock(m_critSection);
+  m_firstQueued = first;
+  m_lastQueued = last;
+}
+
+bool CDVDClock::CanRelease(int epoch, bool target) const
+{
+  std::unique_lock lock(m_critSection);
+
+  return !m_startPending && epoch >= m_startArmEpoch && (epoch == m_clockEpoch || !target);
+}
+
+bool CDVDClock::IsAtStartTarget()
+{
+  std::unique_lock lock(m_critSection);
+
+  return GetStartTargetLead(m_videoRefClock->GetTime()) > 0 || m_startPending;
+}
+
+bool CDVDClock::ArmStartTarget()
+{
+  std::unique_lock lock(m_critSection);
+
+  if (!m_startPending && !m_pauseClock && !m_bReset && m_systemUsed == m_systemFrequency)
+    ArmStartTarget(m_videoRefClock->GetTime());
+  return m_startPending;
+}
+
+void CDVDClock::EndStartTarget()
+{
+  std::unique_lock lock(m_critSection);
+
+  m_audioStamped = false;
+  if (!m_startPending)
+    return;
+
+  m_iDisc += GetStartTargetLead(m_videoRefClock->GetTime());
+  m_startTarget = DVD_NOPTS_VALUE;
+  m_startPending = false;
+  m_clockEpoch++;
+}
+
+bool CDVDClock::GetStartTarget(double& first, double& last, int& epoch)
+{
+  std::unique_lock lock(m_critSection);
+
+  const int64_t current = m_videoRefClock->GetTime();
+  const double lead = GetStartTargetLead(current);
+  const double clock = SystemToPlaying(current);
+  first = m_firstQueued != DVD_NOPTS_VALUE ? m_firstQueued - clock : lead;
+  last = m_lastQueued != DVD_NOPTS_VALUE ? m_lastQueued - clock : lead;
+  epoch = m_clockEpoch;
+  return m_startPending;
+}
+
+bool CDVDClock::SetStartTarget(double move, int epoch)
+{
+  std::unique_lock lock(m_critSection);
+
+  const int64_t current = m_videoRefClock->GetTime();
+  const double running = SystemToPlaying(current);
+  if (!m_startPending || epoch != m_clockEpoch)
+    return false;
+
+  // moved from the running clock as it is now, so a move by whole phase periods keeps the phase
+  const double target = m_startTarget;
+  const double clock = running + move;
+  m_startTarget = DVD_NOPTS_VALUE;
+  m_startPending = false;
+  Discontinuity(clock, SystemToAbsolute(current));
+  if (clock < target)
+    m_startTarget = target;
+  return true;
+}
+
+void CDVDClock::ArmStartTarget(int64_t system)
+{
+  const double clock = SystemToPlaying(system);
+  const double target = clock + GetStartTargetLead(system);
+  m_startTarget = target;
+  m_startPending = true;
+  m_iDisc += target - DVD_MSEC_TO_TIME(START_LEAD_MS) - clock;
+  m_clockEpoch++;
+  m_startArmEpoch = m_clockEpoch;
+}
diff --git a/xbmc/cores/VideoPlayer/DVDClock.h b/xbmc/cores/VideoPlayer/DVDClock.h
--- a/xbmc/cores/VideoPlayer/DVDClock.h
+++ b/xbmc/cores/VideoPlayer/DVDClock.h
@@ -0,6 +0,7 @@
 #pragma once
 
 #include "VsyncPhase.h"
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
 #include "threads/CriticalSection.h"
 
 #include <memory>
@@ -0,9 +0,13 @@
   CDVDClock();
   ~CDVDClock();
 
+  //! The clock, which stands at a start target while it is pending or the running clock is behind
+  //! it
   double GetClock(bool interpolated = true);
   double GetClock(double& absolute, bool interpolated = true);
-  //! The clock plus the vsync adjust, read together
+  //! The clock as it runs, behind a start target, for what paces and releases pictures
+  double GetRunningClock(double& absolute, bool interpolated = true);
+  //! The running clock plus the vsync adjust, read together
   double GetClockWithVsyncAdjust();
   //! The clock and the epoch of its mapping, read together
   double GetClock(int& epoch);
@@ -0,10 +0,39 @@
   bool IsPaused() const;
   void Advance(double time);
 
+  //! Whether the audio keeps its stream's silent frame on the wire through a pause, which a
+  //! clock start from pause then holds a start target for
+  void SetAudioStamped(bool stamped);
+  //! The clocks at which the first and the last queued pictures are due, DVD_NOPTS_VALUE without
+  //! one
+  void SetQueued(double first, double last);
+  //! Whether a picture release read at `epoch` may go out: none while a start target is pending,
+  //! and a read from before a start target was armed or moved the clock is stale
+  bool CanRelease(int epoch, bool target) const;
+  //! Whether the clock readers stand at a start target
+  bool IsAtStartTarget();
+  //! Arms a start target at the readers' value on a running clock at normal speed unless one is
+  //! pending; whether one is pending
+  bool ArmStartTarget();
+  //! Ends a pending start target with the clock at it, and the audio is no longer stamped
+  void EndStartTarget();
+  //! Whether a start target is pending, with how far ahead of the running clock the first and the
+  //! last queued pictures are due and the `epoch` they were read at
+  bool GetStartTarget(double& first, double& last, int& epoch);
+  //! Ends a pending start target with the running clock moved by `move`; false without one or at
+  //! another epoch. The readers stay at the target until the running clock reaches it.
+  bool SetStartTarget(double move, int epoch);
+
 protected:
   double SystemToAbsolute(int64_t system) const;
   int64_t AbsoluteToSystem(double absolute) const;
   double SystemToPlaying(int64_t system);
+  //! How far the clock at `system` is behind a start target, below 0 once it passed a pending one,
+  //! 0 once there is none
+  double GetStartTargetLead(int64_t system);
+  //! Holds the readers at their value as a pending start target, with the running clock the lead
+  //! behind it
+  void ArmStartTarget(int64_t system);
 
   mutable CCriticalSection m_critSection;
   int64_t m_systemUsed;
@@ -0,4 +0,12 @@
   friend class CVsyncPhase;
   int m_clockEpoch{0};
   CVsyncPhase m_vsyncPhase{*this};
+  // a start of stamped audio holds the clock readers at this value while it is pending and then
+  // until the running clock reaches it; pending until the audio sets the clock or the start ends
+  double m_startTarget{DVD_NOPTS_VALUE};
+  bool m_startPending{false};
+  int m_startArmEpoch{0};
+  double m_firstQueued{DVD_NOPTS_VALUE};
+  double m_lastQueued{DVD_NOPTS_VALUE};
+  bool m_audioStamped{false};
 };
diff --git a/xbmc/cores/VideoPlayer/VsyncPhase.cpp b/xbmc/cores/VideoPlayer/VsyncPhase.cpp
--- a/xbmc/cores/VideoPlayer/VsyncPhase.cpp
+++ b/xbmc/cores/VideoPlayer/VsyncPhase.cpp
@@ -0,6 +0,9 @@
   {
     const double wrap = vsyncPhase > 0 ? m_phasePeriod : -m_phasePeriod;
     m_clock.m_iDisc -= wrap;
+    // a start target keeps its lead
+    if (m_clock.m_startTarget != DVD_NOPTS_VALUE)
+      m_clock.m_startTarget -= wrap;
     vsyncPhase -= wrap;
     CLog::Log(LOGDEBUG, "CVsyncPhase::SetVsyncPhase - phase wrap, clock:{:.3f} wrap:{:.3f}",
               m_clock.GetClock() / DVD_TIME_BASE, wrap / DVD_TIME_BASE);
