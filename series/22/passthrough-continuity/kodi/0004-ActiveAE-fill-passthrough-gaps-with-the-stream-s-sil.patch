From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 16 Nov 2026 10:30:21 -0600
Subject: [PATCH] ActiveAE: fill passthrough gaps with the stream's silent
 frame

A pause or seek in passthrough leaves gaps that the sink fills with IEC
pause bursts or zeros, so the stream stops at each one.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp  | 11 +++++++++++
 .../AudioEngine/Engines/ActiveAE/ActiveAE.h    |  1 +
 .../Engines/ActiveAE/ActiveAEBuffer.cpp        |  1 +
 .../Engines/ActiveAE/ActiveAEBuffer.h          |  3 +++
 .../Engines/ActiveAE/ActiveAESink.cpp          |  6 +++++-
 .../Engines/ActiveAE/ActiveAESink.h            |  2 ++
 .../AudioEngine/Utils/AEBitstreamPacker.cpp    | 18 ++++++++++++++++--
 .../AudioEngine/Utils/AEBitstreamPacker.h      |  7 ++++++-
 8 files changed, 45 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -0,6 +0,7 @@
 #include "cores/AudioEngine/AEResampleFactory.h"
 #include "cores/AudioEngine/Encoders/AEEncoderFFmpeg.h"
 #include "cores/AudioEngine/Interfaces/IAudioCallback.h"
+#include "cores/AudioEngine/Utils/AEPassthroughSilence.h"
 #include "cores/AudioEngine/Utils/AEStreamData.h"
 #include "cores/AudioEngine/Utils/AEStreamInfo.h"
 #include "cores/AudioEngine/Utils/AEUtil.h"
@@ -0,6 +0,14 @@
         if (!(*it)->m_processingBuffers->m_outputSamples.empty() && !(*it)->m_paused)
         {
           (*it)->m_started = true;
+          // gaps are filled with the stream's silent frame once one of its frames is on the wire,
+          // by a sink that packs IEC 61937 itself
+          CSampleBuffer* front = (*it)->m_processingBuffers->m_outputSamples.front();
+          const AEPassthroughSilentFrame* silentFrame{
+              m_stats.GetSinkNeedIec()
+                  ? CAEPassthroughSilence::Find((*it)->m_format.m_streamInfo.m_type,
+                                                front->pkt->data[0], front->pkt->nb_samples)
+                  : nullptr};
           buffer = SyncStream(*it);
           m_stats.UpdateStream(*it);
           if (!buffer)
@@ -0,6 +0,8 @@
             buffer = (*it)->m_processingBuffers->m_outputSamples.front();
             (*it)->m_processingBuffers->m_outputSamples.pop_front();
           }
+          if (silentFrame && buffer->pkt->nb_samples > 0)
+            buffer->pkt->silent_frame = silentFrame;
           if (buffer->pkt->nb_samples > 0)
             m_stats.AddSamples(1, m_streams);
           else
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -0,6 +0,7 @@
   void SetSinkCacheTotal(float time) { m_sinkCacheTotal = time; }
   void SetSinkLatency(float time) { m_sinkLatency = time; }
   void SetSinkNeedIec(bool needIEC) { m_sinkNeedIecPack = needIEC; }
+  bool GetSinkNeedIec() const { return m_sinkNeedIecPack; }
   bool IsSuspended();
   AEAudioFormat GetCurrentSinkFormat();
 protected:
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
@@ -0,6 +0,7 @@
 {
   buffer->pkt->nb_samples = 0;
   buffer->pkt->pause_burst_ms = 0;
+  buffer->pkt->silent_frame = nullptr;
   m_freeSamples.push_back(buffer);
 }
 
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.h
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.h
@@ -0,6 +0,8 @@
 #include <libswresample/swresample.h>
 }
 
+struct AEPassthroughSilentFrame;
+
 namespace ActiveAE
 {
 
@@ -0,6 +0,7 @@
   int nb_samples;                        // number of frames used
   int max_nb_samples;                    // max number of frames this packet can hold
   int pause_burst_ms;
+  const AEPassthroughSilentFrame* silent_frame{nullptr}; // a raw gap's content, else pause bursts
 };
 
 class CActiveAEBufferPool;
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -0,6 +0,7 @@
   // init sample of silence/noise
   m_sampleOfSilence.pkt = std::make_unique<CSoundPacket>(config, m_sinkFormat.m_frames);
   m_sampleOfSilence.pkt->nb_samples = m_sampleOfSilence.pkt->max_nb_samples;
+  m_silentFrame = nullptr;
   if (!passthrough)
     GenerateNoise();
   else
@@ -0,6 +0,8 @@
       rawPackets = 1;
     else if (samples->pool)
       rawPauseMs = samples->pkt->pause_burst_ms;
+    if (samples->pool)
+      m_silentFrame = samples->pkt->silent_frame;
 
     bool skipSwap = false;
     if (m_needIecPack)
@@ -0,7 +0,8 @@
       {
         // construct a pause burst if we have already output valid audio
         bool burst = m_extStreaming && (m_packer->GetBuffer()[0] != 0);
-        if (!m_packer->PackPause(m_sinkFormat.m_streamInfo, samples->pkt->pause_burst_ms, burst))
+        if (!m_packer->PackPause(m_sinkFormat.m_streamInfo, samples->pkt->pause_burst_ms, burst,
+                                 m_silentFrame))
           skipSwap = true;
       }
       else
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
@@ -0,6 +0,8 @@
   int m_sinkLatency;
   std::unique_ptr<CAEBitstreamPacker> m_packer;
   bool m_needIecPack{false};
+  // the silent frame of the last buffer from the engine, which the keep-alive repeats
+  const AEPassthroughSilentFrame* m_silentFrame{nullptr};
   bool m_streamNoise;
 };
 
diff --git a/xbmc/cores/AudioEngine/Utils/AEBitstreamPacker.cpp b/xbmc/cores/AudioEngine/Utils/AEBitstreamPacker.cpp
--- a/xbmc/cores/AudioEngine/Utils/AEBitstreamPacker.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEBitstreamPacker.cpp
@@ -0,6 +0,7 @@
 #include "AEBitstreamPacker.h"
 
 #include "AEPackIEC61937.h"
+#include "AEPassthroughSilence.h"
 #include "AEStreamInfo.h"
 #include "utils/log.h"
 
@@ -0,12 +0,25 @@
   }
 }
 
-bool CAEBitstreamPacker::PackPause(CAEStreamInfo &info, unsigned int millis, bool iecBursts)
+bool CAEBitstreamPacker::PackPause(CAEStreamInfo& info,
+                                   unsigned int millis,
+                                   bool iecBursts,
+                                   const AEPassthroughSilentFrame* silentFrame)
 {
   // re-use last buffer
-  if (m_pauseDuration == millis)
+  if (m_pauseDuration == millis && m_pauseSilentFrame == silentFrame)
     return false;
 
+  // the silent frame is sent as it is, one frame per burst
+  m_pauseSilentFrame = silentFrame;
+  if (silentFrame)
+  {
+    m_dataSize = CAEPackIEC61937::PackEAC3(const_cast<uint8_t*>(silentFrame->data),
+                                           silentFrame->size, m_packedBuffer);
+    m_pauseDuration = millis;
+    return true;
+  }
+
   switch (info.m_type)
   {
     case CAEStreamInfo::STREAM_TYPE_TRUEHD:
diff --git a/xbmc/cores/AudioEngine/Utils/AEBitstreamPacker.h b/xbmc/cores/AudioEngine/Utils/AEBitstreamPacker.h
--- a/xbmc/cores/AudioEngine/Utils/AEBitstreamPacker.h
+++ b/xbmc/cores/AudioEngine/Utils/AEBitstreamPacker.h
@@ -0,6 +0,7 @@
 #include <vector>
 
 class CAEStreamInfo;
+struct AEPassthroughSilentFrame;
 
 class CAEBitstreamPacker
 {
@@ -0,7 +0,10 @@
   ~CAEBitstreamPacker();
 
   void Pack(CAEStreamInfo &info, uint8_t* data, int size);
-  bool PackPause(CAEStreamInfo &info, unsigned int millis, bool iecBursts);
+  bool PackPause(CAEStreamInfo& info,
+                 unsigned int millis,
+                 bool iecBursts,
+                 const AEPassthroughSilentFrame* silentFrame);
   void Reset();
   uint8_t* GetBuffer();
   unsigned int GetSize() const;
@@ -0,5 +0,6 @@
   unsigned int  m_dataSize = 0;
   uint8_t       m_packedBuffer[MAX_IEC61937_PACKET];
   unsigned int m_pauseDuration = 0;
+  const AEPassthroughSilentFrame* m_pauseSilentFrame{nullptr};
 };
 
