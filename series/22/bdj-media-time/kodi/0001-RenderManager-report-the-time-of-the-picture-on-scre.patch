   double GetDisplayedPts();
 
+  struct OnScreenClock
+  {
+    double clock{DVD_NOPTS_VALUE};
+    bool hasNextPicture{false};
+  };
+
+  /**
+   * The clock time of the picture on screen: the clock without the release lead, with the video
