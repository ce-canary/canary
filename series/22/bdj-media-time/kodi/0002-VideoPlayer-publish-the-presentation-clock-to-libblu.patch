Subject: [PATCH] VideoPlayer: publish the presentation clock to libbluray

BD-J media time runs on the wall clock from the last start or seek.
It keeps counting through a pause, buffering and a held picture, so
disc programs that time graphics or jumps on it run ahead of the
picture on screen.
---
 cmake/modules/FindBluray.cmake                |  1 +
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 14 +++++++
 .../DVDInputStreams/DVDInputStreamBluray.h    |  6 +++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 38 +++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.h          |  1 +
 5 files changed, 60 insertions(+)

diff --git a/cmake/modules/FindBluray.cmake b/cmake/modules/FindBluray.cmake
--- a/cmake/modules/FindBluray.cmake
+++ b/cmake/modules/FindBluray.cmake
@@ -0,6 +0,7 @@
       set(CMAKE_REQUIRED_LIBRARIES ${${${CMAKE_FIND_PACKAGE_NAME}_SEARCH_NAME}_LINK_LIBRARIES})
       foreach(symbol bd_presented
                      bd_set_presentation_hold
+                     bd_set_presentation_clock
                      BD_PRESENTED_ALL
                      BD_SEEK_REARMS_PLAYLIST_END
                      BD_PRESENTED_TITLE_END)
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,6 +0,20 @@
   ReportPresented(titleTime);
 }
 
+void CDVDInputStreamBluray::SetPresentationClock(double time, double speed)
+{
+  if (!m_bd || !m_navmode)
+    return;
+
+  const int64_t titleTime =
+      time == DVD_NOPTS_VALUE || m_presentedLeft
+          ? -1
+          : av_rescale_q(static_cast<int64_t>(time), AVRational{1, DVD_TIME_BASE},
+                         CDVDDemuxUtils::BLURAY_CLIP_TIME_BASE);
+  bd_set_presentation_clock(m_bd, titleTime,
+                            static_cast<int>(std::lround(speed * BLURAY_RATE_NORMAL)));
+}
