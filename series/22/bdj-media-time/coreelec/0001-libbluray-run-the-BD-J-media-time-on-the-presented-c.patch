++static int64_t _clock_at(BLURAY *bd, uint64_t now)
++{
++    int64_t elapsed = now > bd->clock_stamp ? (int64_t)(now - bd->clock_stamp) : 0;
++
++    if (bd->clock_time < 0) {
++        return -1;
++    }
++    return bd->clock_time + elapsed * bd->clock_rate / 1000000;
++}
++
++void bd_set_presentation_clock(BLURAY *bd, int64_t title_time, int rate)
++{
++    uint64_t now = bd_get_monotonic_us();
++
++    bd_mutex_lock(&bd->clock_mutex);
++    if (bd->clock_accept) {
++        if (title_time < 0) {
++            bd->clock_time = _clock_at(bd, now);
++            bd->clock_rate = 0;
++        } else {
++            bd->clock_time = title_time;
++            bd->clock_rate = rate;
++        }
++        bd->clock_stamp = now;
++    }
++    bd_mutex_unlock(&bd->clock_mutex);
++}
++
++int64_t bdpriv_presented_clock(BLURAY *bd)
++{
++    int64_t time;
++
++    bd_mutex_lock(&bd->clock_mutex);
++    time = _clock_at(bd, bd_get_monotonic_us());
++    bd_mutex_unlock(&bd->clock_mutex);
++
++    return time;
++}
