++/**
++ *
++ *  Report the title time of the picture on screen and the rate it advances at.
++ *
++ *  The time is extrapolated at the rate until the next call. With the presentation hold
++ *  the BD-J media time of a started playlist follows it. A seek holds it at the seek
++ *  target, and a playlist or title change makes it unknown, until a call after the
++ *  pending playback start or seek is presented. Call after bd_presented().
++ *
++ * @param bd  BLURAY object
++ * @param title_time title time of the picture on screen (1/90000s), or -1 to freeze
++ *                   the last value
++ * @param rate  playback rate (BLURAY_RATE_NORMAL = 1x, 0 = stopped)
++ */
++BD_PUBLIC void bd_set_presentation_clock(BLURAY *bd, int64_t title_time, int rate);
