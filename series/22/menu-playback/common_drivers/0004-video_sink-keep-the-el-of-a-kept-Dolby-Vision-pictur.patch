From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Fri, 30 Oct 2026 18:25:39 -0500
Subject: [PATCH] video_sink: keep the el of a kept Dolby Vision picture

An unreg that keeps the last frame still turns VD2 off and drops the
enhancement layer. Core1 keeps composing with its EL input enabled,
so a P7 FEL seek or a FEL to FEL join shows black instead of the
last picture.
---
 drivers/media/video_sink/video.c                | 17 +++++++++++++++--
 drivers/media/video_sink/video_func.c           |  5 ++++-
 drivers/media/video_sink/video_hw.c             | 10 ++++++++++
 drivers/media/video_sink/video_hw_s5.c          |  8 ++++++++
 drivers/media/video_sink/video_keeper.c         | 12 ++++++++++++
 drivers/media/video_sink/video_priv.h           |  2 ++
 .../amlogic/media/video_sink/video_keeper.h     |  1 +
 7 files changed, 52 insertions(+), 3 deletions(-)

diff --git a/drivers/media/video_sink/video.c b/drivers/media/video_sink/video.c
--- a/drivers/media/video_sink/video.c
+++ b/drivers/media/video_sink/video.c
@@ -0,6 +0,7 @@
 	bool layer1_used = false;
 	bool layer2_used = false;
 	bool layer3_used = false;
+	bool keep_el = false;
 
 	struct vframe_s *el_vf = NULL;
 	int keeped = 0, ret = 0;
@@ -0,7 +0,10 @@
 		cur_dispbuf[0]->video_angle = 0;
 	}
 
-	if (cur_dispbuf2)
+	if (is_amdv_enable() && cur_dispbuf2 && vd_layer[0].enabled &&
+	    !(blackout[0] | force_blackout))
+		keep_el = true;
+	if (cur_dispbuf2 && !keep_el)
 		need_disable_vd[1] = true;
 	if (is_amdv_enable()) {
 		if (cur_dispbuf2 == &vf_local2) {
@@ -0,7 +0,8 @@
 			vf_local2 = *cur_dispbuf2;
 			el_vf = &vf_local2;
 		}
-		cur_dispbuf2 = NULL;
+		/* the composer of a kept dv frame still needs its el on vd2 */
+		cur_dispbuf2 = keep_el ? &vf_local2 : NULL;
 	}
 	if (trickmode_fffb) {
 		atomic_set(&trickmode_framedone, 0);
@@ -0,6 +0,14 @@
 			video_keeper_hold_put(0, put_vf[i]);
 	}
 #endif
+	if (keep_el && (keeped <= 0 || !video_keeper_el_kept(0))) {
+		spin_lock_irqsave(&lock, flags);
+		if (cur_dispbuf2 == &vf_local2) {
+			cur_dispbuf2 = NULL;
+			need_disable_vd[1] = true;
+		}
+		spin_unlock_irqrestore(&lock, flags);
+	}
 
 	pr_info("%s: vd1 used: %s, vd2 used: %s, vd3 used: %s, keep_ret:%d, black_out:%d, cur_dispbuf:%p\n",
 		__func__,
diff --git a/drivers/media/video_sink/video_func.c b/drivers/media/video_sink/video_func.c
--- a/drivers/media/video_sink/video_func.c
+++ b/drivers/media/video_sink/video_func.c
@@ -0,8 +0,11 @@
 		force_toggle = true;
 	}
 
+	if (cur_dispbuf2 == &vf_local2 && !is_local_vf(vf1))
+		cur_dispbuf2 = NULL;
 	if (is_amdv_enable())
-		vf_with_el = has_enhanced_layer(vf);
+		vf_with_el = has_enhanced_layer(vf) ||
+			     cur_dispbuf2 == &vf_local2;
 
 	/* FIXME: need check the pre seq */
 	if (vf->early_process_fun) {
diff --git a/drivers/media/video_sink/video_hw.c b/drivers/media/video_sink/video_hw.c
--- a/drivers/media/video_sink/video_hw.c
+++ b/drivers/media/video_sink/video_hw.c
@@ -0,6 +0,7 @@
 	}
 }
 
+static void disable_vd2_blend(struct video_layer_s *layer);
 static void disable_vd1_blend(struct video_layer_s *layer)
 {
 	u32 misc_off;
@@ -0,6 +0,15 @@
 				(AMDV_PATH_CTRL + misc_off,
 				3, 0, 2);
 	}
+#ifdef CONFIG_AMLOGIC_MEDIA_ENHANCEMENT_DOLBYVISION
+	/* the el of a kept frame must not reach the vpp once vd2 bypasses core1 */
+	if (cur_dispbuf2 == &vf_local2) {
+		cur_dispbuf2 = NULL;
+		dvel_status = false;
+		disable_vd2_blend(&vd_layer[1]);
+		safe_switch_videolayer(1, false, true);
+	}
+#endif
 
 	/*auto disable sr when video off*/
 	if (!is_meson_txl_cpu() &&
diff --git a/drivers/media/video_sink/video_hw_s5.c b/drivers/media/video_sink/video_hw_s5.c
--- a/drivers/media/video_sink/video_hw_s5.c
+++ b/drivers/media/video_sink/video_hw_s5.c
@@ -0,6 +0,14 @@
 
 	if (!layer)
 		return;
+#ifdef CONFIG_AMLOGIC_MEDIA_ENHANCEMENT_DOLBYVISION
+	if (cur_dispbuf2 == &vf_local2) {
+		cur_dispbuf2 = NULL;
+		dvel_status = false;
+		disable_vd2_blend_s5(&vd_layer[1]);
+		safe_switch_videolayer(1, false, true);
+	}
+#endif
 	if (layer->layer_id == 0 && layer->slice_num > 1) {
 		for (slice = 0; slice < layer->slice_num; slice++)
 			disable_vd1_slice_blend_s5(layer, slice);
diff --git a/drivers/media/video_sink/video_keeper.c b/drivers/media/video_sink/video_keeper.c
--- a/drivers/media/video_sink/video_keeper.c
+++ b/drivers/media/video_sink/video_keeper.c
@@ -0,6 +0,18 @@
 	return ret;
 }
 
+bool video_keeper_el_kept(u8 layer_id)
+{
+	bool ret;
+
+	if (layer_id > 1)
+		return false;
+	mutex_lock(&video_keeper_mutex);
+	ret = keep_el_id[layer_id] > 0;
+	mutex_unlock(&video_keeper_mutex);
+	return ret;
+}
+
 int video_keeper_init(void)
 {
 #ifdef CONFIG_AMLOGIC_MEDIA_GE2D
diff --git a/drivers/media/video_sink/video_priv.h b/drivers/media/video_sink/video_priv.h
--- a/drivers/media/video_sink/video_priv.h
+++ b/drivers/media/video_sink/video_priv.h
@@ -0,6 +0,7 @@
 s32 config_dvel_blend(struct video_layer_s *layer,
 		      struct blend_setting_s *setting,
 		      struct vframe_s *dvel_vf);
+extern bool dvel_status;
 #endif
 
 #ifdef TV_3D_FUNCTION_OPEN
@@ -0,6 +0,7 @@
 extern struct vframe_s vf_local_ext[MAX_VD_LAYER];
 
 extern struct vframe_s *cur_dispbuf[MAX_VD_LAYER];
+extern struct vframe_s *cur_dispbuf2;
 extern bool need_disable_vd[MAX_VD_LAYER];
 extern u32 last_el_status;
 extern u32 video_prop_status;
diff --git a/include/linux/amlogic/media/video_sink/video_keeper.h b/include/linux/amlogic/media/video_sink/video_keeper.h
--- a/include/linux/amlogic/media/video_sink/video_keeper.h
+++ b/include/linux/amlogic/media/video_sink/video_keeper.h
@@ -0,4 +0,5 @@
 	(u8 layer_id,
 	struct vframe_s *cur_dispbuf,
 	struct vframe_s *cur_dispbuf_el);
+bool video_keeper_el_kept(u8 layer_id);
 #endif
