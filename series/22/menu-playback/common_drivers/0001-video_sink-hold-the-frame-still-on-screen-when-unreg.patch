From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 29 Oct 2026 11:53:04 -0500
Subject: [PATCH] video_sink: hold the frame still on screen when unreg keeps
 video

With vsync RDMA the replaced frame is put one vsync late.
Unreg dropped those pending frames and kept only the new one.
The decoder then freed the dropped frame while VD1 still read it.
A garbage band showed at the bottom for one vsync.
---
 drivers/media/video_sink/video.c              | 11 ++-
 drivers/media/video_sink/video_func.c         |  1 +
 drivers/media/video_sink/video_keeper.c       | 81 +++++++++++++++++++
 .../amlogic/media/video_sink/video_keeper.h   |  2 +
 4 files changed, 94 insertions(+), 1 deletion(-)

diff --git a/drivers/media/video_sink/video.c b/drivers/media/video_sink/video.c
--- a/drivers/media/video_sink/video.c
+++ b/drivers/media/video_sink/video.c
@@ -0,6 +0,7 @@
 	int keeped = 0, ret = 0;
 #ifdef CONFIG_AMLOGIC_MEDIA_VSYNC_RDMA
 	int i;
+	struct vframe_s *put_vf[DISPBUF_TO_PUT_MAX];
 #endif
 
 	clear_vsync_2to1_info();
@@ -0,8 +0,10 @@
 	}
 #ifdef CONFIG_AMLOGIC_MEDIA_VSYNC_RDMA
 	dispbuf_to_put_num[0] = 0;
-	for (i = 0; i < DISPBUF_TO_PUT_MAX; i++)
+	for (i = 0; i < DISPBUF_TO_PUT_MAX; i++) {
+		put_vf[i] = dispbuf_to_put[0][i];
 		dispbuf_to_put[0][i] = NULL;
+	}
 	cur_rdma_buf[0] = NULL;
 #endif
 	if (cur_dispbuf[0]) {
@@ -0,6 +0,12 @@
 	if (cur_dispbuf[0])
 		keeped = vf_keep_current
 			(cur_dispbuf[0], el_vf);
+#ifdef CONFIG_AMLOGIC_MEDIA_VSYNC_RDMA
+	if (keeped > 0) {
+		for (i = 0; i < DISPBUF_TO_PUT_MAX; i++)
+			video_keeper_hold_put(0, put_vf[i]);
+	}
+#endif
 
 	pr_info("%s: vd1 used: %s, vd2 used: %s, vd3 used: %s, keep_ret:%d, black_out:%d, cur_dispbuf:%p\n",
 		__func__,
diff --git a/drivers/media/video_sink/video_func.c b/drivers/media/video_sink/video_func.c
--- a/drivers/media/video_sink/video_func.c
+++ b/drivers/media/video_sink/video_func.c
@@ -0,6 +0,7 @@
 			}
 		}
 	}
+	video_keeper_put_notify(layer_id);
 #endif
 }
 
diff --git a/drivers/media/video_sink/video_keeper.c b/drivers/media/video_sink/video_keeper.c
--- a/drivers/media/video_sink/video_keeper.c
+++ b/drivers/media/video_sink/video_keeper.c
@@ -0,6 +0,9 @@
 static int keep_el_id[MAX_VD_LAYER];
 static int keep_el_head_id[MAX_VD_LAYER];
 static int keep_el_dw_id[MAX_VD_LAYER];
+static DEFINE_SPINLOCK(keep_put_lock);
+static int keep_put_id[MAX_VD_LAYER][DISPBUF_TO_PUT_MAX * 3];
+static int keep_put_num[MAX_VD_LAYER];
 
 #define Y_BUFFER_SIZE   0x600000	/* for 1920*1088 */
 #define U_BUFFER_SIZE   0x100000	/* compatible with NV21 */
@@ -0,6 +0,84 @@
 	return;
 }
 
+static void video_keeper_hold_put_mem(u8 layer_id, void *mem_handle,
+				      int type)
+{
+	unsigned long flags;
+	int id;
+	int i;
+
+	if (!mem_handle)
+		return;
+	id = codec_mm_keeper_mask_keep_mem(mem_handle, type);
+	if (id <= 0)
+		return;
+	/* same mem as the kept frame: the keeper did not add a user */
+	if (id == keep_id[layer_id] || id == keep_head_id[layer_id] ||
+	    id == keep_dw_id[layer_id])
+		return;
+	spin_lock_irqsave(&keep_put_lock, flags);
+	for (i = 0; i < keep_put_num[layer_id]; i++)
+		if (keep_put_id[layer_id][i] == id)
+			break;
+	if (i == keep_put_num[layer_id]) {
+		if (i < ARRAY_SIZE(keep_put_id[layer_id])) {
+			keep_put_id[layer_id][i] = id;
+			keep_put_num[layer_id]++;
+		} else {
+			codec_mm_keeper_unmask_keeper(id, 0);
+		}
+	}
+	spin_unlock_irqrestore(&keep_put_lock, flags);
+}
+
+/*
+ * hold a frame whose put was deferred to the next vsync,
+ * vd still scans it until rdma latches the kept frame.
+ */
+void video_keeper_hold_put(u8 layer_id, struct vframe_s *vf)
+{
+	int type = MEM_TYPE_CODEC_MM;
+
+	if (layer_id >= MAX_VD_LAYER || !vf)
+		return;
+	if (vf->source_type == VFRAME_SOURCE_TYPE_HDMI ||
+	    vf->source_type == VFRAME_SOURCE_TYPE_CVBS ||
+	    vf->source_type == VFRAME_SOURCE_TYPE_PPMGR)
+		return;
+	if (IS_DI_PROCESSED(vf->type)) {
+		if (!vf->vf_ext || !(vf->flag & VFRAME_FLAG_DOUBLE_FRAM))
+			return;
+		vf = (struct vframe_s *)vf->vf_ext;
+	}
+	if (vf->type & VIDTYPE_SCATTER)
+		type = MEM_TYPE_CODEC_MM_SCATTER;
+	mutex_lock(&video_keeper_mutex);
+	video_keeper_hold_put_mem(layer_id, vf->mem_handle, type);
+	video_keeper_hold_put_mem(layer_id, vf->mem_head_handle,
+				  MEM_TYPE_CODEC_MM);
+	video_keeper_hold_put_mem(layer_id, vf->mem_dw_handle,
+				  MEM_TYPE_CODEC_MM);
+	mutex_unlock(&video_keeper_mutex);
+}
+
+/*
+ * call in vsync irq.
+ */
+void video_keeper_put_notify(u8 layer_id)
+{
+	unsigned long flags;
+	int i;
+
+	if (layer_id >= MAX_VD_LAYER)
+		return;
+	spin_lock_irqsave(&keep_put_lock, flags);
+	for (i = 0; i < keep_put_num[layer_id]; i++)
+		codec_mm_keeper_unmask_keeper(keep_put_id[layer_id][i], 0);
+	keep_put_num[layer_id] = 0;
+	spin_unlock_irqrestore(&keep_put_lock, flags);
+}
+
 #ifdef CONFIG_AMLOGIC_MEDIA_GE2D
 static unsigned int vf_ge2d_keep_frame_locked(struct vframe_s *ge2d_buf)
 {
diff --git a/include/linux/amlogic/media/video_sink/video_keeper.h b/include/linux/amlogic/media/video_sink/video_keeper.h
--- a/include/linux/amlogic/media/video_sink/video_keeper.h
+++ b/include/linux/amlogic/media/video_sink/video_keeper.h
@@ -0,6 +0,8 @@
 #include <linux/amlogic/media/vfm/vframe.h>
 
 void video_keeper_new_frame_notify(u8 layer_id);
+void video_keeper_hold_put(u8 layer_id, struct vframe_s *vf);
+void video_keeper_put_notify(u8 layer_id);
 void try_free_keep_video(int flags);
 void try_free_keep_vdx(int flags, u8 layer_id);
 int video_keeper_init(void);
