From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 9 Nov 2026 20:15:24 -0600
Subject: [PATCH] libbluray: count preferred BD-J screen configuration
 properties

A PREFERRED or PREFERRED_NOT property scored 0 whether a configuration
had it or not, so it never decided which configuration was best.
---
 ...rred-screen-configuration-properties.patch | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)
 create mode 100644 packages/multimedia/libbluray/patches/libbluray-21-bdj-count-preferred-screen-configuration-properties.patch

diff --git a/packages/multimedia/libbluray/patches/libbluray-21-bdj-count-preferred-screen-configuration-properties.patch b/packages/multimedia/libbluray/patches/libbluray-21-bdj-count-preferred-screen-configuration-properties.patch
new file mode 100644
--- /dev/null
+++ b/packages/multimedia/libbluray/patches/libbluray-21-bdj-count-preferred-screen-configuration-properties.patch
@@ -0,0 +0,26 @@
+From c0aa94fcfe8432eab324db022ec24b660ca5fd47 Mon Sep 17 00:00:00 2001
+From: matthane <matthan.evans@icloud.com>
+Date: Mon, 9 Nov 2026 20:15:18 -0600
+Subject: [PATCH] bdj: count preferred screen configuration properties
+
+A PREFERRED or PREFERRED_NOT property scored 0 whether a configuration
+had it or not, so it never decided which configuration was best.
+---
+ src/libbluray/bdj/java/org/havi/ui/HScreenConfigTemplate.java | 4 ++++
+ 1 file changed, 4 insertions(+)
+
+diff --git a/src/libbluray/bdj/java/org/havi/ui/HScreenConfigTemplate.java b/src/libbluray/bdj/java/org/havi/ui/HScreenConfigTemplate.java
+index adf1641491..9167f9945d 100644
+--- a/src/libbluray/bdj/java/org/havi/ui/HScreenConfigTemplate.java
++++ b/src/libbluray/bdj/java/org/havi/ui/HScreenConfigTemplate.java
+@@ -110,6 +110,10 @@ public abstract class HScreenConfigTemplate {
+             if (supported)
+                 return -1;
+             return 1;
++        } else if (Priority == PREFERRED) {
++            return supported ? 1 : 0;
++        } else if (Priority == PREFERRED_NOT) {
++            return supported ? 0 : 1;
+         }
+         return 0;
+     }
