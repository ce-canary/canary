From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 3 Nov 2026 10:33:03 -0600
Subject: [PATCH] libbluray: avoid UB in shifts

https://code.videolan.org/videolan/libbluray/-/commit/c43cb8be061b3849cf43f55e63787b685bfc7950
---
 ...bluray-06-hdmv_vm-avoid-UB-in-shifts.patch | 29 +++++++++++++++++++
 1 file changed, 29 insertions(+)
 create mode 100644 packages/multimedia/libbluray/patches/libbluray-06-hdmv_vm-avoid-UB-in-shifts.patch

diff --git a/packages/multimedia/libbluray/patches/libbluray-06-hdmv_vm-avoid-UB-in-shifts.patch b/packages/multimedia/libbluray/patches/libbluray-06-hdmv_vm-avoid-UB-in-shifts.patch
new file mode 100644
--- /dev/null
+++ b/packages/multimedia/libbluray/patches/libbluray-06-hdmv_vm-avoid-UB-in-shifts.patch
@@ -0,0 +0,29 @@
+From eb668727cd52edf47e0188bd35c58ada7b7b54a8 Mon Sep 17 00:00:00 2001
+From: Petri Hintukainen <phintuka@gmail.com>
+Date: Tue, 4 Aug 2026 21:32:09 +0300
+Subject: [PATCH] hdmv_vm: avoid UB in shifts
+
+https://code.videolan.org/videolan/libbluray/-/commit/c43cb8be061b3849cf43f55e63787b685bfc7950
+---
+ src/libbluray/hdmv/hdmv_vm.c | 8 ++++----
+ 1 file changed, 4 insertions(+), 4 deletions(-)
+
+diff --git a/src/libbluray/hdmv/hdmv_vm.c b/src/libbluray/hdmv/hdmv_vm.c
+index 7d6aa34462..c2c60be955 100644
+--- a/src/libbluray/hdmv/hdmv_vm.c
++++ b/src/libbluray/hdmv/hdmv_vm.c
+@@ -1169,10 +1169,10 @@ static int _hdmv_step(HDMV_VM *p)
+                         case INSN_AND:    dst &= src;         break;
+                         case INSN_OR:     dst |= src;         break;
+                         case INSN_XOR:    dst ^= src;         break;
+-                        case INSN_BITSET: dst |=  (1 << src); break;
+-                        case INSN_BITCLR: dst &= ~(1 << src); break;
+-                        case INSN_SHL:    dst <<= src;        break;
+-                        case INSN_SHR:    dst >>= src;        break;
++                        case INSN_BITSET: if (src < 32) dst |=  (1 << src); break;
++                        case INSN_BITCLR: if (src < 32) dst &= ~(1 << src); break;
++                        case INSN_SHL:    if (src < 32) dst <<= src; else dst = 0; break;
++                        case INSN_SHR:    if (src < 32) dst >>= src; else dst = 0; break;
+                         default:
+                             BD_DEBUG(DBG_HDMV|DBG_CRIT, "unknown SET option %d in opcode 0x%08x\n",
+                                      insn->set_opt, *(uint32_t*)insn);
