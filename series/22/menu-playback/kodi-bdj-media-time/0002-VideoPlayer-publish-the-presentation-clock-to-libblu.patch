       foreach(symbol bd_presented
                      bd_set_presentation_hold
+                     bd_set_presentation_clock
                      BD_PRESENTED_ALL
                      BD_SEEK_REARMS_PLAYLIST_END
                      BD_PRESENTED_TITLE_END)
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
