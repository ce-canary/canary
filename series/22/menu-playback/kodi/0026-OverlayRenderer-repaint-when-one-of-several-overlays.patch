From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 18 Oct 2026 11:29:16 -0500
Subject: [PATCH] OverlayRenderer: repaint when one of several overlays ends

PrepareOverlays repaints when an overlay arrives, but on a departure only
once the last image or SPU overlay or the last libass output is gone.
When one image overlay leaves while another stays on screen, the area is
never repainted, and a BD-J logo stays on the GUI plane until a new image
or the GUI draws over it.
---
 .../VideoRenderers/OverlayRenderer.cpp        | 22 +++++++++----------
 .../VideoRenderers/OverlayRenderer.h          | 12 +++++-----
 2 files changed, 15 insertions(+), 19 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
@@ -0,8 +0,7 @@
   UpdateSubtitlePosition(resolution);
 
   bool doMarkDirty = false;
-  bool hasImageSpu = false;
-  bool hasLibassImages = false;
+  int shownCount = 0;
   for (auto& e : m_buffers[idx])
   {
     // Clear last frame's cached output; libass may have invalidated the
@@ -0,10 +0,10 @@
     // so finding one means it is on screen now. m_textureid == 0 is the
     // "new arrival" signal (also true every frame for animated PGS where
     // each frame is a fresh CDVDOverlay). Disappearance is caught after
-    // the loop by the hasImageSpu vs m_prevHadImageSpu check.
+    // the loop by the shownCount vs m_prevShownCount check.
     if (o.IsOverlayType(DVDOVERLAY_TYPE_IMAGE) || o.IsOverlayType(DVDOVERLAY_TYPE_SPU))
     {
-      hasImageSpu = true;
+      ++shownCount;
       if (o.m_textureid == 0)
         doMarkDirty = true;
       continue;
@@ -0,7 +0,7 @@
     e.renderedImages =
         ovAss.GetLibassHandler()->RenderImage(e.pts, rOpts, m_overlayStyle, &currentChange);
     if (e.renderedImages)
-      hasLibassImages = true;
+      ++shownCount;
     if (currentChange > 0)
     {
       // Persist on the overlay so a skipped GUI render does not drop the change.
@@ -0,15 +0,14 @@
     }
   }
 
-  // PGS/DVB/SPU disappearance: arrival is caught by m_textureid==0 in
-  // the loop above. Without this, a PGS subtitle ending leaves its
-  // cached bitmap on the GUI plane until something else dirties.
-  // Likewise libass output once its overlay is no longer added.
-  if (hasImageSpu != m_prevHadImageSpu || hasLibassImages != m_prevHadLibassImages)
+  // Disappearance: arrival is caught by m_textureid==0 and libass
+  // detect_change in the loop above. Without this, a subtitle ending leaves
+  // its cached output on the GUI plane until something else dirties, also
+  // when another one stays on screen.
+  if (shownCount != m_prevShownCount)
     doMarkDirty = true;
 
-  m_prevHadImageSpu = hasImageSpu;
-  m_prevHadLibassImages = hasLibassImages;
+  m_prevShownCount = shownCount;
 
   if (doMarkDirty)
     MarkDirty();
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
@@ -0,12 +0,10 @@
 
     std::shared_ptr<struct KODI::SUBTITLES::STYLE::style> m_overlayStyle;
     std::atomic<bool> m_isSettingsChanged{false};
-    // Whether last frame had any image/SPU overlay. Used by PrepareOverlays
-    // to detect arrival/disappearance transitions (image/SPU have no
-    // per-frame change signal of their own, unlike libass detect_change).
-    bool m_prevHadImageSpu{false};
-    // Whether last frame had libass output. detect_change cannot report an
-    // overlay that is no longer added at all, e.g. once subtitles are hidden.
-    bool m_prevHadLibassImages{false};
+    // How many overlays had output on screen last frame. Used by
+    // PrepareOverlays to detect disappearance: image/SPU have no per-frame
+    // change signal, and libass detect_change cannot report an overlay that
+    // is no longer added at all.
+    int m_prevShownCount{0};
   };
 }
