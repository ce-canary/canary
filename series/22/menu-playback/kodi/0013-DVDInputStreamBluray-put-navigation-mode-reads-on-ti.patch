From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 17 Oct 2026 09:21:04 -0500
Subject: [PATCH] DVDInputStreamBluray: put navigation-mode reads on title time

In navigation mode the input stream keeps no clip spans, so packets
carry raw clip time. Titles probed in full show the clip clock and the
others restart at every demuxer reopen, so time cannot run on across
a join.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 23 +++++++++++++------
 .../DVDInputStreams/DVDInputStreamBluray.h    |  4 ++--
 2 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,8 +0,10 @@
     {
       m_clip = &m_titleInfo->clips[m_event.param];
       UpdateClipInfo(m_event.param);
-      OpenClipSpan();
     }
+    else
+      m_clip = nullptr;
+    OpenClipSpan();
     uint64_t clip_start, clip_in, bytepos;
     ret = bd_get_clip_infos(m_bd, m_event.param, &clip_start, &clip_in, &bytepos, nullptr);
     if (ret)
@@ -0,7 +0,16 @@
   m_bMVCPlayback = false;
 }
 
+// counted after the events of the read have opened their clip spans
 int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
+{
+  const int result = ReadData(buf, buf_size);
+  if (result > 0)
+    m_readPos += result;
+  return result;
+}
+
+int CDVDInputStreamBluray::ReadData(uint8_t* buf, int buf_size)
 {
   int result = 0;
   if (m_navmode && !m_clipStart.empty() && !m_clipStartHeld && m_clipStartOffset == 0)
@@ -0,7 +0,6 @@
     result = std::min(buf_size, static_cast<int>(m_clipStart.size() - m_clipStartOffset));
     std::copy_n(m_clipStart.data() + m_clipStartOffset, result, buf);
     m_clipStartOffset += result;
-    m_readPos += result;
     if (m_clipStartOffset == m_clipStart.size())
       m_clipStart.clear();
     return result;
@@ -0,8 +0,6 @@
       HoldClipStart(buf, result);
       return 0;
     }
-    if (result > 0)
-      m_readPos += result;
   }
   return result;
 }
@@ -0,9 +0,6 @@
 // the bytes of the next Read come from m_clip, or carry no clip time without one
 void CDVDInputStreamBluray::OpenClipSpan()
 {
-  if (m_navmode)
-    return;
-
   ClipSpan span{m_readPos};
   if (m_clip)
     span.time = ClipTime{m_clip->in_time, m_clip->start_time};
@@ -0,6 +0,10 @@
 
   m_hold = HOLD_DATA;
   m_nextClipKnown = clipKnown && m_clip;
+  // the next demuxer reads on from m_readPos, so no lookup reaches the spans before its first one
+  const auto span = std::ranges::upper_bound(m_clipSpans, m_readPos, {}, &ClipSpan::readPos);
+  if (span != m_clipSpans.begin())
+    m_clipSpans.erase(m_clipSpans.begin(), std::prev(span));
   return NEXTSTREAM_OPEN;
 }
 
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -0,8 +0,7 @@
   /*!
    * \brief Get the in time and start time (90 kHz) of the clip a byte was read from.
    * \param readPos The position of the byte in the bytes Read returned since Open
-   * \return The clip time, or nothing without a clip, in navigation mode and on a playlist with
-   *         an MVC extension
+   * \return The clip time, or nothing without a clip and on a playlist with an MVC extension
    */
   std::optional<ClipTime> GetClipTime(uint64_t readPos) const;
 
@@ -0,6 +0,7 @@
     void SetupPlayerSettings();
     void FreeTitleInfo();
     void FreeClipInfo();
+    int ReadData(uint8_t* buf, int buf_size);
     void HoldClipStart(const uint8_t* buf, int size);
     void DropClipStartOnJump();
 
