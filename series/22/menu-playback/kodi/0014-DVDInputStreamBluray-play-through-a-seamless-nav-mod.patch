From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 17 Oct 2026 09:22:04 -0500
Subject: [PATCH] DVDInputStreamBluray: play through a seamless nav-mode play
 item

In navigation mode every play item start holds the read and reopens
the demuxer, also where the disc joins the items seamlessly. The player
drains and restarts at each such join and shows a black gap.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 28 +++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,6 +0,13 @@
   m_dispTimeBeforeRead = static_cast<int>((bd_tell_time(m_bd) / 90));
   if(m_navmode)
   {
+    // the running demuxer plays on into the next play item of the title, a discontinuity holds it
+    const auto joinsInLine = [this, &result]
+    {
+      return result > 0 && !m_hasMVCExtension && m_titleInfo && m_clip &&
+             m_event.param < m_titleInfo->clip_count &&
+             m_event.param == static_cast<uint32_t>(m_clip - m_titleInfo->clips) + 1;
+    };
     do {
 
       if (m_hold == HOLD_HELD)
@@ -0,16 +0,21 @@
 
       /* Check for holding events */
       switch(m_event.event) {
+        case BD_EVENT_PLAYITEM:
+          if (joinsInLine())
+            break;
+          [[fallthrough]];
         case BD_EVENT_SEEK:
         case BD_EVENT_TITLE:
         case BD_EVENT_ANGLE:
         case BD_EVENT_PLAYLIST:
-        case BD_EVENT_PLAYITEM:
+        case BD_EVENT_DISCONTINUITY:
           if(m_hold != HOLD_DATA)
           {
             m_hold = HOLD_HELD;
             // the read starts the new play item, which the demuxer being closed must not consume
-            if (m_event.event == BD_EVENT_PLAYITEM && result > 0 && !m_hasMVCExtension)
+            if ((m_event.event == BD_EVENT_PLAYITEM || m_event.event == BD_EVENT_DISCONTINUITY) &&
+                result > 0 && !m_hasMVCExtension)
             {
               HoldClipStart(buf, result);
               return 0;
@@ -0,6 +0,7 @@
       }
 
       const bool queued = m_event.event != BD_EVENT_NONE && m_hold != HOLD_DATA;
+      bool playItemInLine = m_event.event == BD_EVENT_PLAYITEM && queued;
       if(result > 0)
         m_hold = HOLD_NONE;
 
@@ -0,6 +0,11 @@
       {
         switch(m_event.event) {
           case BD_EVENT_PLAYITEM:
+            if (joinsInLine())
+            {
+              playItemInLine = true;
+              break;
+            }
             if(!m_hasMVCExtension)
             {
               m_hold = HOLD_HELD;
@@ -0,7 +0,13 @@
           case BD_EVENT_ANGLE:
           case BD_EVENT_PLAYLIST:
           case BD_EVENT_STILL_TIME:
+          case BD_EVENT_DISCONTINUITY:
             m_hold = HOLD_HELD;
+            if (playItemInLine || (m_event.event == BD_EVENT_DISCONTINUITY && !m_hasMVCExtension))
+            {
+              HoldClipStart(buf, result);
+              return 0;
+            }
             return result;
 
           default:
