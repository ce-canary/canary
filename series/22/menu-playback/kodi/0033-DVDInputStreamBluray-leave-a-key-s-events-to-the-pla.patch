From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 29 Oct 2026 23:51:00 -0500
Subject: [PATCH] DVDInputStreamBluray: leave a key's events to the player
 thread

UserInput processes the queued disc events after the key. During a
read held at the end of an item, that takes the held event outside the
next stream's own event handling, so the next item loses what the disc
program decided at the join.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp           | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,20 +0,12 @@
   if (vk == BD_VK_ENTER || vk == BD_VK_POPUP || vk == BD_VK_ROOT_MENU ||
       (vk >= BD_VK_0 && vk <= BD_VK_9))
     m_menuInput = true;
+  // the events of the key reach the player thread through its next read
   int ret = bd_user_input(m_bd, -1, vk);
   if (ret < 0)
   {
     CLog::Log(LOGDEBUG, "CDVDInputStreamBluray::UserInput - user input failed");
   }
-  else
-  {
-    // an event the input stream still holds for the player came first
-    if (m_event.event != BD_EVENT_NONE)
-      ProcessEvent();
-    /* process all queued up events */
-    while (bd_get_event(m_bd, &m_event))
-      ProcessEvent();
-  }
 }
 
 bool CDVDInputStreamBluray::MouseMove(const CPoint &point)
