From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 28 Oct 2026 22:07:41 -0500
Subject: [PATCH] DVDInputStreamBluray: leave a title once its last picture
 shows

The title info was freed at the read that reached the end of a title,
so the last seconds of every title had no total time or chapters. The
disc program also left an HDMV title at that read, under pictures
still queued in the player.
---
 cmake/modules/FindBluray.cmake                |   4 +-
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 120 ++++++++++++++----
 .../DVDInputStreams/DVDInputStreamBluray.h    |  10 ++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        |  55 +++++++-
 xbmc/cores/VideoPlayer/VideoPlayer.h          |   3 +
 5 files changed, 165 insertions(+), 27 deletions(-)

diff --git a/cmake/modules/FindBluray.cmake b/cmake/modules/FindBluray.cmake
--- a/cmake/modules/FindBluray.cmake
+++ b/cmake/modules/FindBluray.cmake
@@ -0,7 +0,9 @@
       set(CMAKE_REQUIRED_LIBRARIES ${${${CMAKE_FIND_PACKAGE_NAME}_SEARCH_NAME}_LINK_LIBRARIES})
       foreach(symbol bd_presented
                      bd_set_presentation_hold
-                     BD_PRESENTED_ALL)
+                     BD_PRESENTED_ALL
+                     BD_SEEK_REARMS_PLAYLIST_END
+                     BD_PRESENTED_TITLE_END)
         check_symbol_exists(${symbol} libbluray/bluray.h LIBBLURAY_HAS_${symbol})
         if(NOT LIBBLURAY_HAS_${symbol})
           message(FATAL_ERROR "libbluray lacks ${symbol} of the CoreELEC presentation hold API")
