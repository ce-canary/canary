From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 29 Oct 2026 12:45:48 -0500
Subject: [PATCH] DVDInputStreamBluray: report the clip of the next item when
 known

The player can tell the format of the next item from its clip info
only when the events that opened the item named its play item. A title
start leaves m_clip at the old item, and a playlist change leaves it
at none until its play item event arrives.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 40 ++++++++++++++++++-
 .../DVDInputStreams/DVDInputStreamBluray.h    |  4 ++
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,23 +0,59 @@
 
 CDVDInputStream::ENextStream CDVDInputStreamBluray::NextStream()
 {
+  m_nextClipKnown = false;
   if(!m_navmode || m_hold == HOLD_EXIT || m_hold == HOLD_ERROR)
     return NEXTSTREAM_NONE;
 
+  // m_clip names the next item after a play item event, or after a seek within it
+  bool clipKnown = false;
+  bool clipLeft = false;
+  const auto processEvent = [this, &clipKnown, &clipLeft]
+  {
+    switch (m_event.event)
+    {
+      case BD_EVENT_PLAYITEM:
+        clipKnown = true;
+        break;
+      case BD_EVENT_SEEK:
+      case BD_EVENT_DISCONTINUITY:
+        clipKnown = clipKnown || !clipLeft;
+        break;
+      case BD_EVENT_TITLE:
+      case BD_EVENT_PLAYLIST:
+      case BD_EVENT_ANGLE:
+      case BD_EVENT_END_OF_TITLE:
+        clipKnown = false;
+        clipLeft = true;
+        break;
+      default:
+        break;
+    }
+    ProcessEvent();
+  };
+
   /* process any current event */
-  ProcessEvent();
+  processEvent();
 
   /* process all queued up events */
   while(bd_get_event(m_bd, &m_event))
-    ProcessEvent();
+    processEvent();
 
   if(m_hold == HOLD_STILL)
     return NEXTSTREAM_RETRY;
 
   m_hold = HOLD_DATA;
+  m_nextClipKnown = clipKnown && m_clip;
   return NEXTSTREAM_OPEN;
 }
 
+const BLURAY_CLIP_INFO* CDVDInputStreamBluray::GetNextItemClip() const
+{
+  if (!m_nextClipKnown || m_bMVCPlayback || m_hasMVCExtension)
+    return nullptr;
+  return m_clip;
+}
+
 void CDVDInputStreamBluray::UserInput(bd_vk_key_e vk)
 {
   if(m_bd == nullptr || !m_navmode)
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -0,6 +0,9 @@
   void ReleaseClipStart() { m_clipStartHeld = false; }
   bool IsClipStartHeld() const { return !m_navmode && m_clipStartHeld && !m_clipStart.empty(); }
 
+  //! the clip the item opened by the last NextStream starts with, when its events named it
+  const BLURAY_CLIP_INFO* GetNextItemClip() const;
+
   void OverlayCallback(const BD_OVERLAY * const);
 #ifdef HAVE_LIBBLURAY_BDJ
   void OverlayCallbackARGB(const struct bd_argb_overlay_s * const);
@@ -0,6 +0,7 @@
     uint64_t m_readPos{0};
     std::vector<ClipSpan> m_clipSpans;
     bool m_hasMVCExtension{false};
+    bool m_nextClipKnown{false};
     std::vector<uint8_t> m_clipStart;
     size_t m_clipStartOffset{0};
     bool m_clipStartHeld{false};
