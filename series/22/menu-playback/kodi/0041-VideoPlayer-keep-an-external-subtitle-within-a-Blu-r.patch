 .../DVDInputStreams/DVDInputStreamBluray.h    | 11 ++++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 35 ++++++++++++++++++-
 xbmc/cores/VideoPlayer/VideoPlayer.h          |  1 +
 4 files changed, 62 insertions(+), 1 deletion(-)

