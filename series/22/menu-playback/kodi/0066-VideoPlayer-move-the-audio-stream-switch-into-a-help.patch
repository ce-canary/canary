From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 31 Oct 2026 00:28:03 -0500
Subject: [PATCH] VideoPlayer: move the audio stream switch into a helper

---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 26 ++++++++++++++++----------
 xbmc/cores/VideoPlayer/VideoPlayer.h   |  1 +
 2 files changed, 17 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -0,17 +0,8 @@
           if (!SelectDiscStream(st))
             continue;
 #endif
-          CloseStream(m_CurrentAudio, false);
-          OpenStream(m_CurrentAudio, st.demuxerId, st.id, st.source);
+          SwitchAudioStream(st.demuxerId, st.id, st.source);
           AdaptForcedSubtitles();
-
-          CDVDMsgPlayerSeek::CMode mode;
-          mode.time = (int)GetUpdatedTime();
-          mode.backward = true;
-          mode.accurate = true;
-          mode.trickplay = true;
-          mode.sync = true;
-          m_messenger.Put(std::make_shared<CDVDMsgPlayerSeek>(mode));
         }
       }
     }
@@ -0,6 +0,21 @@
   return true;
 }
 
+// drops the queued audio and plays the new stream from the presented time
+void CVideoPlayer::SwitchAudioStream(int64_t demuxerId, int iStream, int source)
+{
+  CloseStream(m_CurrentAudio, false);
+  OpenStream(m_CurrentAudio, demuxerId, iStream, source);
+
+  CDVDMsgPlayerSeek::CMode mode;
+  mode.time = (int)GetUpdatedTime();
+  mode.backward = true;
+  mode.accurate = true;
+  mode.trickplay = true;
+  mode.sync = true;
+  m_messenger.Put(std::make_shared<CDVDMsgPlayerSeek>(mode));
+}
+
 void CVideoPlayer::FlushBuffers(double pts, bool accurate, bool sync)
 {
   m_syncStartPtsWait.reset();
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -0,6 +0,7 @@
   */
   void AdaptForcedSubtitles();
   bool CloseStream(CCurrentStream& current, bool bWaitForBuffers);
+  void SwitchAudioStream(int64_t demuxerId, int iStream, int source);
 
   bool CheckIsCurrent(const CCurrentStream& current, CDemuxStream* stream, DemuxPacket* pkg);
   void ProcessPacket(CDemuxStream* pStream, DemuxPacket* pPacket);
