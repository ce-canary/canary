From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 28 Oct 2026 02:46:09 -0500
Subject: [PATCH] DVDInputStreamBluray: apply picks made while the read is held

In navigation mode the read holds the next play item for most of the
item that plays out. An audio or subtitle pick or a subtitle toggle
made then never reaches libbluray. The disc keeps its old streams and
display flag, and the next playlist start turns the pick back.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 48 +++++++++++++++++--
 .../DVDInputStreams/DVDInputStreamBluray.h    |  6 ++-
 2 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,6 +0,7 @@
 #include <limits>
 #include <memory>
 #include <string>
+#include <utility>
 #include <vector>
 
 #include <libbluray/bluray-version.h>
@@ -0,6 +0,8 @@
     if (m_pMVCDemux == NULL)
       OpenNextStream();
   }
+
+  SelectPendingStreams();
 }
 
 void CDVDInputStreamBluray::DisableExtention()
@@ -0,10 +0,31 @@
          m_event.event == BD_EVENT_NONE;
 }
 
+// a pick or toggle while the read is held is written once the read resumes, for the play item
+// libbluray then plays
+void CDVDInputStreamBluray::SelectPendingStreams()
+{
+  if ((!m_audioPidPending && !m_pgPidPending && !m_pgVisiblePending) || !CanSelectStream())
+    return;
+
+  if (const auto pid = std::exchange(m_audioPidPending, std::nullopt))
+    SetActiveAudioStream(*pid);
+  if (const auto pid = std::exchange(m_pgPidPending, std::nullopt))
+    SetActiveSubtitleStream(*pid, m_pgVisiblePending.value_or(m_pgEnabled));
+  else if (m_pgVisiblePending)
+    SetSubtitleVisible(*m_pgVisiblePending);
+}
+
 bool CDVDInputStreamBluray::SetActiveAudioStream(int pid)
 {
-  if (!CanSelectStream())
+  if (!m_bd || !m_navmode)
     return false;
+  if (!CanSelectStream())
+  {
+    m_audioPidPending = pid;
+    return true;
+  }
+  m_audioPidPending.reset();
 
   const unsigned int number{stream_number(pid, m_clip->audio_streams, m_clip->audio_stream_count)};
   if (number == 0)
@@ -0,8 +0,16 @@
 
 bool CDVDInputStreamBluray::SetActiveSubtitleStream(int pid, bool visible)
 {
-  if (!CanSelectStream())
+  if (!m_bd || !m_navmode)
     return false;
+  if (!CanSelectStream())
+  {
+    m_pgPidPending = pid;
+    m_pgVisiblePending = visible;
+    return true;
+  }
+  m_pgPidPending.reset();
+  m_pgVisiblePending.reset();
 
   const unsigned int number{stream_number(pid, m_clip->pg_streams, m_clip->pg_stream_count)};
   if (number == 0)
@@ -0,7 +0,16 @@
 
 void CDVDInputStreamBluray::SetSubtitleVisible(bool visible)
 {
-  if (!CanSelectStream() || !CanToggleSubtitle() || m_pgStreamNumber == 0 ||
+  if (!m_bd || !m_navmode)
+    return;
+  if (!CanSelectStream())
+  {
+    m_pgVisiblePending = visible;
+    return;
+  }
+  m_pgVisiblePending.reset();
+
+  if (!CanToggleSubtitle() || m_pgStreamNumber == 0 ||
       m_pgStreamNumber > static_cast<uint32_t>(m_clip->pg_stream_count))
     return;
 
@@ -0,6 +0,7 @@
   m_playedItemEnd =
       !m_presentedLeft && m_nextClipKnown ? static_cast<int64_t>(m_clip->start_time) - 1 : -1;
   m_presentedLeft = false;
+  SelectPendingStreams();
   // the next demuxer reads on from m_readPos, so no lookup reaches the spans before its first one
   const auto span = std::ranges::upper_bound(m_clipSpans, m_readPos, {}, &ClipSpan::readPos);
   if (span != m_clipSpans.begin())
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -0,7 +0,7 @@
    *        disc program and later play items keep it.
    * \param pid The packet identifier of the stream
    * \param visible Whether the subtitle stream is shown
-   * \return True if the play item presents the stream, false otherwise or while an event is held
+   * \return True if the play item presents the stream or the read is held, false otherwise
    */
   bool SetActiveAudioStream(int pid);
   bool SetActiveSubtitleStream(int pid, bool visible);
@@ -0,6 +0,7 @@
      */
     bool GetClipStreamLanguage(int pid, std::string& language) const;
     bool CanSelectStream() const;
+    void SelectPendingStreams();
     void OpenClipSpan();
 
     std::unique_ptr<CDVDInputStreamFile> m_pstream;
@@ -0,4 +0,7 @@
     uint32_t m_pgStreamNumber{0};
     uint32_t m_uoMask{0};
     bool m_pgEnabled{false};
+    std::optional<int> m_audioPidPending;
+    std::optional<int> m_pgPidPending;
+    std::optional<bool> m_pgVisiblePending;
 };
