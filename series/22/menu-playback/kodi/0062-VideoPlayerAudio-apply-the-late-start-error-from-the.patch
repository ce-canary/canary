From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 28 Oct 2026 15:24:27 -0500
Subject: [PATCH] VideoPlayerAudio: apply the late start error from the engine

ActiveAE leaves audio starting up to 500 ms late to the player's clock.
It reports the error once and drops its next average. The player cannot
tell that report from a steady error and moves its clock only above its
limit, 50 ms by default, so audio starting less late stays out of sync
until a seek.
---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp |  2 ++
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h   |  1 +
 xbmc/cores/AudioEngine/Interfaces/AEStream.h         |  2 ++
 xbmc/cores/VideoPlayer/AudioSinkAE.cpp               | 11 +++++++++++
 xbmc/cores/VideoPlayer/AudioSinkAE.h                 |  2 ++
 xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp          |  4 +++-
 6 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -0,6 +0,7 @@
     {
       float delay = 0;
       str.m_syncState = stream->m_syncState;
+      str.m_lateStartHandedOver = stream->m_lateStartHandedOver;
       str.m_syncError = stream->m_syncError.GetLastError(str.m_errorTime);
       if (stream->m_processingBuffers)
       {
@@ -0,6 +0,7 @@
       info.error = str.m_syncError;
       info.errortime = str.m_errorTime;
       info.state = str.m_syncState;
+      info.lateStartHandedOver = str.m_lateStartHandedOver;
       info.rr = str.m_resampleRatio;
       return;
     }
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -0,6 +0,7 @@
     double m_syncError;
     unsigned int m_errorTime;
     CAESyncInfo::AESyncState m_syncState;
+    bool m_lateStartHandedOver{false};
   };
   std::vector<StreamStats> m_streamStats;
 };
diff --git a/xbmc/cores/AudioEngine/Interfaces/AEStream.h b/xbmc/cores/AudioEngine/Interfaces/AEStream.h
--- a/xbmc/cores/AudioEngine/Interfaces/AEStream.h
+++ b/xbmc/cores/AudioEngine/Interfaces/AEStream.h
@@ -0,6 +0,8 @@
     SYNC_ADJUST
   };
   AESyncState state;
+  //! The error is a late start the engine left to the player's clock
+  bool lateStartHandedOver{false};
 };
 
 /**
diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
@@ -0,6 +0,7 @@
     unsigned int newTime = info.errortime;
     if (newTime != m_syncErrorTime)
     {
+      m_startSyncError = info.lateStartHandedOver;
       m_syncErrorTime = info.errortime;
       m_syncError = info.error / 1000 * DVD_TIME_BASE;
       m_resampleRatio = info.rr;
@@ -0,6 +0,7 @@
   {
     m_syncErrorTime = 0;
     m_syncError = 0.0;
+    m_startSyncError = false;
   }
 
   // Use wall-clock deadline independent of playback speed (fixes dimensional error
@@ -0,6 +0,7 @@
     m_pAudioStream->Pause();
   CLog::Log(LOGDEBUG,"CDVDAudio::Pause - pausing audio stream");
   m_playingPts = DVD_NOPTS_VALUE;
+  m_startSyncError = false;
 }
 
 void CAudioSinkAE::Resume()
@@ -0,6 +0,7 @@
   m_playingPts = DVD_NOPTS_VALUE;
   m_syncError = 0.0;
   m_syncErrorTime = 0;
+  m_startSyncError = false;
 }
 
 void CAudioSinkAE::AbortAddPackets()
@@ -0,6 +0,13 @@
   m_syncError += correction;
 }
 
+bool CAudioSinkAE::TakeStartSyncError()
+{
+  const bool startSyncError{m_startSyncError};
+  m_startSyncError = false;
+  return startSyncError;
+}
+
 double CAudioSinkAE::GetResampleRatio()
 {
   return m_resampleRatio;
