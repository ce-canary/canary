From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 17 Oct 2026 13:52:13 -0500
Subject: [PATCH] VideoPlayerVideo: return to the message loop while a drain
 waits

A video drain loops on the decoder until it reports no more output.
The Amlogic decoder reports no picture while the renderer still holds
its frames. The loop then spins on one core and reads no messages, so
a pause during a drain spins until playback resumes. The stillframe
squeeze spins the same way before the clock starts.
---
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp | 35 +++++++++++++++++++--
 xbmc/cores/VideoPlayer/VideoPlayerVideo.h   |  1 +
 2 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -0,6 +0,7 @@
   bool bRequestDrop = false;
   int iDropDirective;
   bool onlyPrioMsgs = false;
+  bool drainWait = false;
 
   m_vfmt.clear();
   int vfmtCheckCount = 0;
@@ -0,6 +0,13 @@
     if (m_paused)
       iPriority = 1;
 
+    if (drainWait)
+    {
+      iPriority = 1;
+      timeout = std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::duration<double, std::micro>(frametime));
+    }
+
     if (onlyPrioMsgs)
     {
       iPriority = 1;
@@ -0,7 +0,9 @@
     std::shared_ptr<CDVDMsg> pMsg;
     MsgQueueReturnCode ret = GetMessage(pMsg, timeout, iPriority);
 
+    const bool drainPending = drainWait;
     onlyPrioMsgs = false;
+    drainWait = false;
 
     if (MSGQ_IS_ERROR(ret))
     {
@@ -0,8 +0,10 @@
           continue;
         }
       }
-      // don't ask for a new frame if we can't deliver it to renderer
-      else if ((m_speed != DVD_PLAYSPEED_PAUSE ||
+      // don't ask for a new frame if we can't deliver it to renderer; right after a drain waits,
+      // its pictures are the drain handler's, which releases the dropped ones
+      else if (!drainPending &&
+               (m_speed != DVD_PLAYSPEED_PAUSE ||
                 m_processInfo.IsFrameAdvance() ||
                 m_syncState != IDVDStreamPlayer::SYNC_INSYNC) && !m_paused)
       {
@@ -0,6 +0,14 @@
           m_pVideoCodec->SetCodecControl(DVD_CODEC_CTRL_DRAIN);
           if (!ProcessDecoderOutput(frametime, pts))
             break;
+
+          // the decoder holds pictures it cannot output yet, the drain handler waits for them
+          if (m_noPicture)
+          {
+            SendMessageBack(std::make_shared<CDVDMsg>(CDVDMsg::VIDEO_DRAIN));
+            drainWait = true;
+            break;
+          }
         }
 
         CLog::Log(LOGDEBUG, "CVideoPlayerVideo - Stillframe detected, switching to forced {:f} fps",
@@ -0,7 +0,7 @@
       }
 
       // Waiting timed out, output last picture
-      if (m_picture.videoBuffer)
+      if (m_picture.videoBuffer && !drainWait)
       {
         m_picture.pts = pts;
         m_outputSate = OutputPicture(&m_picture);
@@ -0,6 +0,14 @@
           m_picture.videoBuffer->Release();
           m_picture.videoBuffer = nullptr;
         }
+
+        // the decoder holds frames it cannot output yet, serve messages before retrying
+        if (m_noPicture)
+        {
+          SendMessageBack(pMsg);
+          drainWait = true;
+          break;
+        }
       }
     }
     else if (pMsg->IsType(CDVDMsg::GENERAL_PAUSE))
@@ -0,6 +0,7 @@
 bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
 {
   CDVDVideoCodec::VCReturn decoderState = m_pVideoCodec->GetPicture(&m_picture);
+  m_noPicture = decoderState == CDVDVideoCodec::VC_NONE;
 
   if (decoderState == CDVDVideoCodec::VC_BUFFER)
   {
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.h b/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
@@ -0,4 +0,5 @@
   VideoPicture m_picture;
 
   EOutputState m_outputSate{OUTPUT_NORMAL};
+  bool m_noPicture{false};
 };
