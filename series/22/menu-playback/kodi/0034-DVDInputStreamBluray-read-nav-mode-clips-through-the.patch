From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 27 Oct 2026 17:34:40 -0500
Subject: [PATCH] DVDInputStreamBluray: read nav-mode clips through the file
 cache

In navigation mode libbluray reads the clips through an uncached file
on the player thread. Over a network share every refill of the file's
buffer waits for the network, so the read barely keeps up with the
disc rate. It has no reserve left when a seamless join or a network
stall comes.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 25 ++++++++++++++++++-
 .../DVDInputStreams/DVDInputStreamBluray.h    |  3 +++
 xbmc/filesystem/BlurayCallback.cpp            |  7 +++++-
 xbmc/filesystem/BlurayCallback.h              |  1 +
 4 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,6 +0,16 @@
   return blurayStream->ReadBlocks(reinterpret_cast<uint8_t*>(buf), lba, num_blocks);
 }
 
+static BD_DIR_H* dir_open(void* handle, const char* rel_path)
+{
+  return static_cast<CDVDInputStreamBluray*>(handle)->OpenDir(rel_path);
+}
+
+static BD_FILE_H* file_open(void* handle, const char* rel_path)
+{
+  return static_cast<CDVDInputStreamBluray*>(handle)->OpenFile(rel_path);
+}
+
 static void bluray_overlay_cb(void *this_gen, const BD_OVERLAY * ov)
 {
   static_cast<CDVDInputStreamBluray*>(this_gen)->OverlayCallback(ov);
@@ -0,7 +0,7 @@
     m_udfMount.emplace(root);
 #endif
 
-    if (!bd_open_files(m_bd, &m_rootPath, CBlurayCallback::dir_open, CBlurayCallback::file_open))
+    if (!bd_open_files(m_bd, this, dir_open, file_open))
     {
       CLog::Log(LOGERROR, "CDVDInputStreamBluray::Open - failed to open {} in files mode",
                 CURL::GetRedacted(root));
@@ -0,6 +0,19 @@
   return result;
 }
 
+BD_DIR_H* CDVDInputStreamBluray::OpenDir(const char* relPath)
+{
+  return CBlurayCallback::dir_open(&m_rootPath, relPath);
+}
+
+// libbluray reads navigation-mode clips on the player thread, the file cache reads on ahead of it
+BD_FILE_H* CDVDInputStreamBluray::OpenFile(const char* relPath)
+{
+  const unsigned int flags =
+      m_navmode && URIUtils::HasExtension(relPath, ".m2ts|.ssif") ? XFILE::READ_AUDIO_VIDEO : 0;
+  return CBlurayCallback::file_open(&m_rootPath, relPath, flags);
+}
+
 static uint8_t  clamp(double v)
 {
   return (v) > 255.0 ? 255 : ((v) < 0.0 ? 0 : static_cast<uint32_t>((v + 0.5)));
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -0,6 +0,7 @@
 {
 #include <libbluray/bluray.h>
 #include <libbluray/bluray-version.h>
+#include <libbluray/filesystem.h>
 #include <libbluray/keys.h>
 #include <libbluray/overlay.h>
 #include <libbluray/player_settings.h>
@@ -0,6 +0,8 @@
   void Close() override;
   int Read(uint8_t* buf, int buf_size) override;
   int ReadBlocks(uint8_t* buf, int lba, int num_blocks);
+  BD_DIR_H* OpenDir(const char* relPath);
+  BD_FILE_H* OpenFile(const char* relPath);
   int64_t Seek(int64_t offset, int whence) override;
   void Abort() override;
   bool IsEOF() override;
diff --git a/xbmc/filesystem/BlurayCallback.cpp b/xbmc/filesystem/BlurayCallback.cpp
--- a/xbmc/filesystem/BlurayCallback.cpp
+++ b/xbmc/filesystem/BlurayCallback.cpp
@@ -0,6 +0,11 @@
 }
 
 BD_FILE_H * CBlurayCallback::file_open(void *handle, const char *rel_path)
+{
+  return file_open(handle, rel_path, 0);
+}
+
+BD_FILE_H* CBlurayCallback::file_open(void* handle, const char* rel_path, unsigned int flags)
 {
   std::string strRelPath(rel_path);
   std::string* strBasePath = reinterpret_cast<std::string*>(handle);
@@ -0,7 +0,7 @@
   file->eof = file_eof;
 
   CFile* fp = new CFile();
-  if (fp->Open(strFilename))
+  if (fp->Open(strFilename, flags))
   {
     file->internal = (void*)fp;
     return file;
diff --git a/xbmc/filesystem/BlurayCallback.h b/xbmc/filesystem/BlurayCallback.h
--- a/xbmc/filesystem/BlurayCallback.h
+++ b/xbmc/filesystem/BlurayCallback.h
@@ -0,6 +0,7 @@
   static void file_close(BD_FILE_H* file);
   static int file_eof(BD_FILE_H* file);
   static BD_FILE_H* file_open(void*  handle, const char*  rel_path);
+  static BD_FILE_H* file_open(void* handle, const char* rel_path, unsigned int flags);
   static int64_t file_read(BD_FILE_H* file, uint8_t* buf, int64_t size);
   static int64_t file_seek(BD_FILE_H* file, int64_t offset, int32_t origin);
   static int64_t file_tell(BD_FILE_H* file);
