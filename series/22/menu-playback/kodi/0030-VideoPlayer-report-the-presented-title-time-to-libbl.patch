+void CDVDInputStreamBluray::SetPresentedTime(double time)
+{
+  if (!m_bd || !m_navmode)
+    return;
+
+  bd_presented(m_bd, time == DVD_NOPTS_VALUE
+                         ? -1
+                         : av_rescale_q(static_cast<int64_t>(time), AVRational{1, DVD_TIME_BASE},
+                                        CDVDDemuxUtils::BLURAY_CLIP_TIME_BASE));
+}
