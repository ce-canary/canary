From: matthane <matthan.evans@icloud.com>
Date: Tue, 27 Oct 2026 23:55:16 -0500
Subject: [PATCH] VideoPlayer: report the presented title time to libbluray

A BD-J application can stop a playlist while its last seconds are
still queued in the player. libbluray sees only the read position,
which is past the end, so it reports no playlist stop and the player
plays out data the disc has left. Kodi's clock runs a display latency
behind the picture and is known only once the streams are in sync.
---
 cmake/modules/FindBluray.cmake                | 14 ++++++++
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 18 +++++++++++
 .../DVDInputStreams/DVDInputStreamBluray.h    |  3 ++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 32 +++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.h          |  2 ++
 5 files changed, 69 insertions(+)

diff --git a/cmake/modules/FindBluray.cmake b/cmake/modules/FindBluray.cmake
--- a/cmake/modules/FindBluray.cmake
+++ b/cmake/modules/FindBluray.cmake
@@ -0,6 +0,20 @@
 
     set(${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_COMPILE_DEFINITIONS HAVE_LIBBLURAY)
 
+    if(NOT TARGET ${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_BUILD_NAME})
+      include(CheckSymbolExists)
+      set(CMAKE_REQUIRED_INCLUDES ${${${CMAKE_FIND_PACKAGE_NAME}_SEARCH_NAME}_INCLUDE_DIRS})
+      set(CMAKE_REQUIRED_LIBRARIES ${${${CMAKE_FIND_PACKAGE_NAME}_SEARCH_NAME}_LINK_LIBRARIES})
+      foreach(symbol bd_presented)
+        check_symbol_exists(${symbol} libbluray/bluray.h LIBBLURAY_HAS_${symbol})
+        if(NOT LIBBLURAY_HAS_${symbol})
+          message(FATAL_ERROR "libbluray lacks ${symbol} of the CoreELEC presentation hold API")
+        endif()
+      endforeach()
+      unset(CMAKE_REQUIRED_INCLUDES)
+      unset(CMAKE_REQUIRED_LIBRARIES)
+    endif()
+
     # This is incorrectly applied to all platforms. Requires its own handling in the future
     if(NOT CORE_PLATFORM_NAME_LC STREQUAL windowsstore)
       list(APPEND ${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_COMPILE_DEFINITIONS HAVE_LIBBLURAY_BDJ)
