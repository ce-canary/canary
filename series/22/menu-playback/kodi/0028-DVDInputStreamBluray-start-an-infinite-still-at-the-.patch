From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 27 Oct 2026 23:54:08 -0500
Subject: [PATCH] DVDInputStreamBluray: start an infinite still at the read end

A read that reaches an infinite still parks it as a held read, and a
held read returns nothing until the next stream. An app action during
the old item's playout then waits for that next stream.
---
 .../cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -0,8 +0,11 @@
           break;
 
         case BD_EVENT_STILL_TIME:
+          // an infinite still starts here, so later disc events reach the player through the read
           if(m_hold == HOLD_STILL)
             m_event.event = 0; /* Consume duplicate still event */
+          else if (m_event.param == 0)
+            ProcessEvent();
           else
             m_hold = HOLD_HELD;
           return result;
