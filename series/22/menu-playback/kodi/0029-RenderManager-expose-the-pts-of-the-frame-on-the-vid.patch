From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 28 Oct 2026 15:12:04 -0500
Subject: [PATCH] RenderManager: expose the pts of the frame on the video plane

Kodi's clock runs one display latency behind the frames the renderer
releases. Callers that need the time on screen had only the clock.
---
 .../VideoRenderers/RenderManager.cpp          | 26 +++++++++++++++++++
 .../VideoRenderers/RenderManager.h            |  9 +++++++
 2 files changed, 35 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -0,6 +0,8 @@
     m_presentsourcePast = -1;
     m_guiPresentSource = -1;
     m_planeSource = -1;
+    m_displayedPts = DVD_NOPTS_VALUE;
+    m_offTimelineSource = -1;
     for (int i = 0; i < m_QueueSize; i++)
       m_free.push_back(i);
 
@@ -0,6 +0,7 @@
   CheckEnableClockSync();
 
   std::unique_lock lock2(m_presentlock);
+  const int planeSource = m_planeSource;
   // by vsync RDMA a frame queued now goes live a vsync after a GUI flip made now
   m_planeSource = m_presentsource;
   PrepareNextStep();
@@ -0,6 +0,18 @@
     m_presentstep = m_queued.empty() ? PRESENT_IDLE : PRESENT_READY;
   }
 
+  // a discarded frame stays on the plane, off the new timeline, until a new one replaces it
+  if (m_planeSource != planeSource)
+  {
+    if (m_planeSource >= 0 && m_planeSource != m_offTimelineSource)
+    {
+      m_displayedPts = m_Queue[m_planeSource].pts;
+      m_offTimelineSource = -1;
+    }
+    else
+      m_displayedPts = DVD_NOPTS_VALUE;
+  }
+
   // the render loop still draws the overlays of its frame; WaitForBuffer
   // releases those of a free slot before it is reused
   for (auto it = m_discard.begin(); it != m_discard.end();)
@@ -0,6 +0,8 @@
         m_presentsourcePast = -1;
         m_guiPresentSource = -1;
         m_planeSource = -1;
+        m_displayedPts = DVD_NOPTS_VALUE;
+        m_offTimelineSource = -1;
         m_presentstep = PRESENT_IDLE;
         for (int i = 0; i < m_QueueSize; i++)
           m_free.push_back(i);
@@ -0,6 +0,8 @@
     m_discard.push_back(m_queued.front());
     m_queued.pop_front();
   }
+  m_displayedPts = DVD_NOPTS_VALUE;
+  m_offTimelineSource = m_presentsource;
 
   if(m_presentstep == PRESENT_READY)
     m_presentstep = PRESENT_IDLE;
@@ -0,6 +0,13 @@
   return true;
 }
 
+double CRenderManager::GetDisplayedPts()
+{
+  std::unique_lock lock(m_presentlock);
+
+  return m_displayedPts;
+}
+
 void CRenderManager::CheckEnableClockSync()
 {
   // refresh rate can be a multiple of video fps
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
@@ -0,6 +0,12 @@
    */
   bool GetStats(int &lateframes, double &pts, int &queued, int &discard);
 
+  /**
+   * The pts of the frame on the video plane, DVD_NOPTS_VALUE without a vsync presenter or
+   * until the first frame after a discard or flush goes live
+   */
+  double GetDisplayedPts();
+
   /**
    * Video player call this on flush in order to discard any queued frames
    */
@@ -0,4 +0,7 @@
   //! Vsync thread, under m_presentlock: the frame on the video plane when a GUI flip made now
   //! latches
   int m_planeSource{-1};
+  //! Vsync thread, under m_presentlock: the pts of m_planeSource once it is a new frame
+  double m_displayedPts{DVD_NOPTS_VALUE};
+  int m_offTimelineSource{-1};
 };
