 			wr_bits_viu(VPU_VIU_VENC_MUX_CTRL, 0, 4, 4);
 		}
+		if (rd_viu(VPU_VIU2VDIN_HDN_CTRL) != 0)
+			wr_viu(VPU_VIU2VDIN_HDN_CTRL, 0x0);
 	}
-	if (rd_viu(VPU_VIU2VDIN_HDN_CTRL) != 0)
-		wr_viu(VPU_VIU2VDIN_HDN_CTRL, 0x0);
+	spin_unlock_irqrestore(&viuin_lock, flags);
 }
 
