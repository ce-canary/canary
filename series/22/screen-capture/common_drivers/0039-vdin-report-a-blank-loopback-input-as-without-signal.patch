From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 15 Nov 2026 01:03:56 -0600
Subject: [PATCH] vdin: report a blank loopback input as without signal

vdin drops a blank loopback frame, for example during an HDMI mute, and
tells the reader nothing. A reader cannot tell a blank input from a
stalled stream, so it gives up on a capture that resumes with the
picture.
---
 drivers/media/vin/tvin/vdin/vdin_drv.c     | 25 ++++++++++++++++++++++
 drivers/media/vin/tvin/vdin/vdin_drv.h     |  2 ++
 drivers/media/vin/tvin/vdin/vdin_v4l2_if.c | 15 +++++++++++++
 3 files changed, 42 insertions(+)

diff --git a/drivers/media/vin/tvin/vdin/vdin_drv.c b/drivers/media/vin/tvin/vdin/vdin_drv.c
--- a/drivers/media/vin/tvin/vdin/vdin_drv.c
+++ b/drivers/media/vin/tvin/vdin/vdin_drv.c
@@ -0,6 +0,7 @@
 		return;
 	devp->vdin_v4l2.held &= ~mask;
 	devp->vdin_v4l2.pending &= ~mask;
+	devp->vdin_v4l2.no_signal &= ~mask;
 	if (fe->dec_ops->tap_release(fe, mask))
 		return;
 	if (devp->vdin_v4l2.sched_field)
@@ -0,6 +0,30 @@
 	 */
 	turns = devp->vdin_v4l2.sched_armed > 1 || devp->vdin_v4l2.pend_num;
 	blank = vdin_is_v4l2_input_blank(devp);
+	/* the input of the frame that just finished, as userbits[0] names it */
+	vfe = turns ? devp->last_wr_vfe : NULL;
+	if (vfe)
+		input = vfe->v4l2_entries ? vfe->v4l2_input : devp->vdin_v4l2.input;
+	else if (turns)
+		input = devp->vdin_v4l2.sched_cur;
+	else
+		input = devp->vdin_v4l2.sched_armed ? devp->vdin_v4l2.run[0] :
+			devp->vdin_v4l2.input;
+	/* the bit is written before the event, so ENUMINPUT after DQEVENT reads it */
+	if ((!vfe || !vfe->v4l2_unlanded) &&
+	    (blank || (devp->vdin_v4l2.no_signal & BIT(input)))) {
+		struct v4l2_event ev = {
+			.type = V4L2_EVENT_SOURCE_CHANGE,
+			.id = input,
+			.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION,
+		};
+
+		if (blank)
+			devp->vdin_v4l2.no_signal |= BIT(input);
+		else
+			devp->vdin_v4l2.no_signal &= ~BIT(input);
+		v4l2_event_queue(&devp->video_dev, &ev);
+	}
 	if ((!vdin_is_input_valid(devp) &&
 	     (devp->vdin_function_sel & VDIN_NOT_DATA_INPUT_DROP)) || blank) {
 		devp->vdin_irq_flag = VDIN_IRQ_FLG_FAKE_IRQ;
diff --git a/drivers/media/vin/tvin/vdin/vdin_drv.h b/drivers/media/vin/tvin/vdin/vdin_drv.h
--- a/drivers/media/vin/tvin/vdin/vdin_drv.h
+++ b/drivers/media/vin/tvin/vdin/vdin_drv.h
@@ -0,6 +0,8 @@
 	 */
 	unsigned int held;
 	unsigned int pending;
+	/* inputs whose last frame was blank, until released or stop_streaming */
+	unsigned int no_signal;
 	/* the port the frontend gave each input */
 	enum tvin_port_e sched_port[VDIN_V4L2_INPUT_MAX];
 	/* fixed at STREAMON for inputs that join */
diff --git a/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c b/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
--- a/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
+++ b/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
@@ -0,6 +0,8 @@
 	}
 
 	inp->std = V4L2_STD_ALL;
+	if (devp->vdin_v4l2.no_signal & BIT(inp->index))
+		inp->status |= V4L2_IN_ST_NO_SIGNAL;
 	str = tvin_port_str(devp->v4l2_port[inp->index]);
 
 	if (str)
@@ -0,6 +0,15 @@
 	return 0;
 }
 
+static int vdin_vidioc_subscribe_event(struct v4l2_fh *fh,
+				       const struct v4l2_event_subscription *sub)
+{
+	if (sub->type == V4L2_EVENT_SOURCE_CHANGE)
+		return v4l2_src_change_event_subscribe(fh, sub);
+
+	return -EINVAL;
+}
+
 static const struct v4l2_ioctl_ops vdin_v4l2_ioctl_ops = {
 	.vidioc_querystd	= vdin_vidioc_querystd,
 	.vidioc_enum_input	= vdin_vidioc_enum_input,
@@ -0,6 +0,9 @@
 	.vidioc_g_fmt_vid_cap			= vdin_vidioc_g_fmt_vid_cap,
 	.vidioc_g_fmt_vid_out_mplane	= vdin_vidioc_g_fmt_vid_cap_mplane,
 	.vidioc_g_fmt_vid_out			= vdin_vidioc_g_fmt_vid_cap,
+
+	.vidioc_subscribe_event = vdin_vidioc_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
 };
 
 static void vdin_vdev_release(struct video_device *vdev)
@@ -0,6 +0,7 @@
 
 	dprintk(2, "%s\n", __func__);
 	vdin_v4l2_stop_tvin(devp);
+	devp->vdin_v4l2.no_signal = 0;
 
 	devp->vb_queue.streaming = false;
 
