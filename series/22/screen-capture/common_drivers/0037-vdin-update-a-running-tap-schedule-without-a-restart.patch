 	    rd_bits(devp->addr_offset, VDIN_COM_CTRL0, VDIN_SEL_BIT, VDIN_SEL_WID) !=
 	    vdin_wb_src(devp->vdin_v4l2.sched_port[vfe->v4l2_input]))
 		return false;
@@ -0,6 +0,8 @@
