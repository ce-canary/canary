From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 15 Nov 2026 01:03:56 -0600
Subject: [PATCH] vdin: update a running tap schedule without a restart

A loopback stream took its tap schedule only at STREAMON, and a
one-input stream had no turns, so adding or dropping an input
restarted it and every consumer lost about one image.
---
 drivers/media/vin/tvin/tvin_frontend.h        |  12 +-
 drivers/media/vin/tvin/vdin/vdin_ctl.c        |  53 +++--
 drivers/media/vin/tvin/vdin/vdin_ctl.h        |   4 +
 drivers/media/vin/tvin/vdin/vdin_drv.c        | 181 ++++++++++++++----
 drivers/media/vin/tvin/vdin/vdin_drv.h        |  30 ++-
 drivers/media/vin/tvin/vdin/vdin_v4l2_if.c    |  92 +++++++--
 drivers/media/vin/tvin/vdin/vdin_vf.h         |   6 +-
 drivers/media/vin/tvin/viu/viuin.c            |  85 +++++++-
 .../media/v4l2-ext/v4l2-controls-ext.h        |  11 +-
 9 files changed, 383 insertions(+), 91 deletions(-)

diff --git a/drivers/media/vin/tvin/tvin_frontend.h b/drivers/media/vin/tvin/tvin_frontend.h
--- a/drivers/media/vin/tvin/tvin_frontend.h
+++ b/drivers/media/vin/tvin/tvin_frontend.h
@@ -0,9 +0,9 @@
 #include "tvin_global.h"
 
 #define TVIN_TAP_MAX	7
-/* tap_open: this frontend's rdma table switches a channel's tap field per
- * frame (FIELD), or a channel's field waits for another frontend's table
- * (PENDING)
+/* tap_open and tap_bind: this frontend's rdma table switches a channel's tap
+ * field per frame (FIELD), or a channel's field waits for another frontend's
+ * table (PENDING)
  */
 #define TVIN_TAP_FIELD		BIT(0)
 #define TVIN_TAP_PENDING	BIT(1)
@@ -0,6 +0,12 @@
 	int (*tap_open)(struct tvin_frontend_s *fe, enum tvin_port_e *ports,
 			unsigned int mask, unsigned int home,
 			enum tvin_port_type_e port_type);
+	/* on an open frontend: bind more inputs, or give inputs back; release
+	 * returns whether the frontend's table still switches a tap field
+	 */
+	int (*tap_bind)(struct tvin_frontend_s *fe, enum tvin_port_e *ports,
+			unsigned int mask);
+	bool (*tap_release)(struct tvin_frontend_s *fe, unsigned int mask);
 	void (*tap_queue)(struct tvin_frontend_s *fe, int rdma_handle, unsigned int input);
 	bool (*tap_landed)(struct tvin_frontend_s *fe, unsigned int input);
 	void (*tap_disarm)(struct tvin_frontend_s *fe);
diff --git a/drivers/media/vin/tvin/vdin/vdin_ctl.c b/drivers/media/vin/tvin/vdin/vdin_ctl.c
--- a/drivers/media/vin/tvin/vdin/vdin_ctl.c
