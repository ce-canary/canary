 			/* undo the start above as vdin_stop_dec does */
 			vdin_hw_close(devp);
 			vdin_dolby_addr_release(devp, devp->vfp->size);
@@ -0,6 +0,8 @@
 	if (vfe) {
 		vdin_frame_write_ctrl_set(devp, vfe, 0);
