@@ -0,20 +0,20 @@
 	}
 #endif
 	vdin_set_all_regs(devp);
-	if (devp->vdin_v4l2.sched_srcs) {
-		wr_bits(devp->addr_offset, VDIN_ASFIFO_CTRL3, 0xe4,
