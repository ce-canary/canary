+static enum tvin_port_e viuin_chan_port(enum tvin_port_e port, unsigned int c)
+{
+	enum tvin_port_e tap = viuin_tap(port);
+
+	if (!viuin_is_tap(tap))
+		return port;
+	return c ? tap - TVIN_PORT_VIU1_VIDEO + TVIN_PORT_VIU1_WB1_VIDEO : tap;
