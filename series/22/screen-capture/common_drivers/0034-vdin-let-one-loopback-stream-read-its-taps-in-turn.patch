 #ifndef CONFIG_AMLOGIC_ZAPPER_CUT
 	/* check if need enable afbce */
@@ -0,15 +0,44 @@
 	}
 #endif
 	vdin_set_all_regs(devp);
+	if (devp->vdin_v4l2.sched_srcs) {
