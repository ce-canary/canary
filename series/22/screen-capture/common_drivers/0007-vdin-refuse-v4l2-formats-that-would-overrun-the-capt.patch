From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 21 Oct 2026 18:21:55 -0500
Subject: [PATCH] vdin: refuse v4l2 formats that would overrun the capture
 buffers

S_FMT kept the previous sizeimage for a fourcc missing from the format
list, or for a plane count the fourcc does not use. It also changed the
write size after REQBUFS without reallocating. Either way vdin could
write past the capture buffers. NV16M and NV61M were accepted this way;
no CE client uses them.
---
 drivers/media/vin/tvin/vdin/vdin_v4l2_if.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c b/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
--- a/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
+++ b/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
@@ -0,9 +0,24 @@
 	if (IS_ERR_OR_NULL(devp))
 		return -EFAULT;
 
-	if (vdin_v4l2_is_busy(devp, file))
+	if (vb2_is_busy(&devp->vb_queue))
 		return -EBUSY;
 
+	for (i = 0; i < ARRAY_SIZE(pix_formats); i++) {
+		if (fmt->fmt.pix_mp.pixelformat == pix_formats[i].fourcc)
+			break;
+	}
+	if (i >= ARRAY_SIZE(pix_formats)) {
+		dprintk(0, "%s vdin%d v4l2 do not support pixelformat=%#x\n",
+			__func__, devp->index, fmt->fmt.pix_mp.pixelformat);
+		return -EINVAL;
+	}
+	if (fmt->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_NV12M ||
+	    fmt->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_NV21M)
+		fmt->fmt.pix_mp.num_planes = 2;
+	else
+		fmt->fmt.pix_mp.num_planes = 1;
+
 	dprintk(2, "%s:wxh:%dx%d,quant:%d,enc:%d,field:%d,pixelformat:0x%x num_planes=%d\n",
 		__func__,
 		fmt->fmt.pix_mp.width,	        fmt->fmt.pix_mp.height,
