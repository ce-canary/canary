From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 14 Nov 2026 17:07:55 -0600
Subject: [PATCH] vdin: grant only the v4l2 buffers the frame pool holds

On SoCs without hardware canvases the buffer request granted every
buffer asked for, while start sizes the frame pool to the canvas ids
its format takes. A buffer past the pool never takes a frame, so it
never returns to the caller.
---
 drivers/media/vin/tvin/vdin/vdin_v4l2_if.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c b/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
--- a/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
+++ b/drivers/media/vin/tvin/vdin/vdin_v4l2_if.c
@@ -0,14 +0,15 @@
 	unsigned int canvas_num;
 	u32 pixelformat = devp->v4l2_fmt.fmt.pix_mp.pixelformat;
 
-	if (hw_canvas_support) {
+	if (hw_canvas_support)
 		canvas_num = devp->index ? VDIN1_CANVAS_MAX_CNT : VDIN0_CANVAS_MAX_CNT;
-		/* nv12/nv21 take two canvas ids per buffer */
-		if (pixelformat == V4L2_PIX_FMT_NV12 || pixelformat == V4L2_PIX_FMT_NV21 ||
-		    pixelformat == V4L2_PIX_FMT_NV12M || pixelformat == V4L2_PIX_FMT_NV21M)
-			canvas_num /= 2;
-		*num_buffers = min(*num_buffers, canvas_num);
-	}
+	else
+		canvas_num = VDIN_CANVAS_MAX_CNT;
+	/* nv12/nv21 take two canvas ids per buffer */
+	if (pixelformat == V4L2_PIX_FMT_NV12 || pixelformat == V4L2_PIX_FMT_NV21 ||
+	    pixelformat == V4L2_PIX_FMT_NV12M || pixelformat == V4L2_PIX_FMT_NV21M)
+		canvas_num /= 2;
+	*num_buffers = min(*num_buffers, canvas_num);
 
 	/*
 	 * NV12 every frame need two buffer
