 drivers/media/vin/tvin/vdin/vdin_drv.c    |  58 ++-
 drivers/media/vin/tvin/vdin/vdin_drv.h    |   3 +
 drivers/media/vin/tvin/viu/viuin.c        | 498 ++++++++++++++++------
 6 files changed, 434 insertions(+), 141 deletions(-)

