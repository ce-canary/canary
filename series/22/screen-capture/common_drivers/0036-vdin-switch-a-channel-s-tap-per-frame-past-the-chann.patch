+	VIUIN_WB_VPP2,
+	VIUIN_WB_VIU,
+	VIUIN_WB_HDN,
+	VIUIN_WB_NUM
+};
+
+static const u32 viuin_wb_reg[VIUIN_WB_NUM] = {
+	VPP_WR_BAK_CTRL, VPP1_WR_BAK_CTRL, VPP2_WR_BAK_CTRL,
+	VIU_WR_BAK_CTRL, VPU_VIU2VDIN_HDN_CTRL
+};
+
+struct viuin_wb_fields {
+	u32 val[VIUIN_WB_NUM];
