+    const float b = cb[x] - zero;
+    const float r = cr[x] - zero;
+    out[0] = ToBigEndian(ClampTo16(luma + k.rCr * r));
+    out[1] = ToBigEndian(ClampTo16(luma + k.gCb * b + k.gCr * r));
+    out[2] = ToBigEndian(ClampTo16(luma + k.bCb * b));
