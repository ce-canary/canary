From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 22 Oct 2026 18:40:06 -0500
Subject: [PATCH] IScreenshotSurface: serve live captures to getImage

The composite tap reads the whole framebuffer on the render thread on
every drawn frame, and an idle GUI draws none, so a continuous capture
gets nothing.
---
 xbmc/application/Application.cpp        |  9 +++++++++
 xbmc/interfaces/legacy/RenderCapture.h  | 22 ++++++++++++++++++----
 xbmc/rendering/capture/CaptureService.h |  3 ++-
 xbmc/rendering/capture/CaptureTypes.h   |  3 +++
 xbmc/utils/IScreenshotSurface.h         |  8 ++++++++
 5 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -0,6 +0,15 @@
     return;
   }
 
+  if (CaptureResult result; surface->CaptureDirect(request->spec, result))
+  {
+    if (result.pixels)
+      captureService->Complete(request, std::move(result));
+    else
+      captureService->Fail(request);
+    return;
+  }
+
   const ScreenshotContext ctx{*winSystem};
   if (!surface->Read(ctx))
   {
diff --git a/xbmc/interfaces/legacy/RenderCapture.h b/xbmc/interfaces/legacy/RenderCapture.h
--- a/xbmc/interfaces/legacy/RenderCapture.h
+++ b/xbmc/interfaces/legacy/RenderCapture.h
@@ -0,6 +0,14 @@
         DelayedCallGuard dg(languageHook);
         return handle.WaitNext(std::chrono::milliseconds(msec ? msec : 1000));
       }
+
+      //! a live frame is read from the device on the copy, so it runs without the interpreter lock
+      bool CopyFrame(const KODI::RENDERING::CAPTURE::CaptureResult& result)
+      {
+        DelayedCallGuard dg(languageHook);
+        return KODI::RENDERING::CAPTURE::CaptureCopyBGRA8(result, m_width, m_height,
+                                                          m_buffer.get());
+      }
 #endif
 
     public:
@@ -0,13 +0,19 @@
       {
         if (!m_handle)
           return false;
-        if (!WaitFrame(msec))
-          return false;
+        if (!m_handle->WaitNext(std::chrono::milliseconds(0)))
+        {
+          const bool running = IsRunning();
+          const KODI::RENDERING::CAPTURE::CaptureResult last = m_handle->CopyResult();
+          if (last.live && running && CopyFrame(last))
+            return true;
+          if (!WaitFrame(msec))
+            return false;
+        }
         const KODI::RENDERING::CAPTURE::CaptureResult result = m_handle->CopyResult();
         // legacy contract: raw output-coded 8-bit BGRA, never tonemapped; an
         // HDR session delivers PQ/HLG-coded bytes exactly as glReadPixels did
-        return KODI::RENDERING::CAPTURE::CaptureCopyBGRA8(result, m_width, m_height,
-                                                          m_buffer.get());
+        return CopyFrame(result);
       }
 #endif
 
diff --git a/xbmc/rendering/capture/CaptureService.h b/xbmc/rendering/capture/CaptureService.h
--- a/xbmc/rendering/capture/CaptureService.h
+++ b/xbmc/rendering/capture/CaptureService.h
@@ -0,7 +0,8 @@
   //! Any thread: completed deliveries so far; waiters compare against the last one seen.
   uint64_t GetDeliveries(const CaptureRequest& request) const;
 
-  //! Any thread: locked copy of the latest result; per-frame pixel buffers are immutable.
+  //! Any thread: locked copy of the latest result; per-frame pixel buffers are immutable unless
+  //! the result is live.
   CaptureResult CopyResult(const CaptureRequest& request) const;
 
   //! Teardown: fail every request, wake every waiter, drop queued callbacks.
diff --git a/xbmc/rendering/capture/CaptureTypes.h b/xbmc/rendering/capture/CaptureTypes.h
--- a/xbmc/rendering/capture/CaptureTypes.h
+++ b/xbmc/rendering/capture/CaptureTypes.h
@@ -0,6 +0,9 @@
   //! which tap produced this result; stamped at delivery so a BOTH consumer
   //! knows whether it holds the video-only or the composite capture
   CaptureContent content{CaptureContent::COMPOSITE};
+  //! the pixels read the newest frame on every Lock, so a consumer may copy them again without
+  //! waiting for a delivery; a delivery comes only with a drawn frame
+  bool live{false};
   //! HDR mastering/light metadata of the captured content, carried verbatim so
   //! an SDR tonemap has the same source peak the thumbnail extractor uses
   bool hasDisplayMetadata{false};
diff --git a/xbmc/utils/IScreenshotSurface.h b/xbmc/utils/IScreenshotSurface.h
--- a/xbmc/utils/IScreenshotSurface.h
+++ b/xbmc/utils/IScreenshotSurface.h
@@ -0,6 +0,14 @@
   //! fully rendered frame and render-thread context.
   virtual bool Read(const ScreenshotContext& ctx) { return false; }
 
+  //! \brief Render thread: serve a capture without the framebuffer readback, e.g. from a
+  //! display writeback. False leaves it to Read; true with no pixels fails the request.
+  virtual bool CaptureDirect(const KODI::RENDERING::CAPTURE::CaptureSpec& spec,
+                             KODI::RENDERING::CAPTURE::CaptureResult& result)
+  {
+    return false;
+  }
+
   int GetWidth() const { return m_width; }
   int GetHeight() const { return m_height; }
   //! signed linesize; negative when the delivered rows are bottom-up
