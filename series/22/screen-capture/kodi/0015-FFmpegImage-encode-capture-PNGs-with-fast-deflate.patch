From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 22 Oct 2026 18:40:51 -0500
Subject: [PATCH] FFmpegImage: encode capture PNGs with fast deflate

Screenshots are encoded with zlib level 6 and the Paeth filter on every
row, and deflate takes most of the encode: 7 to 12 s for a 2160p 16-bit
screenshot on an Amlogic box.
---
 xbmc/guilib/FFmpegImage.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/xbmc/guilib/FFmpegImage.cpp b/xbmc/guilib/FFmpegImage.cpp
--- a/xbmc/guilib/FFmpegImage.cpp
+++ b/xbmc/guilib/FFmpegImage.cpp
@@ -0,6 +0,7 @@
 #include <libavutil/avutil.h>
 #include <libavutil/display.h>
 #include <libavutil/imgutils.h>
+#include <libavutil/opt.h>
 #include <libavutil/pixdesc.h>
 #include <libswscale/swscale.h>
 }
@@ -0,6 +0,13 @@
       CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_imageQualityJpeg;
   tdm.avOutctx->global_quality =
       jpg_output ? quality * FF_QP2LAMBDA : tdm.avOutctx->qmin * FF_QP2LAMBDA;
+  // deflate dominates the encode of a capture; level 1 on the up filter trades
+  // 9 to 15 % more size for most of the time
+  if (opaque && !jpg_output)
+  {
+    tdm.avOutctx->compression_level = 1;
+    av_opt_set(tdm.avOutctx->priv_data, "pred", "up", 0);
+  }
 
   if (avcodec_open2(tdm.avOutctx, tdm.codec, NULL) < 0)
   {
