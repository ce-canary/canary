                const uint16_t* y,
@@ -0,6 +0,11 @@
   return static_cast<uint8_t>(v * 255 + 0.5f);
 }
 
+uint16_t To16(float v)
+{
+  return static_cast<uint16_t>(v * 65535 + 0.5f);
+}
