+//! The coding of an R'G'B' image: SDR BT.709, or BT.2020 with SDR white at whiteNits
+struct AMLCaptureCoding
+{
+  enum class Transfer
+  {
+    SDR,
+    PQ,
+    HLG,
+  };
+  Transfer transfer{Transfer::SDR};
