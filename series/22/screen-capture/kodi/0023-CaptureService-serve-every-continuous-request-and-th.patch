 .../VideoRenderers/RenderManager.cpp          | 28 +++++---
 .../VideoRenderers/RenderManager.h            |  9 ++-
 xbmc/interfaces/legacy/RenderCapture.h        |  2 +
 xbmc/rendering/capture/CaptureRequest.h       |  4 +-
 xbmc/rendering/capture/CaptureService.cpp     | 37 +++++------
 xbmc/rendering/capture/CaptureService.h       | 26 ++++----
 .../capture/test/TestCaptureService.cpp       | 49 ++++++++++----
 8 files changed, 125 insertions(+), 95 deletions(-)

