     out[1] = To8(std::clamp(green[x], 0.0f, 1.0f));
     out[B] = To8(std::clamp(blue[x], 0.0f, 1.0f));
-    out[3] = 255;
+    if constexpr (STEP == 4)
+      out[3] = 255;
   }
 }
 
