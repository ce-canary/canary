+  format.fmt.pix_mp.height = height;
+  format.fmt.pix_mp.pixelformat = m_pixelFormat;
+  format.fmt.pix_mp.field = V4L2_FIELD_NONE;
+  format.fmt.pix_mp.num_planes = 1;
+  if (ioctl(m_fd, VIDIOC_TRY_FMT, &format) < 0)
