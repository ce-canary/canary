From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 3 Nov 2026 20:22:09 -0600
Subject: [PATCH] AMLCaptureConvert: limit a bright overlay in a Standard shot

A Blu-ray menu or subtitle over HDR video can be far brighter than GUI
white. MapToSdr clips such a pixel per channel, so a blue panel on a
disc menu comes out as pure cyan.
---
 xbmc/utils/AMLCaptureConvert.cpp              | 29 ++++++++++++++++++-
 xbmc/utils/AMLCaptureConvert.h                |  9 ++++--
 .../amlogic/ScreenshotSurfaceAML.cpp          |  2 +-
 3 files changed, 35 insertions(+), 5 deletions(-)

diff --git a/xbmc/utils/AMLCaptureConvert.cpp b/xbmc/utils/AMLCaptureConvert.cpp
--- a/xbmc/utils/AMLCaptureConvert.cpp
+++ b/xbmc/utils/AMLCaptureConvert.cpp
@@ -0,6 +0,29 @@
   }
 }
 
+// art coded past the title's peak is not shown as coded, so its ratios are not its colour
+void LimitToPeakRow(const Planes& p, int width, float peak)
+{
+  for (float* v : p)
+  {
+    for (int x = 0; x < width; x++)
+      v[x] = std::min(v[x], peak);
+  }
+}
+
+// scale a pixel brighter than white back to it: a clip per channel would change its hue
+void LimitToWhiteRow(const Planes& p, int width)
+{
+  for (int x = 0; x < width; x++)
+  {
+    const float brightest = std::max({p[0][x], p[1][x], p[2][x]});
+    if (brightest <= 1.0f)
+      continue;
+    for (float* v : p)
+      v[x] /= brightest;
+  }
+}
+
 // in float, which stays within a code of double for these gamut matrices; the Dolby Vision
 // decode keeps double
 void ApplyRow(const Matrix& m, const Planes& p, int width)
@@ -0,11 +0,13 @@
 void CAMLCaptureConvert::MapToSdr(const AMLCaptureImage& src,
                                   const AMLCaptureCoding& coding,
                                   const AMLCaptureImage& dst,
-                                  const AMLCaptureImage* gui)
+                                  const AMLCaptureImage* gui,
+                                  float peakNits)
 {
   const Tables& tables = GetTables();
   const Matrix toSdr =
       ScaleMatrix(BT2020_TO_BT709, PQ_PEAK_NITS / static_cast<double>(coding.whiteNits));
+  const float peak = std::max(peakNits, coding.whiteNits) / static_cast<float>(PQ_PEAK_NITS);
   std::vector<float> rows(static_cast<std::size_t>(src.width) * 3);
   const Planes p = {rows.data(), rows.data() + src.width, rows.data() + 2 * src.width};
   for (int y = 0; y < src.height; y++)
@@ -0,7 +0,9 @@
         for (float* v : span)
           LookupRow(tables.pqToLinear, v, width);
       }
+      LimitToPeakRow(span, width, peak);
       ApplyRow(toSdr, span, width);
+      LimitToWhiteRow(span, width);
       for (float* v : span)
         LookupLogRow(tables.linearToSrgbLog, v, width);
 
diff --git a/xbmc/utils/AMLCaptureConvert.h b/xbmc/utils/AMLCaptureConvert.h
--- a/xbmc/utils/AMLCaptureConvert.h
+++ b/xbmc/utils/AMLCaptureConvert.h
@@ -0,7 +0,7 @@
 struct AMLCaptureColor
 {
   AMLCaptureSignal signal{AMLCaptureSignal::SDR};
-  //! the source luminance of the SDR tonemap in cd/m2
+  //! the source luminance in cd/m2, for the SDR tonemap and the overlay limit
   float luminance{0.0f};
   //! an output mode display-mapped the signal, so it is not the content
   bool displayMapped{false};
@@ -0,11 +0,14 @@
   static bool Scale(const AMLCaptureImage& src, const AMLCaptureImage& dst);
 
   //! Map src, an AV_PIX_FMT_RGBA64LE image in an HDR coding, to SDR AV_PIX_FMT_RGBA of the same
-  //! size by the inverse of the coding, as the GUI places SDR. Pixels where gui is clear are left.
+  //! size by the inverse of the coding, as the GUI places SDR. A pixel over white, as HDR overlay
+  //! art can be, is limited to peakNits, or white if that is higher, and scaled to white. Pixels
+  //! where gui is clear are left.
   void MapToSdr(const AMLCaptureImage& src,
                 const AMLCaptureCoding& coding,
                 const AMLCaptureImage& dst,
-                const AMLCaptureImage* gui);
+                const AMLCaptureImage* gui,
+                float peakNits);
 
   //! A premultiplied 8-bit pixel that leaves what is under it unchanged
   static bool IsClear(const uint8_t* pixel)
diff --git a/xbmc/windowing/amlogic/ScreenshotSurfaceAML.cpp b/xbmc/windowing/amlogic/ScreenshotSurfaceAML.cpp
--- a/xbmc/windowing/amlogic/ScreenshotSurfaceAML.cpp
+++ b/xbmc/windowing/amlogic/ScreenshotSurfaceAML.cpp
@@ -0,7 +0,7 @@
       return true;
     }
 
-    convert.MapToSdr(image, coding, dst, &overlay);
+    convert.MapToSdr(image, coding, dst, &overlay, frame.color.luminance);
 
     if (IsRgb())
       Repack<3>(m_buffer.get(), pixels);
