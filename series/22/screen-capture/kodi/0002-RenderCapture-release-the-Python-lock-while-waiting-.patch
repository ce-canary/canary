From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 22 Oct 2026 18:38:18 -0500
Subject: [PATCH] RenderCapture: release the Python lock while waiting for a
 frame

getImage blocks until the next captured frame, up to its timeout,
while holding the interpreter lock. A capture add-on polling it stalls
every other Python add-on for as long as it waits.
---
 xbmc/interfaces/legacy/RenderCapture.h | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/xbmc/interfaces/legacy/RenderCapture.h b/xbmc/interfaces/legacy/RenderCapture.h
--- a/xbmc/interfaces/legacy/RenderCapture.h
+++ b/xbmc/interfaces/legacy/RenderCapture.h
@@ -0,6 +0,7 @@
 
 #include "AddonClass.h"
 #include "Exception.h"
+#include "LanguageHook.h"
 #include "ServiceBroker.h"
 #include "application/ApplicationComponents.h"
 #include "application/ApplicationPlayer.h"
@@ -0,6 +0,7 @@
 #include <chrono>
 #include <cstdint>
 #include <memory>
+#include <mutex>
 
 namespace XBMCAddon
 {
@@ -0,6 +0,18 @@
       unsigned int m_width{0};
       unsigned int m_height{0};
       std::unique_ptr<uint8_t[]> m_buffer;
+      std::mutex m_lock;
+
+#ifndef SWIG
+      //! getImage uses the handle and the buffer without the interpreter lock, so it and capture()
+      //! hold this lock across them; a thread waits for it without the interpreter lock
+      std::unique_lock<std::mutex> LockCapture()
+      {
+        DelayedCallGuard dg(languageHook);
+        return std::unique_lock(m_lock);
+      }
+
+#endif
 
     public:
       RenderCapture() = default;
@@ -0,6 +0,7 @@
       inline XbmcCommons::Buffer getImage(unsigned int msecs = 0)
 #endif
       {
+        const auto lock = LockCapture();
         if (!GetPixels(msecs))
           return XbmcCommons::Buffer(0);
 
@@ -0,6 +0,7 @@
       inline void capture(int width, int height)
 #endif
       {
+        const auto lock = LockCapture();
         // cancel any previous request before its buffer goes away
         m_handle.reset();
 
@@ -0,8 +0,12 @@
       {
         if (!m_handle)
           return false;
-        if (!m_handle->WaitNext(std::chrono::milliseconds(msec ? msec : 1000)))
-          return false;
+        {
+          // wait for the next frame without holding the interpreter lock
+          DelayedCallGuard dg(languageHook);
+          if (!m_handle->WaitNext(std::chrono::milliseconds(msec ? msec : 1000)))
+            return false;
+        }
         const KODI::RENDERING::CAPTURE::CaptureResult result = m_handle->CopyResult();
         // legacy contract: raw output-coded 8-bit BGRA, never tonemapped; an
         // HDR session delivers PQ/HLG-coded bytes exactly as glReadPixels did
