From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 4 Nov 2026 23:12:39 -0600
Subject: [PATCH] hyperion.ng: feed the screen as shown during playback

During playback the feeder asks for the video alone, so the LEDs follow
the VD1 layer, which can hold green beside the picture and shows no menu
over a video. The fallback for a Kodi without the composite capture has
no user, since the add-on ships with that Kodi.
---
 .../addons/service/hyperion.ng/changelog.txt   |  1 +
 .../service/hyperion.ng/source/default.py      | 18 +++---------------
 .../resource.language.en_gb/strings.po         |  4 ++--
 3 files changed, 6 insertions(+), 17 deletions(-)

diff --git a/projects/Amlogic-ce/packages/addons/service/hyperion.ng/changelog.txt b/projects/Amlogic-ce/packages/addons/service/hyperion.ng/changelog.txt
--- a/projects/Amlogic-ce/packages/addons/service/hyperion.ng/changelog.txt
+++ b/projects/Amlogic-ce/packages/addons/service/hyperion.ng/changelog.txt
@@ -0,6 +0,7 @@
 - Feed the Kodi picture, video and menus, to Hyperion by itself over hyperiond's flatbuffer server, on by default (screen capture used to be opt-in)
 - Build without the DRM and framebuffer screen grabbers
 - Add an option to keep feeding Hyperion while a screensaver runs
+- Feed the screen as shown, on-screen display included, during playback too
 122
 - Add platform script
 121
diff --git a/projects/Amlogic-ce/packages/addons/service/hyperion.ng/source/default.py b/projects/Amlogic-ce/packages/addons/service/hyperion.ng/source/default.py
--- a/projects/Amlogic-ce/packages/addons/service/hyperion.ng/source/default.py
+++ b/projects/Amlogic-ce/packages/addons/service/hyperion.ng/source/default.py
@@ -0,7 +0,6 @@
         self.screensaver = xbmc.getCondVisibility('System.ScreenSaverActive')
         self.feed = xbmcaddon.Addon().getSettingInt('KODI_FEED')
         self.feed_screensaver = xbmcaddon.Addon().getSettingBool('KODI_SCREENSAVER')
-        self.video_only = False
         self.retry_at = 0
         self.empty = 0
         self.failed = 0
@@ -0,30 +0,19 @@
         if self.feed == FEED_OFF:
             return None
         if self.screensaver:
-            # a screensaver covers the video, so only the composite shows it
+            # a screensaver over a video counts as a menu
             if self.feed != FEED_ALL or not self.feed_screensaver:
                 return None
         elif self.player.isPlayingVideo():
             return FEED_VIDEO
-        if self.feed == FEED_ALL and not self.video_only and time.monotonic() >= self.retry_at:
+        if self.feed == FEED_ALL and time.monotonic() >= self.retry_at:
             return FEED_ALL
         return None
 
     def grab(self, target):
         if self.capture is None:
             self.capture = xbmc.RenderCapture()
-        if target == FEED_VIDEO:
-            aspect = self.capture.getAspectRatio()
-            height = round(CAPTURE_WIDTH / aspect) if aspect > 0 else CAPTURE_HEIGHT
-            self.capture.capture(CAPTURE_WIDTH, height)
-        else:
-            try:
-                self.capture.capture(CAPTURE_WIDTH, CAPTURE_HEIGHT, composite=True)
-            except TypeError:
-                log('Kodi has no GUI capture, feeding video only')
-                self.video_only = True
-                self.capture = None
-                return None
+        self.capture.capture(CAPTURE_WIDTH, CAPTURE_HEIGHT, composite=True)
         requested_at = time.monotonic()
         image = self.capture.getImage(FRAME_TIMEOUT_MS)
         failed = (time.monotonic() - requested_at) * 1000 < FAILED_REQUEST_MS
diff --git a/projects/Amlogic-ce/packages/addons/service/hyperion.ng/source/resources/language/resource.language.en_gb/strings.po b/projects/Amlogic-ce/packages/addons/service/hyperion.ng/source/resources/language/resource.language.en_gb/strings.po
--- a/projects/Amlogic-ce/packages/addons/service/hyperion.ng/source/resources/language/resource.language.en_gb/strings.po
+++ b/projects/Amlogic-ce/packages/addons/service/hyperion.ng/source/resources/language/resource.language.en_gb/strings.po
@@ -0,11 +0,11 @@
 msgstr ""
 
 msgctxt "#30003"
-msgid "Video"
+msgid "Playback only"
 msgstr ""
 
 msgctxt "#30004"
-msgid "Video and menus"
+msgid "Playback and menus"
 msgstr ""
 
 msgctxt "#30005"
