   DEFINE_METHOD2(int, codec_get_video_delay_limited_ms, (codec_para_t *p1, int *p2))
   DEFINE_METHOD2(int, codec_get_video_cur_delay_ms, (codec_para_t *p1, int *p2))
+  DEFINE_METHOD2(int, codec_set_eos, (codec_para_t *p1, int p2))
 
