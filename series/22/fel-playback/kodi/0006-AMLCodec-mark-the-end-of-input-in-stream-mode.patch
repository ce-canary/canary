   virtual int codec_get_video_cur_delay_ms(codec_para_t *pcodec,int *delay_ms)=0;
+  virtual int codec_set_eos(codec_para_t *pcodec, int is_eos)=0;
 };
 
 class DllLibAmCodec : public DllDynamic, DllLibamCodecInterface
@@ -0,6 +0,7 @@
