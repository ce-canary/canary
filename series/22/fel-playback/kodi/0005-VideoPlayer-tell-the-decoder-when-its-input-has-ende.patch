 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h |  5 ++++
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            |  5 ++++
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  |  1 +
 xbmc/cores/VideoPlayer/DVDMessage.h           |  1 +
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 27 +++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.h          |  2 ++
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp   | 10 +++++++
 8 files changed, 56 insertions(+)

