From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 16 Nov 2026 14:27:37 -0600
Subject: [PATCH] VideoPlayer: keep the input end through a subtitle replay

A subtitle stream change in a file replays the demuxer from the
current time. The replayed subtitle packets counted as new input and
cleared the input end, so a change near the end of a file drained the
video decoder a second time.
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -0,7 +0,9 @@
     if (pStream->type == StreamType::VIDEO)
       m_videoInputEndSent = false;
 
-    if (STREAM_SOURCE_MASK(pStream->source) != STREAM_SOURCE_DEMUX_SUB)
+    // packets the demuxer replays after a subtitle stream change are no new input
+    if (STREAM_SOURCE_MASK(pStream->source) != STREAM_SOURCE_DEMUX_SUB &&
+        !m_CurrentAudio.replaying && !m_CurrentVideo.replaying)
     {
       m_syncWait.reset();
       m_navTail = false;
