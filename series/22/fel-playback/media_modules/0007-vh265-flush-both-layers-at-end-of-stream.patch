From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 5 Nov 2026 22:11:22 -0600
Subject: [PATCH] vh265: flush both layers at end of stream

A dual layer pair runs one layer at a time and swaps when a parser
finds the other layer's next unit. The layer that ends the stream
flushes only itself, so the other layer's last pictures never show.
The partner is idle here: this work holds the shared core. End of
stream now resets the POC state on the layer, and STAT_EOS comes last.
---
 drivers/frame_provider/decoder/h265/vh265.c | 37 ++++++++++++++++-----
 1 file changed, 28 insertions(+), 9 deletions(-)

diff --git a/drivers/frame_provider/decoder/h265/vh265.c b/drivers/frame_provider/decoder/h265/vh265.c
--- a/drivers/frame_provider/decoder/h265/vh265.c
+++ b/drivers/frame_provider/decoder/h265/vh265.c
@@ -0,6 +0,13 @@
 	}
 }
 
+static struct hevc_state_s *dual_partner(struct vdec_s *vdec)
+{
+	struct vdec_s *partner = vdec->slave ? vdec->slave : vdec->master;
+
+	return partner ? partner->private : NULL;
+}
+
 static void flush_layer(struct hevc_state_s *hevc)
 {
 	struct PIC_s *pic;
@@ -0,6 +0,13 @@
 	hevc->decoding_pic = NULL;
 }
 
+static void end_layer(struct hevc_state_s *hevc)
+{
+	hevc->eos = 1;
+	flush_layer(hevc);
+	clear_poc_flag(hevc);
+}
+
 /* only when we decoded one field or one frame,
 we can call this function to get qos info*/
 static void get_picture_qos_info(struct hevc_state_s *hevc)
@@ -0,21 +0,26 @@
 			}
 		}
 	} else if (hevc->dec_result == DEC_RESULT_EOS) {
-		struct PIC_s *pic;
-		hevc->stat |= STAT_EOS;
-		hevc->eos = 1;
+		struct hevc_state_s *partner = dual_partner(vdec);
+
 #ifdef CONFIG_AMLOGIC_MEDIA_ENHANCEMENT_DOLBYVISION
 		if ((vdec_dual(vdec)) && aux_data_is_available(hevc))
 			if (hevc->decoding_pic)
 				dolby_get_meta(hevc);
 #endif
-		check_pic_decoded_error(hevc,
-			hevc->pic_decoded_lcu_idx);
-		pic = get_pic_by_POC(hevc, hevc->curr_POC);
 		hevc_print(hevc, PRINT_FLAG_VDEC_STATUS,
-			"%s: end of stream, last dec poc %d => 0x%pf\n",
-			__func__, hevc->curr_POC, pic);
-		flush_output(hevc, pic);
+			"%s: end of stream, last dec poc %d\n",
+			__func__, hevc->curr_POC);
+		/* el first: a bl picture takes its pair when it is shown */
+		if (partner && vdec->slave)
+			end_layer(partner);
+		end_layer(hevc);
+		if (partner && vdec->master)
+			end_layer(partner);
+		/* userspace ends its drain on this, so only after both flushes */
+		hevc->stat |= STAT_EOS;
+		if (partner)
+			partner->stat |= STAT_EOS;
 		/* dummy vf with eos flag to backend */
 		if (hevc->is_used_v4l)
 			notify_v4l_eos(hw_to_vdec(hevc));
