From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 1 Nov 2026 14:45:11 -0600
Subject: [PATCH] DT: sc2: take the audio clocks from hifi_pll

The HDMI TDM-C, S/PDIF-B and optical S/PDIF-A outputs run the 44.1 kHz
family from an MPLL, and TDM-C runs 48 kHz from one too. The hardware
runs those MPLLs about 20 ppm slow at 48 kHz and about 22 ppm slow at
44.1 kHz, so audio drifts against video. hifi_pll reaches both rates
within 0.1 ppm, and the drivers retune it per rate family.
---
 .../boot/dts/amlogic/coreelec_sc2_common.dtsi | 26 +++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/coreelec_sc2_common.dtsi b/arch/arm64/boot/dts/amlogic/coreelec_sc2_common.dtsi
--- a/arch/arm64/boot/dts/amlogic/coreelec_sc2_common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/coreelec_sc2_common.dtsi
@@ -0,8 +0,30 @@
 	aml_i2s2hdmi: i2s2hdmi {
 		compatible = "amlogic, tm2-revb-snd-tdmc";
 		clocks = <&clkaudio CLKID_AUDIO_MCLK_C
-				&clkc CLKID_MPLL2>;
-		clock-names = "mclk", "clk_srcpll";
+				&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL>;
+		clock-names = "mclk", "clk_srcpll", "clk_src_cd";
+	};
+
+	spdifa: spdif@0 {
+		clocks = <&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL
+				&clkc CLKID_FCLK_DIV4
+				&clkaudio CLKID_AUDIO_GATE_SPDIFIN
+				&clkaudio CLKID_AUDIO_GATE_SPDIFOUT_A
+				&clkaudio CLKID_AUDIO_SPDIFIN
+				&clkaudio CLKID_AUDIO_SPDIFOUT_A>;
+		clock-names = "sysclk", "clk_src_cd", "fixed_clk", "gate_spdifin",
+				"gate_spdifout", "clk_spdifin", "clk_spdifout";
+	};
+
+	spdifb: spdif@1 {
+		clocks = <&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL
+				&clkaudio CLKID_AUDIO_GATE_SPDIFOUT_B
+				&clkaudio CLKID_AUDIO_SPDIFOUT_B>;
+		clock-names = "sysclk", "clk_src_cd",
+				"gate_spdifout", "clk_spdifout";
 	};
 };
 
