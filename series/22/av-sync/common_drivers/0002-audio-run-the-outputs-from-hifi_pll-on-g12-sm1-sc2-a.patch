+				&clkc CLKID_HIFI_PLL
+				&clkc CLKID_MPLL1>;
+		clock-names = "mclk", "clk_srcpll", "samesource_srcpll",
+				"samesource_clk", "clk_src_cd", "clk_src_mpll";
 		/delete-property/ start_clk_enable;
 		/delete-property/ clk_tuning_enable;
 	};
+
+	aml_spdif: spdif {
+		clocks = <&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL
+				&clkc CLKID_FCLK_DIV4
+				&clkaudio CLKID_AUDIO_SPDIFIN
