 .../dts/amlogic/coreelec_g12b_common.dtsi     | 31 +++++++-
 .../boot/dts/amlogic/coreelec_sc2_common.dtsi | 40 ++++++++++-
 .../boot/dts/amlogic/coreelec_sm1_common.dtsi | 33 ++++++++-
 .../boot/dts/amlogic/coreelec_t7_common.dtsi  | 31 +++++++-
 drivers/clk/meson/t7.c                        | 10 ++-
 sound/soc/amlogic/auge/audio_utils.c          | 38 ++++++++++
 sound/soc/amlogic/auge/audio_utils.h          |  5 ++
 sound/soc/amlogic/auge/spdif.c                | 70 ++++++++++++-------
 sound/soc/amlogic/auge/tdm.c                  | 38 +++++++---
 10 files changed, 289 insertions(+), 43 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/coreelec_g12a_common.dtsi b/arch/arm64/boot/dts/amlogic/coreelec_g12a_common.dtsi
--- a/arch/arm64/boot/dts/amlogic/coreelec_g12a_common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/coreelec_g12a_common.dtsi
@@ -0,14 +0,48 @@
 	aml_i2s2hdmi: i2s2hdmi {
 		compatible = "amlogic, g12a-snd-tdmc";
 		clocks = <&clkaudio CLKID_AUDIO_MCLK_C
+				 &clkc CLKID_HIFI_PLL
+				 &clkc CLKID_HIFI_PLL
 				 &clkc CLKID_MPLL2>;
-		clock-names = "mclk", "clk_srcpll";
+		clock-names = "mclk", "clk_srcpll", "clk_src_cd", "clk_src_mpll";
 	};
 
 	aml_tdmb: tdmb {
+		clocks = <&clkaudio CLKID_AUDIO_MCLK_B
+				&clkc CLKID_HIFI_PLL
+				&clkc CLKID_MPLL0
