From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 1 Nov 2026 14:44:48 -0600
Subject: [PATCH] DT: take the audio clocks from hifi_pll on g12a, g12b, sm1
 and sc2

The HDMI TDM-C, S/PDIF-B and optical S/PDIF-A outputs run from MPLLs,
on sc2 for the 44.1 kHz family and TDM-C 48 kHz. The hardware runs them
about 20 ppm slow at 48 kHz and 22 ppm at 44.1 kHz, so audio drifts
against video. hifi_pll reaches both rates within 0.1 ppm, and the
drivers retune it per rate family.
---
 .../dts/amlogic/coreelec_g12a_common.dtsi     | 26 +++++++++++++++++--
 .../dts/amlogic/coreelec_g12b_common.dtsi     | 20 ++++++++++++--
 .../boot/dts/amlogic/coreelec_sc2_common.dtsi | 26 +++++++++++++++++--
 .../boot/dts/amlogic/coreelec_sm1_common.dtsi | 23 ++++++++++++++--
 4 files changed, 87 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/coreelec_g12a_common.dtsi b/arch/arm64/boot/dts/amlogic/coreelec_g12a_common.dtsi
--- a/arch/arm64/boot/dts/amlogic/coreelec_g12a_common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/coreelec_g12a_common.dtsi
@@ -0,14 +0,36 @@
 	aml_i2s2hdmi: i2s2hdmi {
 		compatible = "amlogic, g12a-snd-tdmc";
 		clocks = <&clkaudio CLKID_AUDIO_MCLK_C
-				 &clkc CLKID_MPLL2>;
-		clock-names = "mclk", "clk_srcpll";
+				 &clkc CLKID_HIFI_PLL
+				 &clkc CLKID_HIFI_PLL>;
+		clock-names = "mclk", "clk_srcpll", "clk_src_cd";
 	};
 
 	aml_tdmb: tdmb {
 		/delete-property/ start_clk_enable;
 		/delete-property/ clk_tuning_enable;
 	};
+
+	aml_spdif: spdif {
+		clocks = <&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL
+				&clkc CLKID_FCLK_DIV4
+				&clkaudio CLKID_AUDIO_SPDIFIN
+				&clkaudio CLKID_AUDIO_SPDIFOUT
+				&clkaudio CLKID_AUDIO_SPDIFIN_CTRL
+				&clkaudio CLKID_AUDIO_SPDIFOUT_CTRL>;
+		clock-names = "sysclk", "clk_src_cd", "fixed_clk", "gate_spdifin",
+				"gate_spdifout", "clk_spdifin", "clk_spdifout";
+	};
+
+	aml_spdif_b: spdif_b {
+		clocks = <&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL
+				&clkaudio CLKID_AUDIO_SPDIFOUTB
+				&clkaudio CLKID_AUDIO_SPDIFOUTB_CTRL>;
+		clock-names = "sysclk", "clk_src_cd",
+				"gate_spdifout", "clk_spdifout";
+	};
 };
 
 &aocec {
diff --git a/arch/arm64/boot/dts/amlogic/coreelec_g12b_common.dtsi b/arch/arm64/boot/dts/amlogic/coreelec_g12b_common.dtsi
--- a/arch/arm64/boot/dts/amlogic/coreelec_g12b_common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/coreelec_g12b_common.dtsi
@@ -0,8 +0,9 @@
 	aml_i2s2hdmi: i2s2hdmi {
 		compatible = "amlogic, g12a-snd-tdmc";
 		clocks = <&clkaudio CLKID_AUDIO_MCLK_C
-				 &clkc CLKID_MPLL2>;
-		clock-names = "mclk", "clk_srcpll";
+				 &clkc CLKID_HIFI_PLL
+				 &clkc CLKID_HIFI_PLL>;
+		clock-names = "mclk", "clk_srcpll", "clk_src_cd";
 	};
 
 	aml_tdmb: tdmb {
@@ -0,11 +0,26 @@
 	};
 
 	aml_spdif: spdif {
+		clocks = <&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL
+				&clkc CLKID_FCLK_DIV4
+				&clkaudio CLKID_AUDIO_SPDIFIN
+				&clkaudio CLKID_AUDIO_SPDIFOUT
+				&clkaudio CLKID_AUDIO_SPDIFIN_CTRL
+				&clkaudio CLKID_AUDIO_SPDIFOUT_CTRL>;
+		clock-names = "sysclk", "clk_src_cd", "fixed_clk", "gate_spdifin",
+				"gate_spdifout", "clk_spdifin", "clk_spdifout";
 		pinctrl-0 = <&spdifout>;
 		suspend-clk-off = <0>;
 	};
 
 	aml_spdif_b: spdif_b {
+		clocks = <&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL
+				&clkaudio CLKID_AUDIO_SPDIFOUTB
+				&clkaudio CLKID_AUDIO_SPDIFOUTB_CTRL>;
+		clock-names = "sysclk", "clk_src_cd",
+				"gate_spdifout", "clk_spdifout";
 		suspend-clk-off = <0>;
 	};
 };
diff --git a/arch/arm64/boot/dts/amlogic/coreelec_sc2_common.dtsi b/arch/arm64/boot/dts/amlogic/coreelec_sc2_common.dtsi
--- a/arch/arm64/boot/dts/amlogic/coreelec_sc2_common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/coreelec_sc2_common.dtsi
@@ -0,8 +0,30 @@
 	aml_i2s2hdmi: i2s2hdmi {
 		compatible = "amlogic, tm2-revb-snd-tdmc";
 		clocks = <&clkaudio CLKID_AUDIO_MCLK_C
-				&clkc CLKID_MPLL2>;
-		clock-names = "mclk", "clk_srcpll";
+				&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL>;
+		clock-names = "mclk", "clk_srcpll", "clk_src_cd";
+	};
+
+	spdifa: spdif@0 {
+		clocks = <&clkc CLKID_HIFI_PLL
+				&clkc CLKID_HIFI_PLL
