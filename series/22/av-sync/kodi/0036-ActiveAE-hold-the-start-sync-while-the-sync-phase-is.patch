From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 1 Nov 2026 00:02:26 -0500
Subject: [PATCH] ActiveAE: hold the start sync while the sync phase is pending

After a display reset or a clock move the start sync measures against
a clock sync phase from the old vsync grid, and hands that error over
to the player.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp      | 14 ++++++++++++++
 .../AudioEngine/Engines/ActiveAE/ActiveAEStream.h  |  2 ++
 xbmc/cores/AudioEngine/Interfaces/AEStream.h       |  2 ++
 xbmc/cores/VideoPlayer/AudioSinkAE.cpp             |  8 ++++++++
 xbmc/cores/VideoPlayer/AudioSinkAE.h               |  1 +
 5 files changed, 27 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -0,6 +0,7 @@
     stream->m_startCut = stream->m_pClock->TakeStartCut();
     stream->m_startPad = 0.0;
     stream->m_exactStart = false;
+    stream->m_syncPhaseId = stream->m_pClock->GetSyncPhaseId();
     stream->m_syncSinkReports = m_stats.GetSinkReports();
     CLog::Log(LOGDEBUG,"ActiveAE - start sync of audio stream");
   }
@@ -0,6 +0,19 @@
       return ret;
   }
 
+  if (stream->m_syncState == CAESyncInfo::AESyncState::SYNC_MUTE)
+  {
+    // the start sync measures against one published clock sync phase
+    const int syncPhaseId = stream->m_pClock->GetSyncPhaseId();
+    if (syncPhaseId == -1 || syncPhaseId != stream->m_syncPhaseId)
+    {
+      stream->m_syncPhaseId = syncPhaseId;
+      stream->m_syncError.Flush(100ms);
+      CLog::Log(LOGDEBUG, LOGAUDIO, "ActiveAE::SyncStream - start sync held, phase id {:d}",
+                syncPhaseId);
+    }
+  }
+
   double error;
   double threshold = 100;
   if (stream->m_resampleMode)
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
@@ -0,6 +0,8 @@
   double m_startPad{0.0};
   // whether the start error handed over is in whole phase periods
   bool m_exactStart{false};
+  // the clock sync phase the start sync measures against
+  int m_syncPhaseId{0};
   // the sink reports counted when the start sync began
   unsigned int m_syncSinkReports{0};
 };
diff --git a/xbmc/cores/AudioEngine/Interfaces/AEStream.h b/xbmc/cores/AudioEngine/Interfaces/AEStream.h
--- a/xbmc/cores/AudioEngine/Interfaces/AEStream.h
+++ b/xbmc/cores/AudioEngine/Interfaces/AEStream.h
@@ -0,6 +0,8 @@
   virtual double TakeStartCut() { return 0.0; }
   //! Clock moves by whole multiples of this period in ms keep the display sync, 0 if none
   virtual double GetPhasePeriod() { return 0.0; }
+  //! 0 without a clock sync phase, -1 while it is pending, else the id of the published phase
+  virtual int GetSyncPhaseId() { return 0; }
 };
 
 class CAESyncInfo
diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
@@ -0,6 +0,14 @@
     return 0.0;
 }
 
+int CAudioSinkAE::GetSyncPhaseId()
+{
+  if (m_pClock)
+    return m_pClock->GetVsyncPhase().GetVsyncPhaseId();
+  else
+    return 0;
+}
+
 double CAudioSinkAE::TakeStartCut()
 {
   return m_startCut.exchange(0.0) / DVD_TIME_BASE * 1000;
diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.h b/xbmc/cores/VideoPlayer/AudioSinkAE.h
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.h
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.h
@@ -0,6 +0,7 @@
   double GetClockSpeed() override;
   double TakeStartCut() override;
   double GetPhasePeriod() override;
+  int GetSyncPhaseId() override;
 
   CAEStreamInfo::DataType GetPassthroughStreamType(AVCodecID codecId, int samplerate, int profile);
 
