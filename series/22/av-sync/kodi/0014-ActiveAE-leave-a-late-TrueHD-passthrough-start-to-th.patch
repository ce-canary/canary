From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 31 Oct 2026 23:58:54 -0500
Subject: [PATCH] ActiveAE: leave a late TrueHD passthrough start to the clock

TrueHD passthrough was kept from handing a late start to the player's
clock because its sync error was scaled down and did not tell how late
the audio was. The engine reads that error unscaled since TrueHD comes
in MAT frames of 20 ms.
---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 11 ++---------
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h   |  1 -
 2 files changed, 2 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -0,12 +0,6 @@
   return false;
 }
 
-bool CActiveAE::IsTrueHDPassthrough() const
-{
-  return m_mode == MODE_RAW &&
-         m_sinkFormat.m_streamInfo.m_type == CAEStreamInfo::STREAM_TYPE_TRUEHD;
-}
-
 CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
 {
   CSampleBuffer *ret = NULL;
@@ -0,9 +0,8 @@
 
   // Without resampling, the player moves its clock to the audio once the error exceeds its own
   // limit. Audio starting late is therefore left to the player, as skipping it would lose the
-  // start of the audio. The errors of TrueHD passthrough are scaled down, so they do not tell how
-  // late the audio is.
-  const bool clockFollowsAudio{!stream->m_resampleMode && !IsTrueHDPassthrough()};
+  // start of the audio.
+  const bool clockFollowsAudio{!stream->m_resampleMode};
   const auto keepAudible = [&](double syncError)
   {
     return fabs(syncError) <= threshold ||
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -0,7 +0,6 @@
   bool RunStages();
   bool HasWork();
   CSampleBuffer* SyncStream(CActiveAEStream *stream);
-  bool IsTrueHDPassthrough() const;
 
   void ResampleSounds();
   bool ResampleSound(CActiveAESound *sound);
