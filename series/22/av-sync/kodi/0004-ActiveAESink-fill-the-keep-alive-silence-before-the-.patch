From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 22 Nov 2026 10:34:20 -0600
Subject: [PATCH] ActiveAESink: fill the keep-alive silence before the open
 reply

At a sink open the sink reported its empty device and then wrote its
keep-alive silence one write per turn until the device blocked. A
start sync read during that climb took a partial level, so the clock
started ahead of the audio by the silence still to come.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp |  7 +++
 .../Engines/ActiveAE/ActiveAESink.cpp         | 53 +++++++++++++++----
 .../Engines/ActiveAE/ActiveAESink.h           |  6 ++-
 3 files changed, 56 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -0,6 +0,13 @@
   config.stats = &m_stats;
   config.device = (m_sinkRequestFormat.m_dataFormat == AE_FMT_RAW) ? &m_settings.passthroughdevice :
                                                                      &m_settings.device;
+  config.streaming = !m_streams.empty() || HoldsFormat();
+  config.fill = config.streaming;
+  for (const auto* stream : m_streams)
+  {
+    if (!stream->m_paused && stream->m_processingBuffers && stream->m_processingBuffers->HasWork())
+      config.fill = false;
+  }
 
   // send message to sink
   m_sink.m_controlPort.SendOutMessage(CSinkControlProtocol::SETNOISETYPE, &m_settings.streamNoise, sizeof(bool));
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -0,6 +0,7 @@
 #include "utils/log.h"
 
 #include <algorithm>
+#include <cmath>
 #include <new> // for std::bad_alloc
 #include <sstream>
 
@@ -0,6 +0,7 @@
         {
         case CSinkControlProtocol::CONFIGURE:
           SinkConfig *data;
+          bool opened;
           data = reinterpret_cast<SinkConfig*>(msg->data);
           if (data)
           {
@@ -0,12 +0,27 @@
             m_device = *(data->device);
           }
           m_extError = false;
-          m_extSilenceTimer.Set(0ms);
-          m_extStreaming = false;
+          m_extStreaming = data && data->streaming;
           ReturnBuffers();
           OpenSink();
+          opened = !m_extError;
 
-          if (!m_extError)
+          // the device is empty, the keep-alive fills it before any reader sees its delay
+          if (opened && data && data->fill)
+          {
+            const unsigned int room = static_cast<unsigned int>(
+                std::lround(m_sink->GetCacheTotal() * m_sinkFormat.m_sampleRate));
+            unsigned int filled = 0;
+            unsigned int written = 0;
+            do
+            {
+              written = 0;
+              OutputSamples(&m_sampleOfSilence, &written);
+              filled += written;
+            } while (!m_extError && written > 0 && filled + written < room);
+          }
+
+          if (opened)
           {
             SinkReply reply;
             reply.format = m_sinkFormat;
@@ -0,8 +0,23 @@
             reply.latency = m_sink->GetLatency();
             reply.hasVolume = m_sink->HasVolume();
             ReportDelay();
-            m_state = S_TOP_CONFIGURED_IDLE;
-            m_extTimeout = 10s;
+            SetSilenceTimer();
+            // a failed fill write takes the keep-alive's error path at its next turn
+            if (m_extError)
+            {
+              m_state = S_TOP_CONFIGURED_SILENCE;
+              m_extTimeout = 0ms;
+            }
+            else if (!m_extSilenceTimer.IsTimePast())
+            {
+              m_state = S_TOP_CONFIGURED_PLAY;
+              m_extTimeout = 0ms;
+            }
+            else
+            {
+              m_state = S_TOP_CONFIGURED_IDLE;
+              m_extTimeout = 10s;
+            }
             m_sinkLatency = (int64_t)(reply.latency * 1000);
             msg->Reply(CSinkControlProtocol::ACC, &reply, sizeof(SinkReply));
           }
@@ -0,7 +0,7 @@
   }
 }
 
-unsigned int CActiveAESink::OutputSamples(CSampleBuffer* samples)
+unsigned int CActiveAESink::OutputSamples(CSampleBuffer* samples, unsigned int* filled)
 {
   uint8_t **buffer = samples->pkt->data;
   uint8_t *packBuffer;
@@ -0,7 +0,8 @@
       {
         m_sink->AddPause(samples->pkt->pause_burst_ms);
         m_sink->GetDelay(status);
-        m_stats->UpdateSinkDelay(status, rawPackets, rawPauseMs);
+        if (!filled)
+          m_stats->UpdateSinkDelay(status, rawPackets, rawPauseMs);
         return status.delay * 1000;
       }
     }
@@ -0,14 +0,16 @@
       return 0;
     }
     frames -= written;
+    if (filled)
+      *filled += written;
 
     m_sink->GetDelay(status);
 
-    if (m_requestedFormat.m_dataFormat != AE_FMT_RAW)
+    if (m_requestedFormat.m_dataFormat != AE_FMT_RAW && !filled)
       m_stats->UpdateSinkDelay(status, samples->pool ? written : 0);
   }
 
-  if (m_requestedFormat.m_dataFormat == AE_FMT_RAW)
+  if (m_requestedFormat.m_dataFormat == AE_FMT_RAW && !filled)
   {
     // A packet dropped for a/v sync has no frames and never enters the loop above. Query the
     // sink anyway, otherwise the engine is told the sink holds no audio at all and the next
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
@@ -0,6 +0,9 @@
   AEAudioFormat format;
   CEngineStats *stats;
   const std::string *device;
+  bool streaming{false};
+  // the keep-alive silence is what reaches the device first
+  bool fill{false};
 };
 
 struct SinkReply
@@ -0,7 +0,8 @@
   void SetSilenceTimer();
   bool NeedIECPacking();
 
-  unsigned int OutputSamples(CSampleBuffer* samples);
+  // with `filled`, adds the frames the device took and leaves the delay unreported
+  unsigned int OutputSamples(CSampleBuffer* samples, unsigned int* filled = nullptr);
   void ReportDelay();
   void SwapInit(CSampleBuffer* samples);
 
