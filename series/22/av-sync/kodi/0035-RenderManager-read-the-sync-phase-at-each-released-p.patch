@@ -0,7 +0,9 @@
   if (!m_showVideo && !m_forceNext)
     return;
 
-  const double frameOnScreen = m_dvdClock.GetClock();
+  const double frameOnScreen = m_dvdClock.GetClock(m_releaseClockEpoch);
