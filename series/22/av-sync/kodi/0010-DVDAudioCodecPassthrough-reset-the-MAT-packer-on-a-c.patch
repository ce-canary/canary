From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 1 Nov 2026 07:16:56 -0600
Subject: [PATCH] DVDAudioCodecPassthrough: reset the MAT packer on a codec
 reset

A codec reset left the MAT packer's state and partly filled buffer in
place. The first frame after a seek then carried bytes from before it,
and its units were padded from the old frame time or taken as a
seamless branch.
---
 xbmc/cores/AudioEngine/Utils/PackerMAT.cpp                | 8 ++++++++
 xbmc/cores/AudioEngine/Utils/PackerMAT.h                  | 1 +
 .../DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp          | 2 ++
 3 files changed, 11 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Utils/PackerMAT.cpp b/xbmc/cores/AudioEngine/Utils/PackerMAT.cpp
--- a/xbmc/cores/AudioEngine/Utils/PackerMAT.cpp
+++ b/xbmc/cores/AudioEngine/Utils/PackerMAT.cpp
@@ -0,6 +0,14 @@
   return buffer;
 }
 
+void CPackerMAT::Reset()
+{
+  m_state = {};
+  m_buffer.clear();
+  m_bufferCount = 0;
+  m_outputQueue.clear();
+}
+
 void CPackerMAT::WriteHeader()
 {
   m_buffer.resize(MAT_BUFFER_SIZE);
diff --git a/xbmc/cores/AudioEngine/Utils/PackerMAT.h b/xbmc/cores/AudioEngine/Utils/PackerMAT.h
--- a/xbmc/cores/AudioEngine/Utils/PackerMAT.h
+++ b/xbmc/cores/AudioEngine/Utils/PackerMAT.h
@@ -0,6 +0,7 @@
 
   bool PackTrueHD(const uint8_t* data, int size);
   std::vector<uint8_t> GetOutputFrame();
+  void Reset();
 
 private:
   struct MATState
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
@@ -0,6 +0,8 @@
   m_currentPts = DVD_NOPTS_VALUE;
   m_nextPts = DVD_NOPTS_VALUE;
   m_parser.Reset();
+  if (m_packerMAT)
+    m_packerMAT->Reset();
 }
 
 int CDVDAudioCodecPassthrough::GetBufferSize()
