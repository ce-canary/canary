From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 1 Nov 2026 09:24:08 -0600
Subject: [PATCH] ApplicationPlayer: announce when a delay change is finished

A client that follows a delay through Player.OnPropertyChanged sees each
step of a slider or a settings dialog, but not which value the user kept.
Only a guess with a timer tells a step from the end of the change.
---
 xbmc/application/ApplicationPlayer.cpp        | 16 +++++++++--
 xbmc/application/ApplicationPlayer.h          |  9 ++++++-
 xbmc/interfaces/json-rpc/schema/methods.json  |  3 ++-
 .../json-rpc/schema/notifications.json        | 27 +++++++++++++++++++
 xbmc/video/PlayerController.cpp               | 20 +++++++++++++-
 xbmc/video/PlayerController.h                 |  1 +
 .../dialogs/GUIDialogSubtitleSettings.cpp     | 15 +++++++++++
 .../video/dialogs/GUIDialogSubtitleSettings.h |  2 ++
 8 files changed, 88 insertions(+), 5 deletions(-)

diff --git a/xbmc/application/ApplicationPlayer.cpp b/xbmc/application/ApplicationPlayer.cpp
--- a/xbmc/application/ApplicationPlayer.cpp
+++ b/xbmc/application/ApplicationPlayer.cpp
@@ -0,8 +0,20 @@
 void CApplicationPlayer::CommitAVDelay()
 {
   std::shared_ptr<IPlayer> player = GetInternal();
-  if (player)
-    player->CommitAVDelay();
+  if (!player)
+    return;
+
+  player->CommitAVDelay();
+
+  AnnounceDelay("OnPropertyChangeFinished", "audiodelay", GetVideoSettings().m_AudioDelay);
+}
+
+void CApplicationPlayer::CommitSubTitleDelay()
+{
+  if (!HasPlayer())
+    return;
+
+  AnnounceDelay("OnPropertyChangeFinished", "subtitledelay", GetVideoSettings().m_SubtitleDelay);
 }
 
 void CApplicationPlayer::SetDynamicRangeCompression(long drc)
