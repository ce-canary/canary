From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 2 Nov 2026 13:53:53 -0600
Subject: [PATCH] ActiveAESink: read the device delay when a buffer writes
 nothing

Only a passthrough packet without IEC packing read the device delay
when it wrote no frames. A PCM buffer emptied by a sync skip or an
IEC-packed skipped packet reported a delay of zero. The play timeout
then fired at once and wrote one period of keep-alive silence into the
stream. The audio stayed late by that period, below every threshold.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAESink.cpp     | 11 ++++-------
 1 file changed, 4 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -0,15 +0,12 @@
       m_stats->UpdateSinkDelay(status, samples->pool ? written : 0);
   }
 
+  // a skipped packet or an emptied buffer writes nothing, the device still holds what it had
+  if (totalFrames == 0)
+    m_sink->GetDelay(status);
+
   if (m_requestedFormat.m_dataFormat == AE_FMT_RAW)
-  {
-    // A packet dropped for a/v sync has no frames and never enters the loop above. Query the
-    // sink anyway, otherwise the engine is told the sink holds no audio at all and the next
-    // sync error measurements are off by the whole sink delay.
-    if (!m_needIecPack && totalFrames == 0)
-      m_sink->GetDelay(status);
     m_stats->UpdateSinkDelay(status, rawPackets, rawPauseMs);
-  }
 
   return status.delay * 1000;
 }
