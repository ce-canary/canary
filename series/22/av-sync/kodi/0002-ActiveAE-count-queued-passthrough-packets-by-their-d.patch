-  int framesOrPackets;
-
   while (frames > 0)
   {
     maxFrames = std::min(frames, m_sinkFormat.m_frames);
@@ -0,10 +0,10 @@
         m_extError = true;
         CLog::Log(LOGERROR, "CActiveAESink::OutputSamples - failed");
         status.SetDelay(0);
-        framesOrPackets = frames;
         if (m_requestedFormat.m_dataFormat == AE_FMT_RAW)
