From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 31 Oct 2026 23:54:44 -0500
Subject: [PATCH] VideoPlayer: tell the audio player which resync follows a
 seek

---
 xbmc/cores/VideoPlayer/IVideoPlayer.h       |  7 +++++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp      | 14 +++++++++++---
 xbmc/cores/VideoPlayer/VideoPlayer.h        |  2 ++
 xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp |  3 ++-
 4 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/IVideoPlayer.h b/xbmc/cores/VideoPlayer/IVideoPlayer.h
--- a/xbmc/cores/VideoPlayer/IVideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/IVideoPlayer.h
@@ -0,6 +0,13 @@
   bool timestampPending{false};
 };
 
+struct SResyncMsg
+{
+  double clock;
+  // the streams start after a seek
+  bool seekStart;
+};
+
 struct SStateMsg
 {
   IDVDStreamPlayer::ESyncState syncState;
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -0,7 +0,9 @@
       m_CurrentAudio.syncState = IDVDStreamPlayer::SYNC_INSYNC;
       m_CurrentAudio.avsync = CCurrentStream::AV_SYNC_NONE;
       m_VideoPlayerAudio->SendMessage(
-          std::make_shared<CDVDMsgDouble>(CDVDMsg::GENERAL_RESYNC, m_clock.GetClock()), 1);
+          std::make_shared<CDVDMsgType<SResyncMsg>>(CDVDMsg::GENERAL_RESYNC,
+                                                    SResyncMsg{m_clock.GetClock(), false}),
+          1);
     }
     else if (syncVideo)
     {
@@ -0,8 +0,10 @@
       m_CurrentVideo.syncState = IDVDStreamPlayer::SYNC_INSYNC;
       m_CurrentVideo.avsync = CCurrentStream::AV_SYNC_NONE;
       m_CurrentVideo.starttimePending = false;
-      m_VideoPlayerAudio->SendMessage(
-          std::make_shared<CDVDMsgDouble>(CDVDMsg::GENERAL_RESYNC, clock), 1);
+      m_VideoPlayerAudio->SendMessage(std::make_shared<CDVDMsgType<SResyncMsg>>(
+                                          CDVDMsg::GENERAL_RESYNC, SResyncMsg{clock, m_seekStart}),
+                                      1);
+      m_seekStart = false;
       m_VideoPlayerVideo->SendMessage(
           std::make_shared<CDVDMsgDouble>(CDVDMsg::GENERAL_RESYNC, clock), 1);
       SetCaching(CACHESTATE_DONE);
@@ -0,6 +0,7 @@
         m_State.lastSeek = m_clock.GetAbsoluteClock();
 
         FlushBuffers(start, accurate, msg.GetSync());
+        m_seekStart = msg.GetSync();
         CLog::Log(LOGDEBUG, LOGVIDEO, "CVideoPlayer::HandleMessages: flush buffers: dts:{:.3f} lastSeek:{:.3f} clock:{:.3f}", start / 1000000., m_State.lastSeek / 1000000.0, m_clock.GetClock() / 1000000.0);
       }
       else if (m_pDemuxer)
@@ -0,6 +0,7 @@
         m_State.dts = start;
 
         FlushBuffers(start, false, true);
+        m_seekStart = true;
         if (m_playSpeed != DVD_PLAYSPEED_PAUSE)
         {
           SetPlaySpeed(DVD_PLAYSPEED_NORMAL);
@@ -0,6 +0,7 @@
       const auto FinishChapterSeek = [this, &offset, &start, &newChapter, &seekDone, beforeSeek]()
       {
         FlushBuffers(start, true, true);
+        m_seekStart = true;
         if (start != DVD_NOPTS_VALUE)
         {
           const int64_t targetTime{
@@ -0,6 +0,7 @@
 void CVideoPlayer::FlushBuffers(double pts, bool accurate, bool sync)
 {
   m_syncStartPtsWait.reset();
+  m_seekStart = false;
   m_navTail = false;
   m_lastVideoTitleTime = DVD_NOPTS_VALUE;
 #if defined(HAVE_LIBBLURAY)
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -0,6 +0,8 @@
   XbmcThreads::EndTime<> m_syncTimer;
 
   std::optional<std::chrono::steady_clock::time_point> m_syncStartPtsWait;
+  //! Set by the seek and chapter handlers after their flush, cleared by every flush
+  bool m_seekStart{false};
 
   std::optional<std::chrono::steady_clock::time_point> m_syncWait;
   bool m_navTail{false};
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
@@ -0,7 +0,8 @@
     }
     else if (pMsg->IsType(CDVDMsg::GENERAL_RESYNC))
     { //player asked us to set internal clock
-      double pts = std::static_pointer_cast<CDVDMsgDouble>(pMsg)->m_value;
+      const SResyncMsg resync{std::static_pointer_cast<CDVDMsgType<SResyncMsg>>(pMsg)->m_value};
+      double pts = resync.clock;
       CLog::Log(LOGDEBUG, LOGAUDIO, "CVideoPlayerAudio - CDVDMsg::GENERAL_RESYNC({:.3f} level: {:d} cache:{:.3f}",
                 pts / DVD_TIME_BASE, m_messageQueue.GetLevel(), m_audioSink.GetDelay() / DVD_TIME_BASE);
 
