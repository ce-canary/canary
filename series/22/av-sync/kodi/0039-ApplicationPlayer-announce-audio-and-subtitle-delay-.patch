From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 1 Nov 2026 09:23:22 -0600
Subject: [PATCH] ApplicationPlayer: announce audio and subtitle delay changes

JSON-RPC clients that show or follow the audio or subtitle delay have to
poll for it. Player.OnPropertyChanged already reports the subtitle
visibility, but not the two delays, and Player.GetProperties lacks them.
---
 xbmc/application/ApplicationPlayer.cpp        | 21 ++++++++++
 xbmc/interfaces/json-rpc/PlayerOperations.cpp | 38 +++++++++++++++++++
 xbmc/interfaces/json-rpc/schema/types.json    | 10 ++++-
 xbmc/interfaces/json-rpc/schema/version.txt   |  2 +-
 4 files changed, 69 insertions(+), 2 deletions(-)

diff --git a/xbmc/application/ApplicationPlayer.cpp b/xbmc/application/ApplicationPlayer.cpp
--- a/xbmc/application/ApplicationPlayer.cpp
+++ b/xbmc/application/ApplicationPlayer.cpp
@@ -0,6 +0,7 @@
 
 #include "ApplicationPlayer.h"
 
+#include "PlayListPlayer.h"
 #include "ServiceBroker.h"
 #include "cores/DataCacheCore.h"
 #include "cores/IPlayer.h"
@@ -0,8 +0,10 @@
 #include "cores/playercorefactory/PlayerCoreFactory.h"
 #include "guilib/GUIComponent.h"
 #include "guilib/GUIWindowManager.h"
+#include "interfaces/AnnouncementManager.h"
 #include "settings/AdvancedSettings.h"
 #include "settings/SettingsComponent.h"
+#include "utils/Variant.h"
 #include "video/VideoFileItemClassify.h"
 
 #include <mutex>
@@ -0,6 +0,18 @@
 using namespace KODI;
 using namespace std::chrono_literals;
 
+namespace
+{
+void AnnounceDelay(const std::string& message, const std::string& property, float value)
+{
+  CVariant data;
+  data["player"]["playerid"] =
+      static_cast<int>(CServiceBroker::GetPlaylistPlayer().GetCurrentPlaylist());
+  data["property"][property] = value;
+  CServiceBroker::GetAnnouncementManager()->Announce(ANNOUNCEMENT::Player, message, data);
+}
+} // namespace
+
 std::shared_ptr<const IPlayer> CApplicationPlayer::GetInternal() const
 {
   std::unique_lock lock(m_playerLock);
@@ -0,14 +0,20 @@
 {
   std::shared_ptr<IPlayer> player = GetInternal();
   if (player)
+  {
     player->SetSubTitleDelay(fValue);
+    AnnounceDelay("OnPropertyChanged", "subtitledelay", fValue);
+  }
 }
 
 void CApplicationPlayer::SetAVDelay(float fValue)
 {
   std::shared_ptr<IPlayer> player = GetInternal();
   if (player)
+  {
     player->SetAVDelay(fValue);
+    AnnounceDelay("OnPropertyChanged", "audiodelay", fValue);
+  }
 }
 
 void CApplicationPlayer::CommitAVDelay()
diff --git a/xbmc/interfaces/json-rpc/PlayerOperations.cpp b/xbmc/interfaces/json-rpc/PlayerOperations.cpp
--- a/xbmc/interfaces/json-rpc/PlayerOperations.cpp
+++ b/xbmc/interfaces/json-rpc/PlayerOperations.cpp
@@ -0,6 +0,44 @@
   }
   else if (property == "live")
     result = IsPVRChannel();
+  else if (property == "audiodelay")
+  {
+    switch (player)
+    {
+      case Video:
+      {
+        auto& components = CServiceBroker::GetAppComponents();
+        const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+        result = appPlayer->GetVideoSettings().m_AudioDelay;
+        break;
+      }
+
+      case Audio:
+      case Picture:
+      default:
+        result = 0.0;
+        break;
+    }
+  }
+  else if (property == "subtitledelay")
+  {
+    switch (player)
+    {
+      case Video:
+      {
+        auto& components = CServiceBroker::GetAppComponents();
+        const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+        result = appPlayer->GetVideoSettings().m_SubtitleDelay;
+        break;
+      }
+
+      case Audio:
+      case Picture:
+      default:
+        result = 0.0;
+        break;
+    }
+  }
   else
     return InvalidParams;
 
diff --git a/xbmc/interfaces/json-rpc/schema/types.json b/xbmc/interfaces/json-rpc/schema/types.json
--- a/xbmc/interfaces/json-rpc/schema/types.json
+++ b/xbmc/interfaces/json-rpc/schema/types.json
@@ -0,7 +0,9 @@
       "live",
       "currentvideostream",
       "videostreams",
-      "cachepercentage"
+      "cachepercentage",
+      "audiodelay",
+      "subtitledelay"
     ]
   },
   "Player.Property.Value": {
@@ -0,6 +0,12 @@
       },
       "cachepercentage": {
         "$ref": "Player.Position.Percentage"
+      },
+      "audiodelay": {
+        "type": "number"
+      },
+      "subtitledelay": {
+        "type": "number"
       }
     }
   },
diff --git a/xbmc/interfaces/json-rpc/schema/version.txt b/xbmc/interfaces/json-rpc/schema/version.txt
--- a/xbmc/interfaces/json-rpc/schema/version.txt
+++ b/xbmc/interfaces/json-rpc/schema/version.txt
@@ -0 +0 @@
-JSONRPC_VERSION 13.2000.0
+JSONRPC_VERSION 13.2001.0
