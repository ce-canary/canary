 {
   MOVING_SPEED::EventCfg eventCfg{100.0f, 300.0f, 200};
@@ -0,6 +0,8 @@
         vs.m_AudioDelay -= videoAudioDelayStep;
         if (vs.m_AudioDelay < -videoAudioDelayRange)
           vs.m_AudioDelay = -videoAudioDelayRange;
