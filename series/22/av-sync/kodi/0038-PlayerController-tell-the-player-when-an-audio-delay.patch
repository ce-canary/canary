+{
+bool IsAudioDelayAction(int action)
+{
+  return action == ACTION_AUDIO_DELAY || action == ACTION_AUDIO_DELAY_MIN ||
+         action == ACTION_AUDIO_DELAY_PLUS;
+}
+} // namespace
+
