From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sun, 1 Nov 2026 09:24:29 -0600
Subject: [PATCH] PlayerController: tell the player when an audio delay change
 ends

A player may apply part of an audio delay change only once the user
has settled on a value, when doing it per step would interrupt the
sound. It has no way to learn that a slider, a dialog or a
Player.SetAudioDelay change has ended.
---
 xbmc/application/ApplicationPlayer.cpp        |  7 +++++
 xbmc/application/ApplicationPlayer.h          |  6 ++++
 xbmc/cores/IPlayer.h                          |  5 ++++
 xbmc/dialogs/GUIDialogSlider.cpp              |  2 ++
 xbmc/guilib/ISliderCallback.h                 |  7 +++++
 xbmc/interfaces/json-rpc/PlayerOperations.cpp |  2 ++
 xbmc/video/PlayerController.cpp               | 30 +++++++++++++++++++
 xbmc/video/PlayerController.h                 |  6 ++++
 xbmc/video/dialogs/GUIDialogAudioSettings.cpp | 15 ++++++++++
 xbmc/video/dialogs/GUIDialogAudioSettings.h   |  2 ++
 10 files changed, 82 insertions(+)

diff --git a/xbmc/application/ApplicationPlayer.cpp b/xbmc/application/ApplicationPlayer.cpp
--- a/xbmc/application/ApplicationPlayer.cpp
+++ b/xbmc/application/ApplicationPlayer.cpp
@@ -0,6 +0,13 @@
     player->SetAVDelay(fValue);
 }
 
+void CApplicationPlayer::CommitAVDelay()
+{
+  std::shared_ptr<IPlayer> player = GetInternal();
+  if (player)
+    player->CommitAVDelay();
+}
+
 void CApplicationPlayer::SetDynamicRangeCompression(long drc)
 {
   std::shared_ptr<IPlayer> player = GetInternal();
