   void SetAudioStream(int iStream);
   void SetAVDelay(float fValue = 0.0f);
+
+  /*!
+   * \brief Ends an interactive change of the audio delay: the player applies it
+   */
+  void CommitAVDelay();
+
   void SetBookmarks(const std::vector<std::chrono::milliseconds>& bookmarks);
   void SetDynamicRangeCompression(long drc);
   void SetMute(bool bOnOff);
diff --git a/xbmc/cores/IPlayer.h b/xbmc/cores/IPlayer.h
--- a/xbmc/cores/IPlayer.h
+++ b/xbmc/cores/IPlayer.h
@@ -0,6 +0,11 @@
   virtual void SetAVDelay(float fValue = 0.0f) {}
   virtual float GetAVDelay() { return 0.0f; }
 
+  /*!
+   * \brief The interactive change of the audio delay has finished, at the value last set
+   */
+  virtual void CommitAVDelay() {}
+
   virtual void SetSubTitleDelay(float fValue = 0.0f) {}
   virtual float GetSubTitleDelay()    { return 0.0f; }
   virtual int GetSubtitleCount() const { return 0; }
