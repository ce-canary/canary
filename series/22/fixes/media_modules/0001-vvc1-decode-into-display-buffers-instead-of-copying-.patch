From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 12 Nov 2026 15:20:30 -0600
Subject: [PATCH] vvc1: decode into display buffers instead of copying frames

The ucode decodes into 4 slots, too few to leave frames with display.
Progressive frames were therefore copied by the CPU into a second pool
at vf_get, without cache maintenance and after the slot was released,
so moving pictures showed stale blocks. Interlaced kept the 4 slots.
---
 drivers/frame_provider/decoder/vc1/vvc1.c | 142 +++++++++++-----------
 1 file changed, 74 insertions(+), 68 deletions(-)

diff --git a/drivers/frame_provider/decoder/vc1/vvc1.c b/drivers/frame_provider/decoder/vc1/vvc1.c
--- a/drivers/frame_provider/decoder/vc1/vvc1.c
+++ b/drivers/frame_provider/decoder/vc1/vvc1.c
@@ -0,9 +0,10 @@
 
 #define VF_POOL_SIZE		32
 #define DECODE_BUFFER_NUM_MAX	4
-#define COPY_DECODE_BUFFER_NUM_MAX 32
+/* every vframe, two anchors and the decode target */
+#define FRAME_BUFFER_NUM_MAX	(VF_POOL_SIZE + 3)
 #define WORKSPACE_SIZE		(2 * SZ_1M)
-#define MAX_BMMU_BUFFER_NUM	(DECODE_BUFFER_NUM_MAX + COPY_DECODE_BUFFER_NUM_MAX + 1)
+#define MAX_BMMU_BUFFER_NUM	(FRAME_BUFFER_NUM_MAX + 1)
 #define VF_BUFFER_IDX(n)	(1 + n)
 #define DCAC_BUFF_START_ADDR	0x01f00000
 #define RP_WORKAROUND_SIZE  SZ_4K
@@ -0,7 +0,7 @@
 static bool is_irq_cancel;
 static struct work_struct set_clk_work;
 static struct work_struct error_wd_work;
-static struct canvas_config_s vc1_canvas_config[DECODE_BUFFER_NUM_MAX + COPY_DECODE_BUFFER_NUM_MAX][3];
+static struct canvas_config_s vc1_canvas_config[FRAME_BUFFER_NUM_MAX][3];
 spinlock_t vc1_rp_lock;
 
 #ifdef DEBUG_PTS
@@ -0,10 +0,12 @@
 	u32 picture_type;
 	unsigned short decode_pic_count;
 	u32 repeat_cnt;
+	u32 slot;
+	atomic_t pending;
 };
 
 struct vdec_vc1_hw_s {
-	s32 vfbuf_use[DECODE_BUFFER_NUM_MAX + COPY_DECODE_BUFFER_NUM_MAX];
+	s32 vfbuf_use[FRAME_BUFFER_NUM_MAX];
 	unsigned char again_flag;
 	unsigned char recover_flag;
 	u32 frame_width;
@@ -0,10 +0,12 @@
 
 	s32 refs[2];
 
-	s32 ref_use[DECODE_BUFFER_NUM_MAX];
-	s32 buf_use[DECODE_BUFFER_NUM_MAX];
+	s32 ref_use[FRAME_BUFFER_NUM_MAX];
+	s32 buf_use[FRAME_BUFFER_NUM_MAX];
 	u32 decoding_index;
-	struct pic_info_t pics[DECODE_BUFFER_NUM_MAX];
+	struct pic_info_t pics[FRAME_BUFFER_NUM_MAX];
+	s32 slot_buf[DECODE_BUFFER_NUM_MAX];
+	bool target_outstanding;
 	u32 interlace_flag;
 	u32 new_type;
 	u32 canvas_mode;
@@ -0,6 +0,10 @@
 {
 	int i;
 
+	/* an interlaced picture takes two vframes */
+	if (kfifo_len(&newframe_q) < 2)
+		return INVALID_IDX;
+
 	for (i = 0; i < hw->vf_buf_num_used; i++) {
 		vc1_print(0, VC1_DEBUG_DETAIL,"%s: i %d, vfbuf_use %d, ref_use %d, buf_use %d\n", __func__,
 			i, hw->vfbuf_use[i], hw->ref_use[i], hw->buf_use[i]);
@@ -0,14 +0,38 @@
 {
 	u32 index = -1;
 	u32 canvas1_info = 0;
+	u32 freed = 0;
+	int slot;
+
+	/* a slot frees once the display took its picture; this paces decoding to display */
+	for (slot = 0; slot < DECODE_BUFFER_NUM_MAX; slot++) {
+		s32 buf = hw->slot_buf[slot];
+
+		if (buf != -1 && !hw->ref_use[buf] &&
+			!atomic_read(&hw->pics[buf].pending) &&
+			!(hw->target_outstanding && buf == hw->decoding_index)) {
+			hw->slot_buf[slot] = -1;
+			freed |= 1 << slot;
+		}
+	}
+	if (freed)
+		WRITE_VREG(VC1_BUFFERIN, ~freed);
+
 	index = find_free_buffer(hw);
-	if (index == INVALID_IDX) {
+	for (slot = 0; slot < DECODE_BUFFER_NUM_MAX; slot++) {
+		if (hw->slot_buf[slot] == -1)
+			break;
+	}
+	if (index == INVALID_IDX || slot == DECODE_BUFFER_NUM_MAX) {
 		WRITE_VREG(CANVAS_BUF_REG, 0xff);
 		return -1;
 	}
 	hw->decoding_index = index;
 	hw->buf_use[hw->decoding_index]++;
-	canvas1_info = (index2canvas(index) << 8) | index;
+	hw->slot_buf[slot] = index;
+	hw->pics[index].slot = slot;
+	hw->target_outstanding = true;
+	canvas1_info = (index2canvas(index) << 8) | slot;
 	vc1_print(0, VC1_DEBUG_DETAIL,"%s: decoding_index %d, buf_use %d, canvas1_info 0x%x\n",
 		__func__, index, hw->buf_use[hw->decoding_index], canvas1_info);
 	WRITE_VREG(CANVAS_BUF_REG, canvas1_info);
@@ -0,7 +0,7 @@
 		vf->type_original = vf->type;
 		set_aspect_ratio(vf, READ_VREG(VC1_PIC_RATIO));
 
-		hw->vfbuf_use[buffer_index]++;
+		hw->vfbuf_use[buffer_index] += 2;
 		vf->mem_handle =
 			decoder_bmmu_box_get_mem_handle(
 				mm_blk_handle,
@@ -0,6 +0,7 @@
 		if (without_display_mode) {
 			vvc1_vf_put(vf, vdec);
 		} else {
+			atomic_inc(&pic->pending);
 			kfifo_put(&display_q, (const struct vframe_s *)vf);
 			ATRACE_COUNTER(MODULE_NAME, vf->pts);
 
@@ -0,7 +0,6 @@
 		vf->type_original = vf->type;
 		set_aspect_ratio(vf, READ_VREG(VC1_PIC_RATIO));
 
-		hw->vfbuf_use[buffer_index]++;
 		vf->mem_handle =
 			decoder_bmmu_box_get_mem_handle(
 				mm_blk_handle,
@@ -0,6 +0,7 @@
 		if (without_display_mode) {
 			vvc1_vf_put(vf, vdec);
 		} else {
+			atomic_inc(&pic->pending);
 			kfifo_put(&display_q, (const struct vframe_s *)vf);
 			ATRACE_COUNTER(MODULE_NAME, vf->pts);
 			vf_notify_receiver(
@@ -0,6 +0,7 @@
 		if (without_display_mode) {
 			vvc1_vf_put(vf, vdec);
 		} else {
+			atomic_inc(&pic->pending);
 			kfifo_put(&display_q, (const struct vframe_s *)vf);
 			ATRACE_COUNTER(MODULE_NAME, vf->pts);
 
@@ -0,6 +0,9 @@
 	int ret;
 	bool is_bi_type;
 
+	if (is_irq_cancel)
+		return IRQ_HANDLED;
+
 	debug_tag = READ_VREG(DEBUG_REG1);
 	if (debug_tag != 0) {
 		vc1_print(0, 0, "%s: dbg%x: %x, wp 0x%x, rp 0x%x\n", __func__,
@@ -0,7 +0,8 @@
 		}
 
 		repeat_count = READ_VREG(VC1_REPEAT_COUNT);
-		buffer_index = ((reg & 0x7) - 1) & 3;
+		buffer_index = hw->decoding_index;
+		hw->target_outstanding = false;
 		is_bi_type = (reg >> 8) & 0x1;
 		if (is_bi_type)
 			picture_type = B_PICTURE + 1;//BI, should set as B_PICTURE
@@ -0,10 +0,9 @@
 			vvc1_amstream_dec_info.rate = PTS2DUR(frm.rate);
 
 		if (hw->throw_pb_flag && picture_type != I_PICTURE) {
-				vc1_print(0, VC1_DEBUG_DETAIL, "%s: WRITE_VREG(VC1_BUFFERIN, 0x%x) decoding_index %d, for throwing picture with type of %d\n",
-					__func__, ~(1 << hw->decoding_index), hw->decoding_index, picture_type);
+				vc1_print(0, VC1_DEBUG_DETAIL, "%s: decoding_index %d, for throwing picture with type of %d\n",
+					__func__, hw->decoding_index, picture_type);
 
-				WRITE_VREG(VC1_BUFFERIN, ~(1 << hw->decoding_index));
 				hw->buf_use[hw->decoding_index]--;
 				vc1_print(0, VC1_DEBUG_DETAIL,"%s: index %d, buf_use %d, buffer_index %d\n",
 					__func__, hw->decoding_index, hw->buf_use[hw->decoding_index], buffer_index);
@@ -0,7 +0,6 @@
 					/* drop b frame before reference pic ready */
 					if (hw->refs[0] == -1) {
 						buffer_index = hw->vf_buf_num_used;
-						WRITE_VREG(VC1_BUFFERIN, ~(1 << hw->decoding_index));
 						hw->buf_use[hw->decoding_index]--;
 						vc1_print(0, VC1_DEBUG_DETAIL,"%s: decoding_index %d, buf_use %d\n",
 							__func__, hw->decoding_index, hw->buf_use[hw->decoding_index]);
@@ -0,45 +0,8 @@
 
 	if (kfifo_get(&display_q, &vf)) {
 		struct vdec_vc1_hw_s *hw = &vc1_hw;
-		if (!hw->interlace_flag) {
-			u32 buffer_index, i;
-
-			for (i = 0; i < COPY_DECODE_BUFFER_NUM_MAX; i++) {
-				buffer_index = i + DECODE_BUFFER_NUM_MAX;
-				if (!hw->vfbuf_use[buffer_index]) {
-					break;
-				}
-			}
-
-			if (i == COPY_DECODE_BUFFER_NUM_MAX) {
-				pr_err("vc1: shouldn't happen, but couldn't find a free vbuf!\n");
-				kfifo_put(&recycle_q, vf);
-				return NULL;
-			}
-
-			vc1_print(0, VC1_DEBUG_DETAIL,"%s: copy frame from index %d to %d\n",
-				__func__, vf->index, buffer_index);
-
-			hw->vfbuf_use[buffer_index]++;
-
-			if (--hw->vfbuf_use[vf->index] == 0) {
-				WRITE_VREG(VC1_BUFFERIN, ~(1 << vf->index));
-				hw->buf_use[vf->index]--;
-			}
-
-			memcpy(decoder_bmmu_box_get_virt_addr(mm_blk_handle, buffer_index),
-			       decoder_bmmu_box_get_virt_addr(mm_blk_handle, vf->index),
-			       decoder_bmmu_box_get_mem_size(mm_blk_handle, vf->index));
-			vf->canvas0Addr = vf->canvas1Addr = index2canvas(buffer_index);
-			if (is_support_vdec_canvas()) {
-				vf->canvas0Addr = vf->canvas1Addr = -1;
-				vf->canvas0_config[0] = vc1_canvas_config[buffer_index][0];
-				vf->canvas0_config[1] = vc1_canvas_config[buffer_index][1];
-			}
-			vf->mem_handle = decoder_bmmu_box_get_mem_handle(mm_blk_handle, buffer_index);
-			vf->index = buffer_index;
-		}
 
+		atomic_dec(&hw->pics[vf->index].pending);
 		return vf;
 	}
 
@@ -0,11 +0,6 @@
 
 static void vvc1_vf_put(struct vframe_s *vf, void *op_arg)
 {
-	if (vf->index >= DECODE_BUFFER_NUM_MAX)
-	{
-		struct vdec_vc1_hw_s *hw = &vc1_hw;
-		hw->vfbuf_use[vf->index]--;
-	}
 	kfifo_put(&recycle_q, (const struct vframe_s *)vf);
 }
 
@@ -0,6 +0,7 @@
 static void vvc1_local_init(bool is_reset)
 {
 	struct vdec_vc1_hw_s *hw = &vc1_hw;
+	u32 slot = hw->pics[hw->decoding_index].slot;
 	int i;
 	vc1_print(0, VC1_DEBUG_DETAIL,"%s \n", __func__);
 
@@ -0,7 +0,6 @@
 	saved_resolution = 0;
 	frame_width = frame_height = frame_dur = 0;
 	process_busy = false;
-	is_irq_cancel = false;
 #ifdef DEBUG_PTS
 	pts_hit = pts_missed = pts_i_hit = pts_i_missed = 0;
 #endif
@@ -0,21 +0,22 @@
 	memset(&frm, 0, sizeof(frm));
 
 	if (!is_reset) {
+		is_irq_cancel = false;
 		hw->refs[0] = -1;
 		hw->refs[1] = -1;
 		hw->throw_pb_flag = 1;
-		hw->vf_buf_num_used = DECODE_BUFFER_NUM_MAX;
+		hw->vf_buf_num_used = FRAME_BUFFER_NUM_MAX;
 		hw->frame_width = 0;
 		hw->frame_height = 0;
 
-		for (i = 0; i < hw->vf_buf_num_used + COPY_DECODE_BUFFER_NUM_MAX; i++) {
+		for (i = 0; i < hw->vf_buf_num_used; i++) {
 			hw->vfbuf_use[i] = 0;
-			if (i < DECODE_BUFFER_NUM_MAX)
-			{
-				hw->buf_use[i] = 0;
-				hw->ref_use[i] = 0;
-			}
+			hw->buf_use[i] = 0;
+			hw->ref_use[i] = 0;
+			atomic_set(&hw->pics[i].pending, 0);
 		}
+		for (i = 0; i < DECODE_BUFFER_NUM_MAX; i++)
+			hw->slot_buf[i] = -1;
 
 		INIT_KFIFO(display_q);
 		INIT_KFIFO(recycle_q);
@@ -0,11 +0,16 @@
 			const struct vframe_s *vf;
 
 			vf = &vfpool[i];
-			vfpool[i].index = DECODE_BUFFER_NUM_MAX;
+			vfpool[i].index = hw->vf_buf_num_used;
 
 			kfifo_put(&newframe_q, (const struct vframe_s *)vf);
 		}
+	} else if (hw->target_outstanding) {
+		/* release the target the stopped ucode was decoding */
+		hw->slot_buf[slot] = -1;
+		hw->buf_use[hw->decoding_index]--;
 	}
+	hw->target_outstanding = false;
 
 	if (mm_blk_handle) {
 		decoder_bmmu_box_free(mm_blk_handle);
@@ -0,7 +0,9 @@
 {
 	vc1_print(0, VC1_DEBUG_DETAIL,"%s \n", __func__);
 
+	is_irq_cancel = true;
 	amvdec_stop();
+	vdec_sync_irq(VDEC_IRQ_1);
 	msleep(20);
 #ifdef CONFIG_AMLOGIC_POST_PROCESS_MANAGER
 	vvc1_ppmgr_reset();
@@ -0,6 +0,9 @@
 	vf_reg_provider(&vvc1_vf_prov);
 #endif
 	vvc1_prot_init();
+	/* wait out handlers of interrupts raised before the stop */
+	vdec_sync_irq(VDEC_IRQ_1);
+	is_irq_cancel = false;
 	amvdec_start();
 }
 
