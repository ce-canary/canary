From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Thu, 12 Nov 2026 19:14:23 -0600
Subject: [PATCH] ApplicationPlayer: read the stream indices again after an AV
 change

The audio and video stream indices are cached for one second and
refreshed only by a file open or Kodi's own stream pick. A stream the
player changes itself, such as a Blu-ray disc program's audio pick,
reads as the old one in OnAVChange listeners for up to a second.
---
 xbmc/application/ApplicationPlayer.cpp         | 6 ++++++
 xbmc/application/ApplicationPlayer.h           | 6 ++++++
 xbmc/application/ApplicationPlayerCallback.cpp | 1 +
 3 files changed, 13 insertions(+)

diff --git a/xbmc/application/ApplicationPlayer.cpp b/xbmc/application/ApplicationPlayer.cpp
--- a/xbmc/application/ApplicationPlayer.cpp
+++ b/xbmc/application/ApplicationPlayer.cpp
@@ -0,6 +0,12 @@
   m_pPlayer.reset();
 }
 
+void CApplicationPlayer::OnStreamChange()
+{
+  m_audioStreamUpdate.SetExpired();
+  m_videoStreamUpdate.SetExpired();
+}
+
 void CApplicationPlayer::CloseFile(bool reopen)
 {
   std::shared_ptr<IPlayer> player = GetInternal();
diff --git a/xbmc/application/ApplicationPlayer.h b/xbmc/application/ApplicationPlayer.h
--- a/xbmc/application/ApplicationPlayer.h
+++ b/xbmc/application/ApplicationPlayer.h
@@ -0,6 +0,12 @@
   // player management
   void ClosePlayer();
   void ResetPlayer();
+
+  /*!
+   * \brief Read the audio and video stream indices from the player again
+   */
+  void OnStreamChange();
+
   std::string GetCurrentPlayer() const;
   float GetPlaySpeed() const;
   float GetPlayTempo() const;
diff --git a/xbmc/application/ApplicationPlayerCallback.cpp b/xbmc/application/ApplicationPlayerCallback.cpp
--- a/xbmc/application/ApplicationPlayerCallback.cpp
+++ b/xbmc/application/ApplicationPlayerCallback.cpp
@@ -0,6 +0,7 @@
   CLog::LogF(LOGDEBUG, "call");
 
   CServiceBroker::GetGUI()->GetStereoscopicsManager().OnStreamChange();
+  CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>()->OnStreamChange();
 
   CGUIMessage msg(GUI_MSG_PLAYBACK_AVCHANGE, 0, 0);
   CServiceBroker::GetGUI()->GetWindowManager().SendThreadMessage(msg);
