From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 11 Nov 2026 20:11:30 -0600
Subject: [PATCH] VideoPlayer: fill the BT.2020 matrix of PQ and HLG streams

A PQ or HLG stream that leaves its colour space unspecified got BT.2020
only on the FFmpeg path, and only for Dolby Vision or a conversion to
it. An HDR10 or HLG stream without a matrix, and every such inputstream
stream, then got no HDR GUI composite and its PGS was drawn as SDR.
---
 .../cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp | 12 +++++++-----
 .../VideoPlayer/DVDInputStreams/InputStreamAddon.cpp |  5 +++++
 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -0,15 +0,11 @@
             if (sideData && sideData->size)
               st->dovi = *reinterpret_cast<const AVDOVIDecoderConfigurationRecord*>(sideData->data);
 
-            // base layers without backward compatibility are IPTPQc2, PQ and HLG ones are BT.2020
+            // base layers without backward compatibility are IPTPQc2
             if (st->dovi.dv_profile == 5 ||
                 ((st->dovi.dv_profile == 10 || st->dovi.dv_profile == 20) &&
                  st->dovi.dv_bl_signal_compatibility_id == 0))
               st->colorSpace = AVCOL_SPC_IPT_C2;
-            else if (st->colorSpace == AVCOL_SPC_UNSPECIFIED &&
-                     (st->colorTransferCharacteristic == AVCOL_TRC_SMPTE2084 ||
-                      st->colorTransferCharacteristic == AVCOL_TRC_ARIB_STD_B67))
-              st->colorSpace = AVCOL_SPC_BT2020_NCL;
 
             if (dv_by_vs_engine ||
                 aml_convert_to_hdr_by_vs_engine(st->hdr_type))
@@ -0,6 +0,12 @@
           }
         }
 
+        // PQ and HLG streams without a colour space are BT.2020
+        if (st->colorSpace == AVCOL_SPC_UNSPECIFIED &&
+            (st->colorTransferCharacteristic == AVCOL_TRC_SMPTE2084 ||
+             st->colorTransferCharacteristic == AVCOL_TRC_ARIB_STD_B67))
+          st->colorSpace = AVCOL_SPC_BT2020_NCL;
+
         sideData = av_packet_side_data_get(pStream->codecpar->coded_side_data,
                                            pStream->codecpar->nb_coded_side_data,
                                            AV_PKT_DATA_MASTERING_DISPLAY_METADATA);
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.cpp
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/InputStreamAddon.cpp
@@ -0,6 +0,11 @@
     else
       videoStream->hdr_type = StreamHdrType::HDR_TYPE_NONE;
 
+    if (videoStream->colorSpace == AVCOL_SPC_UNSPECIFIED &&
+        (videoStream->colorTransferCharacteristic == AVCOL_TRC_SMPTE2084 ||
+         videoStream->colorTransferCharacteristic == AVCOL_TRC_ARIB_STD_B67))
+      videoStream->colorSpace = AVCOL_SPC_BT2020_NCL;
+
     if (stream->m_masteringMetadata)
     {
       videoStream->masteringMetaData = std::make_shared<AVMasteringDisplayMetadata>();
