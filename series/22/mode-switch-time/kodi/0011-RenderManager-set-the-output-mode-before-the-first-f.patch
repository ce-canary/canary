 .../VideoRenderers/RenderManager.cpp          | 128 +++++++++++-------
 .../VideoRenderers/RenderManager.h            |   8 +-
 xbmc/utils/AMLUtils.cpp                       |  12 --
 xbmc/utils/AMLUtils.h                         |   1 -
 5 files changed, 90 insertions(+), 64 deletions(-)

