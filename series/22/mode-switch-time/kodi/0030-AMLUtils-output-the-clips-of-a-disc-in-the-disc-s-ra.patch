From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 9 Nov 2026 08:28:44 -0600
Subject: [PATCH] AMLUtils: output the clips of a disc in the disc's range

Each clip a disc's menus played was output in its own range, with the
user mappings applied. An SDR extra between Dolby Vision or HDR10 clips
switched the TV to SDR and back. A disc's main title gave no range to
keep.
---
 .../VideoPlayer/DVDCodecs/Video/AMLCodec.cpp  |  8 +-
 xbmc/utils/AMLCapture.cpp                     |  9 ++-
 xbmc/utils/AMLUtils.cpp                       | 74 +++++++++++++++----
 xbmc/utils/AMLUtils.h                         |  4 +
 4 files changed, 75 insertions(+), 20 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -0,10 +0,14 @@
   else
   {
     int forceOutput = FORCE_OUTPUT_DISABLED;
+    // the HDR10 clips of a disc session follow the source, only its SDR clips are lifted
+    const bool sdr2hdr = aml_disc_output_hdr_type()
+                             ? hints.hdrType == StreamHdrType::HDR_TYPE_NONE
+                             : settings->GetBool(CSettings::SETTING_COREELEC_AMLOGIC_SDR2HDR);
 
     outputWrites.emplace_back("dv_enable", 0);
-    if (settings->GetBool(CSettings::SETTING_COREELEC_AMLOGIC_SDR2HDR) &&
-        m_output.hdrType == StreamHdrType::HDR_TYPE_HDR10 && !m_processInfo.GetIsHdr10Plus())
+    if (sdr2hdr && m_output.hdrType == StreamHdrType::HDR_TYPE_HDR10 &&
+        !m_processInfo.GetIsHdr10Plus())
       forceOutput = FORCE_OUTPUT_BT2020_PQ;
     else if (settings->GetBool(CSettings::SETTING_COREELEC_AMLOGIC_HDR2SDR))
       forceOutput = FORCE_OUTPUT_BT709;
diff --git a/xbmc/utils/AMLCapture.cpp b/xbmc/utils/AMLCapture.cpp
--- a/xbmc/utils/AMLCapture.cpp
+++ b/xbmc/utils/AMLCapture.cpp
@@ -0,10 +0,13 @@
 
   bool sourcePQ = source.transfer == AVCOL_TRC_SMPTE2084;
   bool sourceHLG = source.transfer == AVCOL_TRC_ARIB_STD_B67;
-  // hdr2sdr and sdr2hdr rewrite the stream colour to the output colour; the demuxer keeps the type
+  // hdr2sdr and sdr2hdr give the picture the output colour; the stream keeps the source type
   const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
-  if (!source.dolbyVision && (settings->GetBool(CSettings::SETTING_COREELEC_AMLOGIC_HDR2SDR) ||
-                              settings->GetBool(CSettings::SETTING_COREELEC_AMLOGIC_SDR2HDR)))
+  const auto discTarget = aml_disc_output_hdr_type();
+  const bool sdr2hdr = discTarget ? *discTarget == StreamHdrType::HDR_TYPE_HDR10
+                                  : settings->GetBool(CSettings::SETTING_COREELEC_AMLOGIC_SDR2HDR);
+  if (!source.dolbyVision &&
+      (settings->GetBool(CSettings::SETTING_COREELEC_AMLOGIC_HDR2SDR) || sdr2hdr))
   {
     const auto& components = CServiceBroker::GetAppComponents();
     const auto appPlayer = components.GetComponent<CApplicationPlayer>();
