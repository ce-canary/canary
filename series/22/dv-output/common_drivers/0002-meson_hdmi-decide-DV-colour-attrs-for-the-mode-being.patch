From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 7 Nov 2026 09:06:18 -0600
Subject: [PATCH] meson_hdmi: decide DV colour attrs for the mode being set

The decide reads the engine's target, set against the mode being left.
A DV clip starting from a mode the sink refuses, such as 1080p120
without the parity bit, targets HDR10 then. The new mode gets non-DV
attrs, the engine returns to DV on a 10-bit pipe, and the AVI says 422
on a 30-bit pipe: a purple picture.
---
 drivers/drm/meson_hdmi.c                      | 28 ++++++++++++++-----
 .../media/enhancement/amdolby_vision/amdv.c   | 22 +++++++++++++--
 .../media/amdolbyvision/dolby_vision.h        |  1 +
 3 files changed, 41 insertions(+), 10 deletions(-)

diff --git a/drivers/drm/meson_hdmi.c b/drivers/drm/meson_hdmi.c
--- a/drivers/drm/meson_hdmi.c
+++ b/drivers/drm/meson_hdmi.c
@@ -0,12 +0,25 @@
 		return true;
 }
 
-static bool is_amdv_output_dv(void)
-{
-	int mode = get_amdv_target_mode();
+static bool is_amdv_output_dv(const struct drm_display_mode *drm_mode)
+{
+	bool interlaced = drm_mode->flags & DRM_MODE_FLAG_INTERLACE;
+	struct vout_device_s dev = { .dv_info = hdmitx_common_get_dv_info() };
+	struct vinfo_s next = {
+		.name = (char *)drm_mode->name,
+		.height = drm_mode->vdisplay,
+		.field_height = interlaced ? drm_mode->vdisplay / 2 : drm_mode->vdisplay,
+		.hdr_info = *hdmitx_common_get_hdr_info(),
+		.vout_device = &dev,
+	};
+	int mode;
+
+	if (!is_amdv_enable())
+		return false;
+
+	mode = get_amdv_mode_for(&next);
 
-	return is_amdv_enable() &&
-	       mode != AMDV_OUTPUT_MODE_HDR10 &&
+	return mode != AMDV_OUTPUT_MODE_HDR10 &&
 	       mode != AMDV_OUTPUT_MODE_SDR10 &&
 	       mode != AMDV_OUTPUT_MODE_SDR8;
 }
@@ -0,6 +0,7 @@
 	enum hdmi_vic vic;
 	char* colour_sampling[] = {"RGB","YUV422","YUV444","YUV420"};
 	struct hdmitx_color_attr fmt_attr = {};
+	bool dv_output = is_amdv_output_dv(&crtc_state->base.adjusted_mode);
 
 	if (!outputmode) {
 		DRM_ERROR("%s current mode empty.\n", __func__);
@@ -0,7 +0,7 @@
 	// try autoselect
 	// check if any colour subsampling is set
 	// force colour subsampling when DV mode
-	if (is_amdv_output_dv()) {
+	if (dv_output) {
 		int cs = attr->colorformat;
 		if (get_amdv_ll_policy() == 0 /* DOLBY_VISION_LL_DISABLE */) {
 			attr->colorformat = HDMI_COLORSPACE_YUV444;
@@ -0,7 +0,7 @@
 
 	// check for bit colourdepth limit
 	// force bit colourdepth when DV mode
-	if (is_amdv_output_dv()) {
+	if (dv_output) {
 		int cd = bitdepth_to_colordepth(attr->bitdepth);
 		if (get_amdv_ll_policy() == 0 /* DOLBY_VISION_LL_DISABLE */) {
 			attr->bitdepth = colordepth_to_bitdepth(COLORDEPTH_24B);
diff --git a/drivers/media/enhancement/amdolby_vision/amdv.c b/drivers/media/enhancement/amdolby_vision/amdv.c
--- a/drivers/media/enhancement/amdolby_vision/amdv.c
+++ b/drivers/media/enhancement/amdolby_vision/amdv.c
@@ -0,8 +0,10 @@
 
 void dv_inst_unmap(int inst)
 {
-	if (!multi_dv_mode)
+	if (!multi_dv_mode) {
+		amdv_src_format = 0;
 		return;
+	}
 
 	pr_info("%s %d\n", __func__, inst);
 
@@ -0,6 +0,7 @@
 	if (dv_inst_valid(inst) && dv_inst[inst].mapped) {
 		dv_inst[inst].mapped = false;
 		last_unmap_id = inst;
+		dv_inst[inst].amdv_src_format = 0;
 		{
 			void *parser = rcu_dereference_protected
 				(dv_inst[inst].metadata_parser,
@@ -0,7 +0,8 @@
 
 	check_format = src_format;
 	if (vf) {
-		update_src_format(check_format, vf);
+		if (toggle_mode != 2)
+			update_src_format(check_format, vf);
 		last_current_format = check_format;
 	}
 
@@ -0,7 +0,8 @@
 
 	check_format = src_format;
 	if (vf) {
-		update_src_format(check_format, vf);
+		if (toggle_mode != 2)
+			update_src_format(check_format, vf);
 		last_current_format = check_format;
 	}
 
@@ -0,6 +0,17 @@
 }
 EXPORT_SYMBOL(get_amdv_target_mode);
 
+/* the output the policy would pick for the mode in @vinfo, for the current source */
+int get_amdv_mode_for(const struct vinfo_s *vinfo)
+{
+	int mode = READ_ONCE(dolby_vision_mode);
+
+	/* userspace enables the engine only for a DV source or a forced output */
+	amdv_policy_process_for(NULL, &mode, cur_src_format_or(FORMAT_DOVI), vinfo);
+	return mode;
+}
+EXPORT_SYMBOL(get_amdv_mode_for);
+
 bool is_amdv_enable(void)
 {
 	return dolby_vision_enable;
diff --git a/include/linux/amlogic/media/amdolbyvision/dolby_vision.h b/include/linux/amlogic/media/amdolbyvision/dolby_vision.h
--- a/include/linux/amlogic/media/amdolbyvision/dolby_vision.h
+++ b/include/linux/amlogic/media/amdolbyvision/dolby_vision.h
@@ -0,6 +0,7 @@
 void set_amdv_mode(int mode);
 int get_amdv_mode(void);
 int get_amdv_target_mode(void);
+int get_amdv_mode_for(const struct vinfo_s *vinfo);
 void amdv_set_toggle_flag(int flag);
 int amdv_wait_metadata(struct vframe_s *vf, enum vd_path_e vd_path);
 int amdv_pop_metadata(void);
