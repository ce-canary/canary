From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 7 Nov 2026 00:23:32 -0600
Subject: [PATCH] amdv: answer the output policy for a mode not yet set

The policy reads the current vinfo and the last source format, so it
can only answer for the mode already set. A switch into DV then decides
the colour attrs against the old mode, picks non-DV attrs and shows a
purple picture. The policy also writes force_mode, which a query must
not change.
---
 .../media/enhancement/amdolby_vision/amdv.c   | 68 ++++++++++++++-----
 .../media/amdolbyvision/dolby_vision.h        |  1 +
 2 files changed, 51 insertions(+), 18 deletions(-)

diff --git a/drivers/media/enhancement/amdolby_vision/amdv.c b/drivers/media/enhancement/amdolby_vision/amdv.c
--- a/drivers/media/enhancement/amdolby_vision/amdv.c
+++ b/drivers/media/enhancement/amdolby_vision/amdv.c
@@ -0,8 +0,10 @@
 
 void dv_inst_unmap(int inst)
 {
-	if (!multi_dv_mode)
+	if (!multi_dv_mode) {
+		amdv_src_format = 0;
 		return;
+	}
 
 	pr_info("%s %d\n", __func__, inst);
 
@@ -0,6 +0,7 @@
 	if (dv_inst_valid(inst) && dv_inst[inst].mapped) {
 		dv_inst[inst].mapped = false;
 		last_unmap_id = inst;
+		dv_inst[inst].amdv_src_format = 0;
 		{
 			void *parser = rcu_dereference_protected
 				(dv_inst[inst].metadata_parser,
@@ -0,17 +0,20 @@
 }
 EXPORT_SYMBOL(get_amdv_src_format);
 
-static enum signal_format_enum get_cur_src_format(void)
+static enum signal_format_enum cur_src_format_or(enum signal_format_enum unknown)
 {
-	int cur_format = amdv_src_format;
+	int cur_format = READ_ONCE(amdv_src_format);
 	enum signal_format_enum ret = FORMAT_SDR;
 	int dv_id = pri_input; /*pri input as default*/
 
 	if (multi_dv_mode)
-		cur_format = dv_inst[dv_id].amdv_src_format;
+		cur_format = READ_ONCE(dv_inst[dv_id].amdv_src_format);
 	else if (is_aml_hw5())
 		return top2_v_info.amdv_src_format;
 
+	if (!cur_format)
+		return unknown;
+
 	switch (cur_format) {
 	case 1: /* HDR10 */
 		ret = FORMAT_HDR10;
@@ -0,10 +0,15 @@
 	return ret;
 }
 
+static enum signal_format_enum get_cur_src_format(void)
+{
+	return cur_src_format_or(FORMAT_SDR);
+}
+
 static int amdv_policy_process_v1(struct vframe_s *vf,
-				int *mode, enum signal_format_enum src_format)
+				int *mode, enum signal_format_enum src_format,
+				const struct vinfo_s *vinfo)
 {
-	const struct vinfo_s *vinfo;
 	int mode_change = 0;
 	int h = 0;
 	int w = 0;
@@ -0,7 +0,6 @@
 		}
 	}
 
-	vinfo = get_current_vinfo();
 	if (src_format == FORMAT_MVC) {
 		if (dolby_vision_mode !=
 			AMDV_OUTPUT_MODE_BYPASS) {
@@ -0,9 +0,9 @@
 }
 
 static int amdv_policy_process_v2_stb(struct vframe_s *vf,
-				int *mode, enum signal_format_enum src_format)
+				int *mode, enum signal_format_enum src_format,
+				const struct vinfo_s *vinfo, int *force)
 {
-	const struct vinfo_s *vinfo;
 	int mode_change = 0;
 	int h = 0;
 	int w = 0;
@@ -0,7 +0,6 @@
 		}
 	}
 
-	vinfo = get_current_vinfo();
 	if (src_format == FORMAT_MVC) {
 		if (dolby_vision_mode !=
 			AMDV_OUTPUT_MODE_BYPASS) {
@@ -0,8 +0,8 @@
 		if (force_mode == AMDV_OUTPUT_MODE_IPT || force_mode == AMDV_OUTPUT_MODE_IPT_TUNNEL) {
 			if (src_format == FORMAT_HDR10PLUS && vinfo && sink_support_hdr10_plus(vinfo))
 			{
-				force_mode = AMDV_OUTPUT_MODE_BYPASS;
-				*mode = force_mode;
+				*force = AMDV_OUTPUT_MODE_BYPASS;
+				*mode = *force;
 				if (dolby_vision_mode != *mode)
 					mode_change = 1;
 				else
@@ -0,8 +0,9 @@
 	return mode_change;
 }
 
-int amdv_policy_process(struct vframe_s *vf, int *mode,
-			enum signal_format_enum src_format)
+static int amdv_policy_process_for(struct vframe_s *vf, int *mode,
+				   enum signal_format_enum src_format,
+				   const struct vinfo_s *vinfo, int *force)
 {
 	int mode_change = 0;
 
@@ -0,13 +0,21 @@
 		if (is_aml_tvmode())
 			mode_change = amdv_policy_process_v2_tv(mode, src_format);
 		else
-			mode_change = amdv_policy_process_v2_stb(vf, mode, src_format);
+			mode_change = amdv_policy_process_v2_stb(vf, mode, src_format, vinfo,
+								 force);
 	} else {
-		mode_change = amdv_policy_process_v1(vf, mode, src_format);
+		mode_change = amdv_policy_process_v1(vf, mode, src_format, vinfo);
 	}
 	return mode_change;
 }
 
+int amdv_policy_process(struct vframe_s *vf, int *mode,
+			enum signal_format_enum src_format)
+{
+	return amdv_policy_process_for(vf, mode, src_format, get_current_vinfo(),
+				       &force_mode);
+}
+
 /* dv provider of each video layer*/
 char dv_provider[2][32] = {"dvbldec", "dvbldec2"};
 
@@ -0,7 +0,8 @@
 
 	check_format = src_format;
 	if (vf) {
-		update_src_format(check_format, vf);
+		if (toggle_mode != 2)
+			update_src_format(check_format, vf);
 		last_current_format = check_format;
 	}
 
@@ -0,7 +0,8 @@
 
 	check_format = src_format;
 	if (vf) {
-		update_src_format(check_format, vf);
+		if (toggle_mode != 2)
+			update_src_format(check_format, vf);
 		last_current_format = check_format;
 	}
 
@@ -0,6 +0,18 @@
 }
 EXPORT_SYMBOL(get_amdv_target_mode);
 
+/* the output the policy would pick for the mode in @vinfo, for the current source */
+int get_amdv_mode_for(const struct vinfo_s *vinfo)
+{
+	int mode = READ_ONCE(dolby_vision_mode);
+	int force;
+
+	/* userspace enables the engine only for a DV source or a forced output */
+	amdv_policy_process_for(NULL, &mode, cur_src_format_or(FORMAT_DOVI), vinfo, &force);
+	return mode;
+}
+EXPORT_SYMBOL(get_amdv_mode_for);
+
 bool is_amdv_enable(void)
 {
 	return dolby_vision_enable;
diff --git a/include/linux/amlogic/media/amdolbyvision/dolby_vision.h b/include/linux/amlogic/media/amdolbyvision/dolby_vision.h
--- a/include/linux/amlogic/media/amdolbyvision/dolby_vision.h
+++ b/include/linux/amlogic/media/amdolbyvision/dolby_vision.h
@@ -0,6 +0,7 @@
 void set_amdv_mode(int mode);
 int get_amdv_mode(void);
 int get_amdv_target_mode(void);
+int get_amdv_mode_for(const struct vinfo_s *vinfo);
 void amdv_set_toggle_flag(int flag);
 int amdv_wait_metadata(struct vframe_s *vf, enum vd_path_e vd_path);
 int amdv_pop_metadata(void);
